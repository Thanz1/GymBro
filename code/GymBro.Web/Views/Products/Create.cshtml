@model GymBro.Core.Product

@{
    ViewBag.Title = "Thêm sản phẩm mới";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-10">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h3 class="mb-0 text-success"><i class="bi bi-plus-circle"></i> Thêm sản phẩm mới</h3>
            </div>
            <div class="card-body">
                @* Lưu ý: enctype="multipart/form-data" để upload ảnh *@
                @using (Html.BeginForm("Create", "Products", FormMethod.Post, new { enctype = "multipart/form-data" }))
                {
                    @Html.AntiForgeryToken()

                    <div class="form-horizontal">
                        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                        <div class="row">
                            <div class="col-md-8">
                                @* Tên sản phẩm *@
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Tên sản phẩm <span class="text-danger">*</span></label>
                                    @Html.EditorFor(model => model.ProductName, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.ProductName, "", new { @class = "text-danger" })
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold">Giá bán (VNĐ) <span class="text-danger">*</span></label>
                                        @Html.EditorFor(model => model.Price, new { htmlAttributes = new { @class = "form-control", type = "number", min = "0", step = "1000" } })
                                        @Html.ValidationMessageFor(model => model.Price, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold">Số lượng tồn <span class="text-danger">*</span></label>
                                        @Html.EditorFor(model => model.StockQuantity, new { htmlAttributes = new { @class = "form-control", type = "number", min = "0" } })
                                        @Html.ValidationMessageFor(model => model.StockQuantity, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-bold">Danh mục <span class="text-danger">*</span></label>
                                    @* SỬA: CategoryID -> CategoryId *@
                                    @Html.DropDownList("CategoryId", null, "--- Chọn danh mục ---", htmlAttributes: new { @class = "form-control form-select" })
                                    @Html.ValidationMessageFor(model => model.CategoryId, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="col-md-4">
                                @* Upload Ảnh *@
                                <div class="card">
                                    <div class="card-header bg-light">Hình ảnh sản phẩm</div>
                                    <div class="card-body text-center">
                                        <img id="preview" src="~/Content/Images/shopping.webp" class="img-fluid mb-3" style="max-height: 200px; object-fit: contain;" />

                                        @* QUAN TRỌNG: name="imageFile" phải khớp với Controller *@
                                        <input type="file" name="imageFile" class="form-control" onchange="previewImage(this)" accept="image/*" />
                                        @Html.ValidationMessage("ImageURL", "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>
                        </div>

                        @* Mô tả (CKEditor) *@
                        <div class="mb-3 mt-3">
                            <label class="form-label fw-bold">Mô tả chi tiết</label>
                            @Html.TextAreaFor(model => model.Description, new { @class = "form-control", id = "Description" })
                            @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <a href="@Url.Action("Index")" class="btn btn-secondary">Quay lại</a>
                            <button type="submit" class="btn btn-success"><i class="bi bi-save"></i> Lưu sản phẩm</button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    @* Script CKEditor (Giữ nguyên hoặc thay bằng link CDN nếu cần) *@
    <script src="https://cdn.ckeditor.com/4.16.2/standard/ckeditor.js"></script>
    <script>
        CKEDITOR.replace('Description');

        function previewImage(input) {
            var preview = document.getElementById('preview');
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    preview.src = e.target.result;
                }
                reader.readAsDataURL(input.files[0]);
            } else {
                preview.src = "/Content/Images/shopping.webp";
            }
        }
    </script>
}
