@model GymBro.Core.Category

@{
    ViewBag.Title = "Chi tiết Danh mục";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h4 class="mb-0 text-info">Chi tiết Danh mục</h4>
            </div>
            <div class="card-body">
                <table class="table table-bordered">
                    <tr>
                        <th class="bg-light" style="width: 30%;">ID</th>
                        @* SỬA: CategoryID -> Id *@
                        <td>#@Model.Id</td>
                    </tr>
                    <tr>
                        <th class="bg-light">Tên danh mục</th>
                        <td>@Model.CategoryName</td>
                    </tr>
                </table>

                <div class="mt-3 d-flex gap-2">
                    @* SỬA: CategoryID -> Id *@
                    <a href="@Url.Action("Edit", new { id = Model.Id })" class="btn btn-primary"><i class="bi bi-pencil"></i> Chỉnh sửa</a>
                    <a href="@Url.Action("Index")" class="btn btn-secondary">Quay lại</a>
                </div>
            </div>
        </div>
    </div>
</div>