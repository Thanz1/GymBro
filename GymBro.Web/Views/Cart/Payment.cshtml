@model GymBro.Core.Order
@{
    ViewBag.Title = "Thanh toán đơn hàng #" + Model.Id;

    // Tính toán thời gian
    var timeRemaining = TimeSpan.FromHours(24) - (DateTime.Now - Model.OrderDate);
    var hoursLeft = (int)timeRemaining.TotalHours;
    var minutesLeft = timeRemaining.Minutes;
    var isExpiringSoon = timeRemaining.TotalHours < 2;
    var isExpired = timeRemaining.TotalMinutes <= 0;
    var paymentStatus = ViewBag.PaymentStatus as string ?? "Chờ thanh toán";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            @* Cảnh báo thời gian *@
            @if (isExpired)
            {
                <div class="alert alert-danger text-center mb-4">
                    <h5><i class="bi bi-exclamation-triangle-fill"></i> Đơn hàng đã hết hạn thanh toán</h5>
                    <p class="mb-0">Đơn hàng này đã quá thời gian thanh toán (24 giờ). Vui lòng liên hệ hỗ trợ hoặc đặt hàng mới.</p>
                </div>
            }
            else if (isExpiringSoon)
            {
                <div class="alert alert-warning text-center mb-4">
                    <h5><i class="bi bi-clock-fill"></i> Sắp hết hạn thanh toán!</h5>
                    <p class="mb-0">Còn <strong>@hoursLeft giờ @minutesLeft phút</strong> để hoàn tất thanh toán.</p>
                </div>
            }

            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-header @(paymentStatus == "Chờ thanh toán" ? "bg-primary" : "bg-warning") text-white text-center py-3">
                    <h3 class="mb-0 fw-bold"><i class="bi bi-qr-code-scan"></i> Thanh toán qua mã QR</h3>
                    <p class="mb-0 opacity-75">Đơn hàng #@Model.Id | Ngày đặt: @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
                    <span class="badge @(paymentStatus == "Chờ thanh toán" ? "bg-light text-dark" : "bg-danger") mt-2">
                        @paymentStatus
                    </span>
                </div>
                <div class="card-body p-4">
                    <div class="row align-items-center">
                        <div class="col-md-6 text-center mb-4 mb-md-0 border-end">
                            <div class="bg-light p-3 rounded d-inline-block shadow-sm">
                                <img src="@ViewBag.QRImage" alt="Mã QR Thanh Toán" class="img-fluid" style="max-width: 100%; height: auto; min-width: 250px;" />
                            </div>
                            <p class="mt-3 text-muted small"><i class="bi bi-info-circle"></i> Sử dụng App Ngân hàng hoặc Ví điện tử để quét mã</p>
                        </div>

                        <div class="col-md-6 ps-md-4">
                            <h5 class="text-primary mb-3 fw-bold">Thông tin chuyển khoản</h5>

                            <div class="mb-3">
                                <label class="text-muted small">Ngân hàng</label>
                                <div class="d-flex justify-content-between align-items-center p-2 bg-light rounded border">
                                    <span class="fw-bold">@ViewBag.BankId</span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="text-muted small">Số tài khoản</label>
                                <div class="d-flex justify-content-between align-items-center p-2 bg-light rounded border">
                                    <span class="fw-bold text-danger fs-5" id="accountNo">@ViewBag.AccountNo</span>
                                    <button class="btn btn-sm btn-outline-secondary" onclick="copyToClipboard('accountNo')"><i class="bi bi-clipboard"></i> Sao chép</button>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="text-muted small">Chủ tài khoản</label>
                                <div class="d-flex justify-content-between align-items-center p-2 bg-light rounded border">
                                    <span class="fw-bold">@ViewBag.AccountName</span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="text-muted small">Số tiền</label>
                                <div class="d-flex justify-content-between align-items-center p-2 bg-light rounded border">
                                    <span class="fw-bold text-primary fs-5" id="amount">@Model.TotalAmount.ToString("N0") đ</span>
                                    <button class="btn btn-sm btn-outline-secondary" onclick="copyToClipboard('amountValue')"><i class="bi bi-clipboard"></i> Sao chép</button>
                                    <span id="amountValue" class="d-none">@(((int)Model.TotalAmount).ToString())</span>
                                </div>
                            </div>

                            <div class="mb-4">
                                <label class="text-muted small">Nội dung chuyển khoản <span class="text-danger">*Bắt buộc</span></label>
                                <div class="d-flex justify-content-between align-items-center p-2 bg-warning bg-opacity-10 rounded border border-warning">
                                    <span class="fw-bold text-dark" id="content">@ViewBag.Description</span>
                                    <button class="btn btn-sm btn-outline-warning text-dark" onclick="copyToClipboard('content')"><i class="bi bi-clipboard"></i> Sao chép</button>
                                </div>
                            </div>

                            <hr />

                            @if (paymentStatus == "Chờ thanh toán" || paymentStatus == null)
                            {
                                if (!isExpired)
                                {
                                    <div class="alert alert-warning mb-3">
                                        <small><i class="bi bi-exclamation-circle"></i> <strong>Lưu ý:</strong> Chỉ bấm "Tôi đã chuyển khoản xong" sau khi bạn thực sự đã chuyển tiền.</small>
                                    </div>
                                    <div class="d-grid gap-2">
                                        @using (Html.BeginForm("ConfirmPayment", "Cart", FormMethod.Post, new { id = "confirmPaymentForm" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@Model.Id" />
                                            <button type="submit" class="btn btn-success btn-lg w-100 shadow-sm hover-lift"
                                                    onclick="return confirm('⚠️ Bạn xác nhận đã chuyển khoản đúng số tiền và nội dung?');">
                                                <i class="bi bi-check-circle-fill"></i> Tôi đã chuyển khoản xong
                                            </button>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-danger">Đơn hàng đã hết hạn. Vui lòng liên hệ hỗ trợ.</div>
                                }
                            }
                            else if (paymentStatus == "Chờ xác minh")
                            {
                                <div class="alert alert-info">
                                    <h5><i class="bi bi-clock-history"></i> Đang chờ xác minh</h5>
                                    <p class="mb-0">Bạn đã xác nhận thanh toán. Admin đang kiểm tra giao dịch của bạn.</p>
                                </div>
                                <div class="d-grid">
                                    <a href="@Url.Action("Index", "Home")" class="btn btn-primary">Quay về trang chủ</a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function copyToClipboard(elementId) {
        var copyText = document.getElementById(elementId).innerText;
        navigator.clipboard.writeText(copyText).then(function() {
            alert("Đã sao chép: " + copyText);
        }, function(err) {
            console.error('Async: Could not copy text: ', err);
        });
    }
</script>