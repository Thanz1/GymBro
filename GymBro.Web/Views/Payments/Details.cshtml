@model GymBro.Core.Payment

@{
    ViewBag.Title = "Chi tiết Thanh toán #" + Model.Id;
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var order = Model.Order;
    var user = order?.User;
}

<div class="container pb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary rounded-pill px-3">
                <i class="bi bi-arrow-left"></i> Quay lại
            </a>
        </div>
    </div>

    <div class="row">
        @* Payment Info *@
        <div class="col-md-6 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-credit-card"></i> Thông tin Thanh toán</h5>
                </div>
                <div class="card-body">
                    <table class="table table-borderless mb-0">
                        <tbody>
                            <tr>
                                <td class="text-muted">Mã thanh toán:</td>
                                <td class="fw-bold">#@Model.Id</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Mã đơn hàng:</td>
                                <td>
                                    <a href="@Url.Action("Details", "Orders", new { id = Model.OrderId })" class="fw-bold text-primary text-decoration-none">
                                        #@Model.OrderId
                                    </a>
                                </td>
                            </tr>
                            <tr>
                                <td class="text-muted">Số tiền:</td>
                                <td class="fw-bold text-primary fs-5">@string.Format("{0:N0}", Model.Amount) ₫</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Ngày thanh toán:</td>
                                <td>@Model.PaymentDate.ToString("dd/MM/yyyy HH:mm:ss")</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Trạng thái:</td>
                                <td>
                                    <span class="badge bg-info text-dark">@Model.Status</span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        @* Customer Info *@
        <div class="col-md-6 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0"><i class="bi bi-person-circle"></i> Thông tin Khách hàng</h5>
                </div>
                <div class="card-body">
                    <table class="table table-borderless mb-0">
                        <tbody>
                            <tr>
                                <td class="text-muted">Họ tên:</td>
                                <td class="fw-bold">@(user?.FullName ?? "N/A")</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Email:</td>
                                <td>@(user?.Email ?? "N/A")</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Địa chỉ:</td>
                                <td>@(user?.Address ?? "N/A")</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>