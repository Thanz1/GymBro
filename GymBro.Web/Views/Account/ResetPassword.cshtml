@model GymBro.Contracts.ResetPasswordDto
@{
    ViewBag.Title = "Đặt lại mật khẩu";
}

<div class="auth-page">
    <div class="row justify-content-center">
        <div class="col-lg-5">
            <div style="background: white; border-radius: 15px; padding: 40px; box-shadow: 0 10px 25px rgba(0,0,0,0.15);">
                <h2 class="text-center" style="font-weight: 700;">Mật khẩu mới</h2>
                <p class="text-muted text-center">Thiết lập mật khẩu mới cho tài khoản @Model.Identifier</p>

                @using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post))
                {
                    @Html.HiddenFor(m => m.Identifier)
                    <div class="form-group mb-4">
                        <label class="form-label">Mật khẩu mới</label>
                        <input type="password" name="NewPassword" class="form-control" required minlength="6" />
                    </div>
                    <div class="d-grid">
                        <button type="submit" class="btn btn-danger">Xác nhận thay đổi</button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>