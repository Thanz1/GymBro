@model GymBro.Core.Order

@{
    ViewBag.Title = "Chỉnh sửa Đơn hàng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h4 class="mb-0 text-primary">Chỉnh sửa Đơn hàng</h4>
            </div>
            <div class="card-body">
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()

                    <div class="form-horizontal">
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        @* SỬA: OrderID -> Id *@
                        @Html.HiddenFor(model => model.Id)

                        <div class="mb-3">
                            <label class="form-label fw-bold">Ngày đặt hàng</label>
                            @Html.EditorFor(model => model.OrderDate, new { htmlAttributes = new { @class = "form-control", type = "datetime-local", @Value = Model.OrderDate.ToString("yyyy-MM-ddTHH:mm") } })
                            @Html.ValidationMessageFor(model => model.OrderDate, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Trạng thái <span class="text-danger">*</span></label>
                            @if (ViewBag.StatusList != null)
                            {
                                @Html.DropDownListFor(model => model.Status, (SelectList)ViewBag.StatusList, new { @class = "form-control form-select" })
                            }
                            else
                            {
                                @Html.EditorFor(model => model.Status, new { htmlAttributes = new { @class = "form-control" } })
                            }
                            @Html.ValidationMessageFor(model => model.Status, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Tổng tiền</label>
                            <p class="form-control-plaintext text-danger fw-bold fs-5">
                                @string.Format("{0:N0}", Model.TotalAmount) VNĐ
                            </p>
                            <div class="alert alert-info">
                                <i class="bi bi-info-circle"></i>
                                <strong>Lưu ý:</strong> Tổng tiền được tự động tính từ chi tiết đơn hàng.
                                Để thay đổi tổng tiền, vui lòng chỉnh sửa chi tiết đơn hàng.
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Người dùng</label>
                            @* SỬA: UserID -> UserId *@
                            @Html.DropDownList("UserId", null, htmlAttributes: new { @class = "form-control form-select" })
                            @Html.ValidationMessageFor(model => model.UserId, "", new { @class = "text-danger" })
                        </div>

                        <div class="d-flex gap-2 justify-content-end">
                            <a href="@Url.Action("Index")" class="btn btn-secondary">Hủy</a>
                            <input type="submit" value="Lưu thay đổi" class="btn btn-primary" />
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}