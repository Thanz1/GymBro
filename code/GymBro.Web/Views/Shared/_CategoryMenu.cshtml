@model IEnumerable<GymBro.Application.Catalog.CategoryOptionDto>

@if (Model != null)
{
    foreach (var item in Model)
    {
        <li>
            <a href="@Url.Action("Shop", "Home", new { categoryId = item.Id })" class="dropdown-item">
                @item.Name
            </a>
        </li>
    }
}
