@{
    ViewBag.Title = "Đổi mật khẩu";
}

<div class="container mt-4">
    <h2>Thiết lập mật khẩu mới</h2>
    <hr />

    @using (Html.BeginForm("ChangePassword", "Account", FormMethod.Post)) 
    {
    @Html.AntiForgeryToken()

    <div class="col-md-6">
        <div class="mb-3">
            <label class="form-label">Mật khẩu cũ</label>
            <input type="password" name="oldPassword" class="form-control" required />[cite: 3]
        </div>

        <div class="mb-3">
            <label class="form-label">Mật khẩu mới (ít nhất 6 ký tự)</label>
            <input type="password" name="newPassword" class="form-control" id="newPwd" required minlength="6" />[cite: 3]
        </div>

        <div class="mb-3">
            <label class="form-label">Xác nhận mật khẩu mới</label>
            <input type="password" name="confirmPassword" class="form-control" id="confirmPwd" required />[cite: 3]
        </div>

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
            
                }

        <button type="submit" class="btn btn-primary">Xác nhận đổi mật khẩu</button>
        @Html.ActionLink("Hủy bỏ", "MyAccount", "Account", null, new { @class = "btn btn-secondary" })
    </div>
    }
</div>

@section Scripts {
    <script>
        var newPwd = document.getElementById('newPwd');
        var confirmPwd = document.getElementById('confirmPwd');

        function validate() {
            if (newPwd.value !== confirmPwd.value) {
                confirmPwd.setCustomValidity('Mật khẩu xác nhận không khớp');[cite: 3]
            } else {
                confirmPwd.setCustomValidity('');[cite: 3]
            }
        }
        newPwd.onchange = validate;
        confirmPwd.onkeyup = validate;
    </script>
}