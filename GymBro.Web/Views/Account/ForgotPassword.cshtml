@{
    ViewBag.Title = "Quên mật khẩu";
}

<div class="auth-page">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-7">
            <div style="background: white; border-radius: 15px; box-shadow: 0 10px 25px rgba(0,0,0,0.15); padding: 40px; margin-top: 30px;">
                <div class="text-center mb-4">
                    <i class="bi bi-shield-lock" style="font-size: 4rem; color: #dc3545; margin-bottom: 15px;"></i>
                    <h2 style="font-weight: 700; color: #2c3e50; margin-bottom: 10px;">Quên mật khẩu?</h2>
                    <p class="text-muted">Nhập email của bạn để lấy lại mật khẩu.</p>
                </div>
                @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post))
                {
                    <div class="form-group mb-4">
                        <label class="form-label" style="font-weight: 600;">Tên đăng nhập hoặc Email</label>
                        <input type="text" name="Identifier" class="form-control" required placeholder="Nhập username hoặc email đã đăng ký" />
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-danger btn-lg">Gửi yêu cầu</button>
                    </div>
                }

                <div class="text-center mt-3">
                    @Html.ActionLink("Quay lại Đăng nhập", "Login", "Account", null, new { @class = "text-decoration-none" })
                </div>
            </div>
        </div>
    </div>
</div>