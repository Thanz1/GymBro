@model GymBro.Core.Supplier

@{
    ViewBag.Title = "Xóa Nhà cung cấp";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm mt-4">
            <div class="card-header bg-danger text-white py-3">
                <h4 class="mb-0"><i class="bi bi-exclamation-triangle"></i> Xác nhận xóa</h4>
            </div>
            <div class="card-body text-center">
                <h5 class="card-title mb-4">Bạn có chắc muốn xóa nhà cung cấp này?</h5>

                <div class="alert alert-light border text-start d-inline-block p-4 mb-4" style="min-width: 300px;">
                    <p class="mb-1"><strong>Tên:</strong> @Model.SupplierName</p>
                    <p class="mb-1"><strong>Email:</strong> @(string.IsNullOrEmpty(Model.Email) ? "Không có" : Model.Email)</p>
                    <p class="mb-0"><strong>SĐT:</strong> @(string.IsNullOrEmpty(Model.Phone) ? "Không có" : Model.Phone)</p>
                </div>

                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    <div class="d-flex justify-content-center gap-3">
                        <a href="@Url.Action("Index")" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Hủy
                        </a>
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash"></i> Xác nhận Xóa
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>