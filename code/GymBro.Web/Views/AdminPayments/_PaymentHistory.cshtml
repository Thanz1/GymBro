@model IEnumerable<GymBro.Application.Payments.PaymentAuditLogEntry>
@using GymBro.Web.Features.AdminPayments

@{
    var entries = (Model ?? Enumerable.Empty<PaymentAuditLogEntry>()).ToList();
}

@if (entries.Any())
{
    <div class="timeline">
        @foreach (var entry in entries)
        {
            var isApproved = entry.ActionType == PaymentAuditAction.AdminApproved;
            var isRejected = entry.ActionType == PaymentAuditAction.AdminRejected;
            var isCustomer = entry.ActionType == PaymentAuditAction.CustomerConfirmed;
            var isSynthetic = entry.ActionType == PaymentAuditAction.StatusSnapshot || entry.IsSynthetic;

            var borderClass = isApproved
                ? "border-success border-3"
                : isRejected
                    ? "border-danger border-3"
                    : isCustomer
                        ? "border-info border-3"
                        : isSynthetic
                            ? "border-secondary border-3"
                            : "border-primary border-3";

            var iconClass = isApproved
                ? "bi bi-check-circle"
                : isRejected
                    ? "bi bi-x-circle"
                    : isCustomer
                        ? "bi bi-person-check"
                        : isSynthetic
                            ? "bi bi-clock-history"
                            : "bi bi-shield-check";

            var iconWrapperClass = isApproved
                ? "bg-success"
                : isRejected
                    ? "bg-danger"
                    : isCustomer
                        ? "bg-info"
                        : isSynthetic
                            ? "bg-secondary"
                            : "bg-primary";

            <div class="timeline-item mb-3">
                <div class="d-flex">
                    <div class="me-3">
                        <div class="rounded-circle @iconWrapperClass text-white d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                            <i class="@iconClass"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1">
                        <div class="card border-start @borderClass">
                            <div class="card-body py-2 px-3">
                                <div class="d-flex flex-wrap gap-2 small text-muted mb-2">
                                    <span>@entry.CreatedDate.ToString("dd/MM/yyyy HH:mm:ss")</span>
                                    @if (!string.IsNullOrWhiteSpace(entry.ActorName))
                                    {
                                        <span>@entry.ActorName</span>
                                    }
                                </div>
                                <p class="mb-0 small">@entry.Message</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <style>
        .timeline-item:not(:last-child)::before {
            content: '';
            position: absolute;
            left: 19px;
            top: 45px;
            height: calc(100% - 5px);
            width: 2px;
            background: #e0e0e0;
        }

        .timeline-item {
            position: relative;
        }
    </style>
}
else
{
    <p class="text-muted mb-0">Chưa có lịch sử giao dịch.</p>
}
