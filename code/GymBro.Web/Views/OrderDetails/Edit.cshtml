@{
    ViewBag.Title = "Sua chi tiet don hang";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h4 class="mb-0 text-primary"><i class="bi bi-lock"></i> Sua chi tiet don hang da bi khoa</h4>
            </div>
            <div class="card-body">
                <p class="mb-3">
                    Chinh sua truc tiep chi tiet don hang da bi tat de bao toan tong tien, ton kho va thanh toan.
                </p>
                <a href="@Url.Action("Index")" class="btn btn-primary">Ve danh sach chi tiet</a>
            </div>
        </div>
    </div>
</div>
