@model GymBro.Core.Product

@{
    ViewBag.Title = "Xóa Sản phẩm";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm mt-4">
            <div class="card-header bg-danger text-white py-3">
                <h4 class="mb-0"><i class="bi bi-trash"></i> Xác nhận xóa Sản phẩm</h4>
            </div>
            <div class="card-body">
                <div class="alert alert-warning border-warning" role="alert">
                    <h5 class="alert-heading"><i class="bi bi-exclamation-triangle-fill"></i> Cảnh báo!</h5>
                    <p class="mb-0">
                        <strong>Bạn có chắc chắn muốn xóa sản phẩm này?</strong><br />
                        Hành động này không thể hoàn tác. Tất cả dữ liệu liên quan (Chi tiết đơn hàng cũ, Lịch sử kho) có thể bị ảnh hưởng.
                    </p>
                </div>

                <div class="row mb-4">
                    <div class="col-md-4 text-center">
                        @if (!string.IsNullOrEmpty(Model.ImageURL))
                        {
                            <img src="~/Content/Images/@Model.ImageURL" class="img-fluid rounded border" style="max-height: 200px;" onerror="this.src='/Content/Images/no-image.png'" />
                        }
                        else
                        {
                            <div class="bg-light d-flex align-items-center justify-content-center rounded border" style="height: 150px;">
                                <i class="bi bi-image" style="font-size: 3rem; color: #ccc;"></i>
                            </div>
                        }
                    </div>
                    <div class="col-md-8">
                        <dl class="row">
                            <dt class="col-sm-4">Tên sản phẩm:</dt>
                            <dd class="col-sm-8 fw-bold">@Model.ProductName</dd>

                            <dt class="col-sm-4">Danh mục:</dt>
                            <dd class="col-sm-8">@(Model.Category != null ? Model.Category.CategoryName : "N/A")</dd>

                            <dt class="col-sm-4">Giá bán:</dt>
                            <dd class="col-sm-8 text-danger fw-bold">@string.Format("{0:N0}", Model.Price) VNĐ</dd>

                            <dt class="col-sm-4">Tồn kho:</dt>
                            <dd class="col-sm-8">@Model.StockQuantity</dd>
                        </dl>
                    </div>
                </div>

                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    <div class="d-flex justify-content-end gap-2">
                        <a href="@Url.Action("Index")" class="btn btn-secondary">Hủy bỏ</a>
                        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Xác nhận xóa</button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>