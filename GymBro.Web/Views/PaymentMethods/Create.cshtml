@model GymBro.Core.PaymentMethod

@{
    ViewBag.Title = "Thêm Phương thức thanh toán";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h3 class="mb-0 text-primary">Thêm mới Phương thức thanh toán</h3>
            </div>
            <div class="card-body">
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()

                    <div class="form-horizontal">
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                        <div class="mb-3 row">
                            <label class="col-md-3 col-form-label fw-bold">Tên phương thức <span class="text-danger">*</span></label>
                            <div class="col-md-9">
                                @Html.EditorFor(model => model.MethodName, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.MethodName, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="mb-3 row">
                            <label class="col-md-3 col-form-label fw-bold">Mô tả</label>
                            <div class="col-md-9">
                                @Html.TextAreaFor(model => model.Description, new { @class = "form-control", rows = "3" })
                                @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="mb-3 row">
                            <label class="col-md-3 col-form-label fw-bold">Trạng thái</label>
                            <div class="col-md-9">
                                <div class="form-check">
                                    @* Checkbox cho IsActive *@
                                    @Html.CheckBoxFor(model => model.IsActive, new { @class = "form-check-input" })
                                    <label class="form-check-label" for="IsActive">Kích hoạt ngay</label>
                                </div>
                                @Html.ValidationMessageFor(model => model.IsActive, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="row mt-4">
                            <div class="col-md-9 offset-md-3">
                                <button type="submit" class="btn btn-primary me-2">Thêm mới</button>
                                <a href="@Url.Action("Index")" class="btn btn-secondary">Quay lại</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>