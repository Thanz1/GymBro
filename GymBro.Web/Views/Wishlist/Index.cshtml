@model IEnumerable<GymBro.Core.Wishlist>

@{
    ViewBag.Title = "Danh sách yêu thích";
}

<div class="container py-4">
    <h2 class="mb-4"><i class="bi bi-heart-fill text-danger"></i> Danh sách yêu thích</h2>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            Bạn chưa lưu sản phẩm nào vào danh sách yêu thích.
            <a href="@Url.Action("Index", "Home")" class="alert-link">Tiếp tục mua sắm</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                if (item.Product != null)
                {
                    <div class="col-md-3 col-sm-6">
                        <div class="card h-100 shadow-sm border-0">
                            <div class="position-relative">
                                @* Link chi tiết sản phẩm *@
                                @* SỬA: ProductID -> Id *@
                                <a href="@Url.Action("Details", "Home", new { id = item.Product.Id })">
                                    @if (!string.IsNullOrEmpty(item.Product.ImageURL))
                                    {
                                        <img src="~/Content/Images/@item.Product.ImageURL"
                                             class="card-img-top"
                                             alt="@item.Product.ProductName"
                                             style="height: 200px; object-fit: cover;"
                                             onerror="this.src='/Content/Images/no-image.png'" />
                                    }
                                    else
                                    {
                                        <div class="card-img-top d-flex align-items-center justify-content-center bg-light" style="height: 200px;">
                                            <i class="bi bi-image fs-1 text-muted"></i>
                                        </div>
                                    }
                                </a>

                                @* Nút Xóa khỏi Wishlist (Góc trên phải) *@
                                <form action="@Url.Action("Remove", "Wishlist")" method="post" class="position-absolute top-0 end-0 m-2">
                                    @* Truyền ProductId để xóa *@
                                    <input type="hidden" name="productId" value="@item.Product.Id" />
                                    <button type="submit" class="btn btn-light btn-sm rounded-circle shadow-sm text-danger" title="Xóa khỏi yêu thích" onclick="return confirm('Bỏ sản phẩm này khỏi danh sách yêu thích?')">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                </form>
                            </div>

                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title text-truncate">
                                    <a href="@Url.Action("Details", "Home", new { id = item.Product.Id })" class="text-decoration-none text-dark">
                                        @item.Product.ProductName
                                    </a>
                                </h5>
                                <p class="card-text text-danger fw-bold">@string.Format("{0:N0}", item.Product.Price) ₫</p>

                                <div class="mt-auto d-grid gap-2">
                                    @if (item.Product.StockQuantity > 0)
                                    {
                                        <form action="@Url.Action("AddToCart", "Cart")" method="post">
                                            @* SỬA: ProductID -> Id *@
                                            <input type="hidden" name="productId" value="@item.Product.Id" />
                                            <input type="hidden" name="quantity" value="1" />
                                            <button type="submit" class="btn btn-danger w-100 btn-sm"><i class="bi bi-cart-plus"></i> Thêm vào giỏ</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <button class="btn btn-secondary btn-sm w-100" disabled>Hết hàng</button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    }
</div>