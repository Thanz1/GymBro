@model GymBro.Core.Order

@{
    ViewData["Title"] = "Cập nhật đơn hàng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml"; // Đảm bảo Layout này đúng tên file của bạn
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h4 class="mb-0 text-primary">
                    <i class="bi bi-pencil-square"></i> Cập nhật Đơn hàng #@Model.Id
                </h4>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    @* Giữ ID của đơn hàng và UserId để không bị mất khi submit *@
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="UserId" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">Khách hàng</label>
                        <input type="text" class="form-control bg-light"
                               value="@(Model.User != null ? Model.User.FullName : "ID: " + Model.UserId)"
                               readonly />
                        <small class="text-muted">Không thể thay đổi khách hàng của đơn đã đặt.</small>
                    </div>

                    <div class="mb-3">
                        <label asp-for="OrderDate" class="form-label fw-bold">Ngày đặt hàng</label>
                        <input asp-for="OrderDate" class="form-control" type="datetime-local" readonly />
                        <span asp-validation-for="OrderDate" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Tổng tiền</label>
                        <div class="input-group">
                            <input type="text" class="form-control fw-bold text-danger"
                                   value="@Model.TotalAmount.ToString("N0")" readonly />
                            <span class="input-group-text">VNĐ</span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Status" class="form-label fw-bold">Trạng thái đơn hàng <span class="text-danger">*</span></label>
                        <select asp-for="Status" class="form-select" asp-items="ViewBag.Status"></select>
                        <span asp-validation-for="Status" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Quay lại
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save"></i> Lưu thay đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}