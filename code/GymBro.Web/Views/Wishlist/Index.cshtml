@model IEnumerable<GymBro.Core.Wishlist>

@functions {
    private const string FallbackImageUrl = "/Content/Images/shopping.webp";

    private static string ResolveImageUrl(string? imageUrl)
    {
        if (string.IsNullOrWhiteSpace(imageUrl))
        {
            return FallbackImageUrl;
        }

        if (imageUrl.StartsWith("/Content/", System.StringComparison.OrdinalIgnoreCase)
            || imageUrl.StartsWith("http://", System.StringComparison.OrdinalIgnoreCase)
            || imageUrl.StartsWith("https://", System.StringComparison.OrdinalIgnoreCase))
        {
            return imageUrl;
        }

        return imageUrl.StartsWith("/", System.StringComparison.Ordinal)
            ? imageUrl
            : "/Content/Images/" + imageUrl;
    }
}

@{
    ViewBag.Title = "Danh sách yêu thích";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <h2 class="mb-0"><i class="bi bi-heart-fill text-danger"></i> Danh sách yêu thích</h2>
        <a href="@Url.Action("Shop", "Home")" class="btn btn-outline-primary rounded-pill">
            <i class="bi bi-arrow-left"></i> Tiếp tục mua sắm
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            Bạn chưa lưu sản phẩm nào vào danh sách yêu thích.
            <a href="@Url.Action("Index", "Home")" class="alert-link">Xem trang chủ</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                if (item.Product != null)
                {
                    var imageUrl = ResolveImageUrl(item.Product.ImageURL);

                    <div class="col-md-3 col-sm-6">
                        <div class="card h-100 shadow-sm border-0 wishlist-card">
                            <div class="position-relative product-card-media rounded-top overflow-hidden bg-light">
                                <a href="@Url.Action("Details", "Home", new { id = item.Product.Id })">
                                    <img src="@Url.Content(imageUrl)"
                                         class="card-img-top product-card-image"
                                         alt="@item.Product.ProductName"
                                         loading="lazy"
                                         onerror="this.onerror=null; this.style.display='none'; this.parentElement.querySelector('.product-card-placeholder').classList.remove('is-hidden');" />
                                    <div class="product-card-placeholder is-hidden text-muted">
                                        <i class="bi bi-image fs-1"></i>
                                    </div>
                                </a>

                                <form action="@Url.Action("Remove", "Wishlist")" method="post" class="position-absolute top-0 end-0 m-2">
                                    <input type="hidden" name="productId" value="@item.Product.Id" />
                                    <button type="submit"
                                            class="btn btn-light btn-sm rounded-circle shadow-sm text-danger"
                                            title="Xóa khỏi yêu thích"
                                            onclick="return confirm('Bỏ sản phẩm này khỏi danh sách yêu thích?');">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                </form>
                            </div>

                            <div class="card-body d-flex flex-column">
                                <span class="text-muted small text-uppercase mb-2">@(item.Product.Category?.CategoryName ?? "Chưa phân loại")</span>
                                <h5 class="card-title text-truncate">
                                    <a href="@Url.Action("Details", "Home", new { id = item.Product.Id })" class="text-decoration-none text-dark">
                                        @item.Product.ProductName
                                    </a>
                                </h5>
                                <p class="card-text text-danger fw-bold">@item.Product.Price.ToString("N0") ₫</p>

                                <div class="mt-auto d-grid gap-2">
                                    @if (item.Product.StockQuantity > 0)
                                    {
                                        <form action="@Url.Action("AddToCart", "Cart")" method="post">
                                            <input type="hidden" name="productId" value="@item.Product.Id" />
                                            <input type="hidden" name="quantity" value="1" />
                                            <button type="submit" class="btn btn-danger w-100 btn-sm">
                                                <i class="bi bi-cart-plus"></i> Thêm vào giỏ
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <button class="btn btn-secondary btn-sm w-100" disabled>Hết hàng</button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    }
</div>
