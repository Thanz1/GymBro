@using GymBro.Contracts
@model IEnumerable<OrderDto>

@{
    ViewBag.Title = "Quản lý Đơn hàng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h2 class="mb-0 text-primary fw-bold"><i class="bi bi-receipt"></i> Quản lý Đơn hàng</h2>
        <a href="@Url.Action("Create")" class="btn btn-success shadow-sm"><i class="bi bi-plus-lg"></i> Tạo đơn</a>
    </div>
    <div class="card-body">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="row mb-4">
            <div class="col-md-12">
                <form action="@Url.Action("Index")" method="get" class="row g-2">
                    <div class="col-auto">
                        <input type="text" name="searchString" value="@ViewBag.CurrentSearch" class="form-control" placeholder="Mã ĐH, Tên khách..." style="width: 250px;" />
                    </div>
                    <div class="col-auto">
                        @Html.DropDownList("status", (SelectList)ViewBag.StatusList, "Tất cả trạng thái", new { @class = "form-select", onchange = "this.form.submit();" })
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-primary px-4">Tìm kiếm</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover table-bordered align-middle">
                <thead class="table-light">
                    <tr>
                        <th class="text-center">Mã ĐH</th>
                        <th>Ngày đặt</th>
                        <th>Khách hàng</th>
                        <th>Tổng tiền</th>
                        <th>Trạng thái</th>
                        <th class="text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center fw-bold text-primary">#@item.Id</td>
                            <td>@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <div class="fw-bold">@item.CustomerName</div>
                                <small class="text-muted">ID: @item.UserId</small>
                            </td>
                            <td class="fw-bold text-danger">@item.TotalAmount.ToString("N0") ₫</td>
                            <td>
                                @{
                                    string badgeClass = item.Status == "Chờ xử lý" ? "bg-warning text-dark" :
                                    item.Status == "Đã giao hàng" ? "bg-success" :
                                    item.Status == "Đã hủy" ? "bg-danger" : "bg-info";
                                }
                                <span class="badge @badgeClass rounded-pill px-3">@item.Status</span>
                            </td>
                            <td class="text-center">
                                <div class="btn-group">
                                    <a href="@Url.Action("Details", new { id = item.Id })" class="btn btn-sm btn-outline-info" title="Hóa đơn"><i class="bi bi-eye"></i></a>
                                    <a href="@Url.Action("Edit", new { id = item.Id })" class="btn btn-sm btn-outline-primary" title="Cập nhật"><i class="bi bi-pencil"></i></a>
                                    <a href="@Url.Action("Delete", new { id = item.Id })" class="btn btn-sm btn-outline-danger" title="Xóa"><i class="bi bi-trash"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>