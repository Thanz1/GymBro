@model GymBro.Core.Product

@functions {
    private const string FallbackImageUrl = "/Content/Images/shopping.webp";

    private static string ResolveImageUrl(string? imageUrl)
    {
        if (string.IsNullOrWhiteSpace(imageUrl))
        {
            return FallbackImageUrl;
        }

        if (imageUrl.StartsWith("/Content/", System.StringComparison.OrdinalIgnoreCase)
            || imageUrl.StartsWith("http://", System.StringComparison.OrdinalIgnoreCase)
            || imageUrl.StartsWith("https://", System.StringComparison.OrdinalIgnoreCase))
        {
            return imageUrl;
        }

        return imageUrl.StartsWith("/", System.StringComparison.Ordinal)
            ? imageUrl
            : "/Content/Images/" + imageUrl;
    }
}

@{
    var imageUrl = ResolveImageUrl(Model.ImageURL);
    var isOutOfStock = Model.StockQuantity <= 0;
    var isLowStock = Model.StockQuantity > 0 && Model.StockQuantity <= 5;
}

<div class="row g-4">
    <div class="col-md-6">
        <div class="text-center quick-view-image-wrap">
            <img src="@Url.Content(imageUrl)"
                 alt="@Model.ProductName"
                 class="img-fluid rounded quick-view-image"
                 loading="lazy"
                 onerror="this.onerror=null; this.style.display='none'; this.parentElement.querySelector('.quick-view-placeholder').classList.remove('d-none');" />
            <div class="quick-view-placeholder d-none">
                <div class="bg-light d-flex align-items-center justify-content-center rounded" style="height: 300px;">
                    <i class="bi bi-image text-muted" style="font-size: 3rem;"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <h4 class="fw-bold text-dark mb-3">@Model.ProductName</h4>

        <div class="mb-3">
            <span class="badge bg-secondary mb-2">@(Model.Category?.CategoryName ?? "Chưa phân loại")</span>
        </div>

        <div class="mb-3">
            <h3 class="text-primary fw-bold mb-0">@Model.Price.ToString("N0") ₫</h3>
        </div>

        <div class="mb-3">
            @if (isOutOfStock)
            {
                <span class="badge bg-danger"><i class="bi bi-x-circle"></i> Hết hàng</span>
            }
            else if (isLowStock)
            {
                <span class="badge bg-warning text-dark"><i class="bi bi-exclamation-triangle"></i> Sắp hết hàng</span>
            }
            else
            {
                <span class="badge bg-success"><i class="bi bi-check-circle"></i> Còn hàng</span>
            }
        </div>

        <div class="mb-4">
            <p class="text-muted mb-0">
                @if (string.IsNullOrWhiteSpace(Model.Description))
                {
                    <span>Sản phẩm chất lượng cao, phù hợp cho việc tập luyện thể thao hằng ngày.</span>
                }
                else
                {
                    @Html.Raw(Model.Description.Length > 160 ? Model.Description[..160] + "..." : Model.Description)
                }
            </p>
        </div>

        <div class="d-grid gap-2">
            <a href="@Url.Action("Details", "Home", new { id = Model.Id })" class="btn btn-primary">
                <i class="bi bi-eye"></i> Xem chi tiết
            </a>

            <form action="@Url.Action("AddToCart", "Cart")" method="post">
                <input type="hidden" name="productId" value="@Model.Id" />
                <input type="hidden" name="quantity" value="1" />
                <button type="submit" class="btn btn-success w-100" disabled="@(isOutOfStock ? "disabled" : null)">
                    <i class="bi bi-cart-plus"></i> @(isOutOfStock ? "Hết hàng" : "Thêm vào giỏ")
                </button>
            </form>
        </div>
    </div>
</div>
