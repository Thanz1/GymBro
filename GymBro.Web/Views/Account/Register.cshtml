@model GymBro.Contracts.RegisterDto

@{
    ViewBag.Title = "Đăng ký tài khoản";
}

<div class="auth-page">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card shadow border-0 rounded-3 p-4 mt-4">
                <h2 class="text-center fw-bold text-danger">Đăng ký tài khoản</h2>
                <hr />

                @using (Html.BeginForm()) 
                {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="mb-3">
                    <label class="form-label fw-bold">Tên đăng nhập *</label>
                    @Html.EditorFor(model => model.Username, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.Username, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Mật khẩu * (Tối thiểu 6 ký tự)</label>
                    @Html.EditorFor(model => model.Password, new { htmlAttributes = new { @class = "form-control", type = "password" } })
                    @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Họ và tên</label>
                    @Html.EditorFor(model => model.FullName, new { htmlAttributes = new { @class = "form-control" } })
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Email</label>
                    @Html.EditorFor(model => model.Email, new { htmlAttributes = new { @class = "form-control", type = "email" } })
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-success fw-bold">Tạo tài khoản</button>
                </div>
                }
            </div>
        </div>
    </div>
</div>