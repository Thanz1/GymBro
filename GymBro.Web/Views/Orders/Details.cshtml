@using GymBro.Contracts
@model OrderDto

@{
    ViewBag.Title = "Chi tiết Đơn hàng #" + Model.Id;
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container pb-5">
    <div class="d-flex justify-content-between align-items-center mb-4 no-print">
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary rounded-pill px-3">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
        <div class="d-flex gap-2">
            @if (Model.Status == "Chờ xử lý")
            {
                <a href="@Url.Action("Edit", new { id = Model.Id })" class="btn btn-primary rounded-pill px-4">
                    <i class="bi bi-pencil"></i> Cập nhật trạng thái
                </a>
            }
            <button onclick="window.print()" class="btn btn-success rounded-pill px-4">
                <i class="bi bi-printer"></i> In hóa đơn
            </button>
        </div>
    </div>

    <div class="card border-0 shadow-sm" id="invoice-card">
        <div class="card-body p-5">
            <div class="row mb-5 border-bottom pb-4">
                <div class="col-6">
                    <h2 class="text-danger fw-bold mb-2"><i class="bi bi-dumbbell"></i> GYMBRO Store</h2>
                    <p class="text-muted mb-0">Hệ thống quản lý thực phẩm bổ sung</p>
                </div>
                <div class="col-6 text-end">
                    <h4 class="text-uppercase mb-2">Hóa đơn bán hàng</h4>
                    <div class="text-muted">Mã đơn: <span class="fw-bold text-dark">#@Model.Id</span></div>
                    <div class="text-muted">Ngày đặt: <span class="fw-bold text-dark">@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</span></div>
                </div>
            </div>

            <div class="row mb-5">
                <div class="col-6">
                    <h6 class="text-uppercase text-muted fw-bold small mb-3">Thông tin khách hàng</h6>
                    <h5 class="fw-bold">@Model.CustomerName</h5>
                    <p class="mb-1"><i class="bi bi-envelope me-2"></i> @Model.CustomerEmail</p>
                    <p class="mb-1"><i class="bi bi-geo-alt me-2"></i> @Model.CustomerAddress</p>
                </div>
                <div class="col-6 text-end">
                    <h6 class="text-uppercase text-muted fw-bold small mb-3">Trạng thái hiện tại</h6>
                    <span class="badge @(Model.Status == "Đã giao hàng" ? "bg-success" : "bg-warning text-dark") fs-6 px-4">@Model.Status</span>
                </div>
            </div>

            <div class="table-responsive mb-4">
                <table class="table table-borderless">
                    <thead class="bg-light">
                        <tr>
                            <th class="py-3 ps-4">Sản phẩm</th>
                            <th class="py-3 text-center">Số lượng</th>
                            <th class="py-3 text-end">Đơn giá</th>
                            <th class="py-3 text-end pe-4">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderDetails)
                        {
                            <tr class="border-bottom">
                                <td class="ps-4 py-3 fw-bold text-primary">@item.ProductName</td>
                                <td class="text-center py-3">x @item.Quantity</td>
                                <td class="text-end py-3">@item.UnitPrice.ToString("N0") ₫</td>
                                <td class="text-end pe-4 py-3 fw-bold">@item.Total.ToString("N0") ₫</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="bg-light">
                            <td colspan="3" class="text-end fw-bold py-3 fs-5">TỔNG THANH TOÁN:</td>
                            <td class="text-end pe-4 py-3 fw-bold fs-5 text-danger">@Model.TotalAmount.ToString("N0") ₫</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    @@media print {
        .no-print {
            display: none !important;
        }

        #invoice-card {
            box-shadow: none !important;
            border: 1px solid #eee;
        }
    }
</style>