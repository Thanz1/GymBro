@model OrderDetailIndexViewModel

@{
    ViewBag.Title = "Quan ly Chi tiet Don hang";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3">
        <h2 class="mb-0 text-primary"><i class="bi bi-list-check"></i> Quan ly Chi tiet Don hang</h2>
    </div>
    <div class="card-body">
        @await Html.PartialAsync("~/Views/Shared/_Messages.cshtml")

        <div class="alert alert-info">
            Chi tiet don hang dang o che do chi xem. Thay doi san pham hoac so luong phai di qua workflow don hang chuan de giu dung ton kho va thanh toan.
        </div>

        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                @if (Model.OrderId.HasValue)
                {
                    <span class="text-muted">Dang xem chi tiet cua don hang #@Model.OrderId</span>
                }
            </div>
            <div class="d-flex gap-2">
                @if (Model.OrderId.HasValue)
                {
                    <a href="@Url.Action("Details", "Orders", new { id = Model.OrderId.Value })" class="btn btn-outline-primary">
                        <i class="bi bi-receipt"></i> Xem don hang goc
                    </a>
                }
                <a href="@Url.Action("Index", "Orders")" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Quay lai don hang
                </a>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover table-bordered align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Ma DH</th>
                        <th>San pham</th>
                        <th>So luong</th>
                        <th>Gia</th>
                        <th>Thanh tien</th>
                        <th>Trang thai DH</th>
                        <th class="text-center">Hanh dong</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">Khong co chi tiet don hang nao de hien thi.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <a href="@Url.Action("Details", "Orders", new { id = item.OrderId })">#@item.OrderId</a>
                                </td>
                                <td>@item.ProductName</td>
                                <td>@item.Quantity</td>
                                <td>@string.Format("{0:N0}", item.Price) VNĐ</td>
                                <td class="fw-bold text-primary">@string.Format("{0:N0}", item.TotalAmount) VNĐ</td>
                                <td>
                                    <span class="badge @item.OrderStatus.CssClass">@item.OrderStatus.Text</span>
                                </td>
                                <td class="text-center">
                                    @Html.ActionLink("Chi tiet", "Details", new { id = item.Id }, new { @class = "btn btn-sm btn-info" })
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
