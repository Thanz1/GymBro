@{
    ViewBag.Title = "Dashboard";
    // Nếu bạn có layout riêng cho admin thì để dòng dưới, không thì comment lại
    // Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid py-2">
    @* --- QUICK LINKS --- *@
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <a href="@Url.Action("Index", "Orders")" class="card text-decoration-none h-100 border-0 shadow-sm hover-shadow transition-all">
                <div class="card-body d-flex align-items-center p-3">
                    <div class="rounded-circle bg-info bg-opacity-10 p-3 me-3 text-info">
                        <i class="bi bi-receipt fs-3"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold text-dark mb-0">Đơn hàng</h6>
                        <small class="text-muted">Quản lý đơn hàng</small>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-3">
            <a href="@Url.Action("Index", "Payments")" class="card text-decoration-none h-100 border-0 shadow-sm hover-shadow transition-all">
                <div class="card-body d-flex align-items-center p-3">
                    <div class="rounded-circle bg-primary bg-opacity-10 p-3 me-3 text-primary">
                        <i class="bi bi-credit-card fs-3"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold text-dark mb-0">Thanh toán</h6>
                        <small class="text-muted">Lịch sử giao dịch</small>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-3">
            <a href="@Url.Action("Index", "Inventory")" class="card text-decoration-none h-100 border-0 shadow-sm hover-shadow transition-all">
                <div class="card-body d-flex align-items-center p-3">
                    <div class="rounded-circle bg-warning bg-opacity-10 p-3 me-3 text-warning">
                        <i class="bi bi-boxes fs-3"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold text-dark mb-0">Kho hàng</h6>
                        <small class="text-muted">Tồn kho & Lịch sử</small>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-3">
            @* Tạm thời để link về Products vì chưa có PurchaseOrders *@
            <a href="@Url.Action("Index", "Products")" class="card text-decoration-none h-100 border-0 shadow-sm hover-shadow transition-all">
                <div class="card-body d-flex align-items-center p-3">
                    <div class="rounded-circle bg-success bg-opacity-10 p-3 me-3 text-success">
                        <i class="bi bi-cart-plus fs-3"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold text-dark mb-0">Sản phẩm</h6>
                        <small class="text-muted">Quản lý sản phẩm</small>
                    </div>
                </div>
            </a>
        </div>
    </div>

    @* --- THỐNG KÊ --- *@
    <h5 class="fw-bold text-dark mb-3">Thống kê nhanh</h5>
    <div class="row g-4 mb-5">
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100" style="background: linear-gradient(45deg, #4e73df, #224abe);">
                <div class="card-body text-white p-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class="text-uppercase mb-1 opacity-75">Tổng Doanh Thu</h6>
                            <h3 class="fw-bold mb-0">@Convert.ToDecimal(ViewBag.TotalRevenue).ToString("N0") ₫</h3>
                        </div>
                        <div class="bg-white bg-opacity-25 rounded p-2">
                            <i class="bi bi-cash-stack fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100" style="background: linear-gradient(45deg, #1cc88a, #13855c);">
                <div class="card-body text-white p-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class="text-uppercase mb-1 opacity-75">Đơn Hàng Mới</h6>
                            <h3 class="fw-bold mb-0">@ViewBag.NewOrdersCount</h3>
                            <small class="opacity-75">Đang chờ xử lý</small>
                        </div>
                        <div class="bg-white bg-opacity-25 rounded p-2">
                            <i class="bi bi-cart-check fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100" style="background: linear-gradient(45deg, #36b9cc, #258391);">
                <div class="card-body text-white p-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class="text-uppercase mb-1 opacity-75">Thành Viên</h6>
                            <h3 class="fw-bold mb-0">@ViewBag.TotalMembersCount</h3>
                        </div>
                        <div class="bg-white bg-opacity-25 rounded p-2">
                            <i class="bi bi-people fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100" style="background: linear-gradient(45deg, #f6c23e, #dda20a);">
                <div class="card-body text-white p-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class="text-uppercase mb-1 opacity-75">Cảnh Báo Kho</h6>
                            <h3 class="fw-bold mb-0">@ViewBag.LowStockCount</h3>
                            <small class="opacity-75">Sắp hết hàng</small>
                        </div>
                        <div class="bg-white bg-opacity-25 rounded p-2">
                            <i class="bi bi-exclamation-triangle fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* --- BIỂU ĐỒ DOANH THU --- *@
    <div class="row mb-5">
        <div class="col-12">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3">
                    <h6 class="m-0 fw-bold text-primary"><i class="bi bi-graph-up"></i> Biểu đồ doanh thu (7 ngày gần nhất)</h6>
                </div>
                <div class="card-body">
                    <canvas id="revenueChart" style="max-height: 350px; width: 100%;"></canvas>
                </div>
            </div>
        </div>
    </div>

    @* --- ĐƠN HÀNG GẦN ĐÂY --- *@
    <div class="row g-4">
        <div class="col-lg-12 mb-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h6 class="m-0 fw-bold text-primary"><i class="bi bi-receipt"></i> Đơn hàng gần đây</h6>
                    <a href="@Url.Action("Index", "Orders")" class="btn btn-sm btn-outline-primary rounded-pill px-3">Xem tất cả</a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light text-muted">
                                <tr>
                                    <th class="ps-4 py-3">Mã ĐH</th>
                                    <th class="py-3">Khách hàng</th>
                                    <th class="py-3">Ngày đặt</th>
                                    <th class="py-3">Tổng tiền</th>
                                    <th class="py-3">Trạng thái</th>
                                    <th class="py-3"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (ViewBag.RecentOrders != null)
                                {
                                    foreach (var order in (List<GymBro.Core.Order>)ViewBag.RecentOrders)
                                    {
                                        <tr>
                                            <td class="ps-4 fw-bold text-primary">#@order.Id</td>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="avatar-sm bg-light rounded-circle me-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                                        <i class="bi bi-person text-secondary"></i>
                                                    </div>
                                                    @(order.User != null ? order.User.FullName : "Unknown")
                                                </div>
                                            </td>
                                            <td>@order.OrderDate.ToString("dd/MM/yyyy")</td>
                                            <td class="fw-bold">@order.TotalAmount.ToString("N0") ₫</td>
                                            <td>
                                                @if (order.Status == "Chờ xử lý")
                                                {
                                                    <span class="badge bg-warning text-dark">@order.Status</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success">@order.Status</span>
                                                }
                                            </td>
                                            <td class="text-end pe-4">
                                                <a href="@Url.Action("Details", "Orders", new { id = order.Id })" class="btn btn-sm btn-light text-primary" title="Chi tiết"><i class="bi bi-eye"></i></a>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .hover-shadow:hover {
        transform: translateY(-3px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
    }

    .transition-all {
        transition: all 0.3s ease;
    }
</style>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        var ctx = document.getElementById('revenueChart').getContext('2d');

        // SỬA: Dùng Json.Serialize cho .NET Core
        var labels = @Html.Raw(Json.Serialize(ViewBag.ChartLabels));
        var data = @Html.Raw(Json.Serialize(ViewBag.ChartData));

        var revenueChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Doanh thu',
                    data: data,
                    borderColor: '#4e73df',
                    backgroundColor: 'rgba(78, 115, 223, 0.1)',
                    borderWidth: 3,
                    pointRadius: 4,
                    pointHoverRadius: 6,
                    pointBackgroundColor: '#4e73df',
                    fill: true,
                    tension: 0.3
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) {
                                if (value >= 1000000) return (value / 1000000) + 'M';
                                if (value >= 1000) return (value / 1000) + 'k';
                                return value;
                            }
                        }
                    }
                }
            }
        });
    });
</script>