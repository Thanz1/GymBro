@using GymBro.Contracts
@model IEnumerable<WishlistDto>

@{
    ViewBag.Title = "Danh sách yêu thích";
}

<div class="container py-5">
    <div class="d-flex align-items-center mb-4">
        <h2 class="fw-bold mb-0"><i class="bi bi-heart-fill text-danger me-2"></i> Sản phẩm yêu thích</h2>
        <span class="ms-3 badge bg-secondary rounded-pill">@(Model?.Count() ?? 0) sản phẩm</span>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="card border-0 shadow-sm p-5 text-center">
            <div class="mb-4">
                <i class="bi bi-heart text-muted" style="font-size: 4rem; opacity: 0.3;"></i>
            </div>
            <h4>Danh sách của bạn đang trống</h4>
            <p class="text-muted">Hãy quay lại cửa hàng để chọn những sản phẩm ưng ý nhất.</p>
            <div class="mt-3">
                <a href="@Url.Action("Shop", "Home")" class="btn btn-danger px-4 rounded-pill shadow-sm">
                    TIẾP TỤC MUA SẮM
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-md-3 col-sm-6">
                    <div class="card h-100 shadow-sm border-0 product-card-hover">
                        <div class="position-relative">
                            @* Link chi tiết sản phẩm *@
                            <a href="@Url.Action("Details", "Home", new { id = item.ProductId })">
                                <img src="~/Content/Images/@(string.IsNullOrEmpty(item.ProductImageURL) ? "no-image.png" : item.ProductImageURL)"
                                     class="card-img-top"
                                     alt="@item.ProductName"
                                     style="height: 220px; object-fit: cover;"
                                     onerror="this.src='/Content/Images/no-image.png'" />
                            </a>

                            @* Nút Xóa (Góc trên phải) *@
                            <form action="@Url.Action("Remove", "Wishlist")" method="post" class="position-absolute top-0 end-0 m-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productId" value="@item.ProductId" />
                                <button type="submit" class="btn btn-white btn-sm rounded-circle shadow-sm text-danger border-0"
                                        title="Xóa khỏi yêu thích"
                                        onclick="return confirm('Bỏ sản phẩm này khỏi danh sách yêu thích?')">
                                    <i class="bi bi-heart-break-fill"></i>
                                </button>
                            </form>
                        </div>

                        <div class="card-body d-flex flex-column">
                            <h6 class="card-title text-truncate fw-bold mb-2">
                                <a href="@Url.Action("Details", "Home", new { id = item.ProductId })" class="text-decoration-none text-dark">
                                    @item.ProductName
                                </a>
                            </h6>
                            <p class="card-text text-danger fw-bold fs-5 mb-3">@item.ProductPrice.ToString("N0") ₫</p>

                            <div class="mt-auto d-grid gap-2">
                                @if (item.StockQuantity > 0)
                                {
                                    <form action="@Url.Action("AddToCart", "Cart")" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                        <input type="hidden" name="quantity" value="1" />
                                        <button type="submit" class="btn btn-outline-danger w-100 btn-sm rounded-pill fw-bold">
                                            <i class="bi bi-cart-plus me-1"></i> THÊM VÀO GIỎ
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button class="btn btn-light btn-sm w-100 rounded-pill disabled" disabled>HẾT HÀNG</button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>