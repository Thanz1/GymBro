@model GymBro.Core.User

@{
    ViewBag.Title = "Chi tiết Người dùng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h4 class="mb-0 text-info">Chi tiết Người dùng</h4>
            </div>
            <div class="card-body">
                <table class="table table-bordered">
                    <tr>
                        <th class="bg-light" style="width: 35%;">Tên đăng nhập</th>
                        <td class="fw-bold">@Model.Username</td>
                    </tr>
                    <tr>
                        <th class="bg-light">Họ và tên</th>
                        <td>@(string.IsNullOrEmpty(Model.FullName) ? "Chưa cập nhật" : Model.FullName)</td>
                    </tr>
                    <tr>
                        <th class="bg-light">Email</th>
                        <td>@(string.IsNullOrEmpty(Model.Email) ? "Chưa cập nhật" : Model.Email)</td>
                    </tr>
                    <tr>
                        <th class="bg-light">Địa chỉ</th>
                        <td>@(string.IsNullOrEmpty(Model.Address) ? "Chưa cập nhật" : Model.Address)</td>
                    </tr>
                    <tr>
                        <th class="bg-light">Vai trò</th>
                        <td>
                            @if (Model.Role == "Admin")
                            {
                                <span class="badge bg-danger">Quản trị viên</span>
                            }
                            else
                            {
                                <span class="badge bg-info text-dark">Người dùng</span>
                            }
                        </td>
                    </tr>
                    <tr>
                        <th class="bg-light">Ngày tạo</th>
                        <td>@Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")</td>
                    </tr>
                </table>

                <div class="mt-4 d-flex justify-content-end gap-2">
                    @* SỬA: UserID -> Id *@
                    <a href="@Url.Action("Edit", new { id = Model.Id })" class="btn btn-primary"><i class="bi bi-pencil"></i> Sửa</a>
                    <a href="@Url.Action("Index")" class="btn btn-secondary">Quay lại</a>
                </div>
            </div>
        </div>
    </div>
</div>