@using GymBro.Contracts
@model ProductDto

@{
    ViewBag.Title = "Chi tiết Sản phẩm";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container">
    <div class="card border-0 shadow-sm mt-4">
        <div class="card-body p-5">
            <div class="row">
                <div class="col-md-5 text-center">
                    <img src="~/Content/Images/@(string.IsNullOrEmpty(Model.ImageURL) ? "no-image.png" : Model.ImageURL)"
                         class="img-fluid rounded shadow-sm" style="max-height: 400px;" onerror="this.src='/Content/Images/no-image.png'" />[cite: 42]
                </div>
                <div class="col-md-7">
                    <h2 class="fw-bold">@Model.ProductName</h2>[cite: 42]
                    <div class="mb-3">
                        <span class="badge bg-info text-dark">@(Model.CategoryName ?? "Chưa phân loại")</span>[cite: 42]
                        <span class="text-muted ms-3">Mã SP: #@Model.Id</span>[cite: 42]
                    </div>
                    <h3 class="text-danger fw-bold mb-4">@Model.Price.ToString("N0") VNĐ</h3>[cite: 42]

                    <div class="mb-4">
                        <p class="mb-1">
                            <strong>Tình trạng kho:</strong>
                            <span class="@(Model.StockQuantity > 0 ? "text-success" : "text-danger") fw-bold">
                                @(Model.StockQuantity > 0 ? Model.StockQuantity + " sản phẩm" : "Hết hàng")
                            </span>[cite: 42]
                        </p>
                    </div>

                    <div class="bg-light p-3 rounded mb-4">
                        <h6 class="fw-bold">Mô tả sản phẩm:</h6>
                        <div class="mt-2 text-secondary">
                            @Html.Raw(Model.Description ?? "Chưa có mô tả.")
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <a href="@Url.Action("Edit", new { id = Model.Id })" class="btn btn-primary"><i class="bi bi-pencil"></i> Chỉnh sửa</a>[cite: 42]
                        <a href="@Url.Action("Index")" class="btn btn-secondary">Quay lại</a>[cite: 42]
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>