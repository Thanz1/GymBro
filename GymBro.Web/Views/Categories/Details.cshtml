@using GymBro.Contracts
@model CategoryDto

@{
    ViewBag.Title = "Chi tiết Danh mục";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3 text-info fw-bold">
                <h4 class="mb-0">Chi tiết Danh mục</h4>
            </div>
            <div class="card-body p-4">
                <div class="mb-3">
                    <label class="text-muted small">Mã định danh (ID)</label>
                    <div class="p-2 bg-light border rounded fw-bold">#@Model.Id</div>
                </div>
                <div class="mb-4">
                    <label class="text-muted small">Tên danh mục</label>
                    <div class="p-2 bg-light border rounded fw-bold">@Model.CategoryName</div>
                </div>

                <div class="d-flex gap-2">
                    <a href="@Url.Action("Edit", new { id = Model.Id })" class="btn btn-primary"><i class="bi bi-pencil"></i> Chỉnh sửa</a>
                    <a href="@Url.Action("Index")" class="btn btn-secondary">Quay lại</a>
                </div>
            </div>
        </div>
    </div>
</div>