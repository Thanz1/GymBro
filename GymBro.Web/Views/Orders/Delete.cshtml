@model GymBro.Core.Order

@{
    ViewBag.Title = "Xóa Đơn hàng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h4 class="mb-0 text-danger"><i class="bi bi-trash"></i> Xóa Đơn hàng</h4>
            </div>
            <div class="card-body">
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <strong>Bạn có chắc chắn muốn xóa đơn hàng này?</strong>
                    <p class="mb-0 mt-2">Hành động này không thể hoàn tác. Đơn hàng này sẽ bị xóa vĩnh viễn.</p>
                </div>

                <dl class="row mb-4">
                    <dt class="col-sm-4">Mã đơn hàng:</dt>
                    @* SỬA: OrderID -> Id *@
                    <dd class="col-sm-8 fw-bold">#@Model.Id</dd>

                    <dt class="col-sm-4">Ngày đặt hàng:</dt>
                    <dd class="col-sm-8">@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</dd>

                    <dt class="col-sm-4">Trạng thái:</dt>
                    <dd class="col-sm-8">
                        @if (Model.Status == "Chờ xử lý")
                        {
                            <span class="badge bg-warning text-dark">@Model.Status</span>
                        }
                        else if (Model.Status == "Đã giao hàng")
                        {
                            <span class="badge bg-success">@Model.Status</span>
                        }
                        else if (Model.Status == "Đã hủy")
                        {
                            <span class="badge bg-danger">@Model.Status</span>
                        }
                        else
                        {
                            <span class="badge bg-info">@Model.Status</span>
                        }
                    </dd>

                    <dt class="col-sm-4">Tổng tiền:</dt>
                    <dd class="col-sm-8 text-primary fw-bold">@string.Format("{0:N0}", Model.TotalAmount) VNĐ</dd>

                    <dt class="col-sm-4">Người dùng:</dt>
                    <dd class="col-sm-8">@(Model.User != null ? Model.User.Username : "Unknown")</dd>
                </dl>

                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()

                    <div class="d-flex justify-content-end gap-2">
                        <a href="@Url.Action("Index")" class="btn btn-secondary">Hủy bỏ</a>
                        <button type="submit" class="btn btn-danger" onclick="return confirmDelete()">
                            <i class="bi bi-trash"></i> Xác nhận Xóa
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete() {
            // SỬA: OrderID -> Id
            return confirm('Bạn có chắc chắn muốn xóa đơn hàng #@Model.Id?\n\nHành động này không thể hoàn tác!');
        }
    </script>
}