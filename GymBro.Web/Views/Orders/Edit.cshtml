@using GymBro.Contracts
@model OrderDto

@{
    ViewBag.Title = "Cập nhật Đơn hàng #" + Model.Id;
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h4 class="mb-0 text-primary fw-bold"><i class="bi bi-pencil-square"></i> Cập nhật trạng thái đơn hàng</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="UserId" />

                    <div class="mb-3">
                        <label class="form-label text-muted">Khách hàng:</label>
                        <div class="form-control bg-light fw-bold">@Model.CustomerName</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Status" class="form-label fw-bold">Trạng thái mới <span class="text-danger">*</span></label>
                        <select asp-for="Status" class="form-select shadow-sm border-primary" asp-items="ViewBag.Status"></select>
                        <span asp-validation-for="Status" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-secondary px-4">Quay lại</a>
                        <button type="submit" class="btn btn-primary px-4 fw-bold shadow-sm">LƯU THAY ĐỔI</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>