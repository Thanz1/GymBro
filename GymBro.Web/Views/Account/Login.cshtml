@{
    ViewBag.Title = "Đăng nhập";
}

<div class="auth-page">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-7 col-sm-9">
            <div style="background: white; border-radius: 15px; box-shadow: 0 10px 25px rgba(0,0,0,0.15); padding: 40px; margin-top: 30px;">
                <div class="text-center mb-4">
                    <i class="bi bi-person-circle" style="font-size: 4rem; color: #dc3545; margin-bottom: 15px;"></i>
                    <h2 style="font-weight: 700; color: #2c3e50; margin-bottom: 10px;">Đăng nhập</h2>
                    <p class="text-muted">Chào mừng bạn trở lại GYMBRO</p>
                </div>

                @if (ViewBag.ErrorMessage != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show">
                        <i class="bi bi-exclamation-triangle"></i> @ViewBag.ErrorMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show">
                        <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @using (Html.BeginForm("Login", "Account", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <div class="form-group mb-4">
                        <label class="form-label" style="font-weight: 600; color: #2c3e50; margin-bottom: 8px;">
                            <i class="bi bi-person"></i> Tên đăng nhập
                        </label>
                        <input type="text" name="username" class="form-control" required
                               placeholder="Nhập tên đăng nhập"
                               style="padding: 12px 15px; font-size: 1rem;" />
                    </div>

                    <div class="form-group mb-4">
                        <label class="form-label" style="font-weight: 600; color: #2c3e50; margin-bottom: 8px;">
                            <i class="bi bi-lock"></i> Mật khẩu
                        </label>
                        <input type="password" name="password" class="form-control" required
                               placeholder="Nhập mật khẩu"
                               style="padding: 12px 15px; font-size: 1rem;" />
                    </div>

                    <div class="form-group mb-4">
                        <div class="d-grid">
                            <button type="submit" class="btn btn-success btn-lg"
                                    style="padding: 15px; font-size: 1.1rem; font-weight: 600; border-radius: 10px;">
                                <i class="bi bi-box-arrow-in-right"></i> Đăng nhập
                            </button>
                        </div>
                    </div>
                }

                <div class="text-center" style="padding-top: 20px; border-top: 1px solid #e0e0e0;">
                    <p class="mb-0" style="color: #6c757d;">
                        Chưa có tài khoản?
                        @Html.ActionLink("Đăng ký ngay", "Register", null, new {
                        @class = "text-decoration-none",
                                                style = "color: #dc3545; font-weight: 600;"
                                                })
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>