@model OrderReadOnlyViewModel

@{
    ViewBag.Title = "Chi tiet don hang #" + Model.Id;
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var payment = Model.Payment;
}

<div class="container pb-5">
    <div class="d-flex justify-content-between align-items-center mb-4 no-print">
        <div>
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary rounded-pill px-3">
                <i class="bi bi-arrow-left"></i> Quay lai danh sach
            </a>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Edit", new { id = Model.Id })" class="btn btn-primary rounded-pill px-4">
                <i class="bi bi-pencil"></i> Cap nhat trang thai
            </a>
            <button onclick="window.print()" class="btn btn-success rounded-pill px-4">
                <i class="bi bi-printer"></i> In hoa don
            </button>
        </div>
    </div>

    <div class="card border-0 shadow-sm" id="invoice-card">
        <div class="card-body p-5">
            <div class="row mb-5 border-bottom pb-4">
                <div class="col-md-6">
                    <h2 class="text-danger fw-bold mb-2"><i class="bi bi-dumbbell"></i> GYMBRO</h2>
                    <p class="text-muted mb-0">Cua hang dung cu the thao hang dau</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <h4 class="text-uppercase mb-2">Hoa don ban hang</h4>
                    <div class="text-muted">Ma don: <span class="fw-bold text-dark">#@Model.Id</span></div>
                    <div class="text-muted">Ngay dat: <span class="fw-bold text-dark">@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</span></div>
                    <div class="mt-2">
                        Trang thai:
                        <span class="badge @Model.OrderStatus.CssClass">@Model.OrderStatus.Text</span>
                    </div>
                </div>
            </div>

            <div class="row mb-5">
                <div class="col-md-6">
                    <h6 class="text-uppercase text-muted fw-bold small mb-3">Thong tin khach hang</h6>
                    <h5 class="fw-bold">@Model.CustomerDisplayName</h5>
                    <p class="mb-1"><i class="bi bi-person me-2"></i> @Model.CustomerUsername</p>
                    <p class="mb-1"><i class="bi bi-envelope me-2"></i> @Model.CustomerEmail</p>
                    <p class="mb-1"><i class="bi bi-geo-alt me-2"></i> @Model.CustomerAddress</p>
                </div>
                <div class="col-md-6">
                    <h6 class="text-uppercase text-muted fw-bold small mb-3">Thong tin nguoi gui</h6>
                    <h5 class="fw-bold">GYMBRO Store</h5>
                    <p class="mb-1">77 Duong so 26A, Phuong 10, Quan 6, TPHCM</p>
                    <p class="mb-1">Hotline: 0902 662 298</p>
                    <p class="mb-1">Email: storethietbi@gmail.com</p>
                </div>
            </div>

            @if (payment != null)
            {
                <div class="row mb-5">
                    <div class="col-12">
                        <div class="border rounded-3 bg-light p-3">
                            <h6 class="text-uppercase text-muted fw-bold small mb-3">Thanh toan gan nhat</h6>
                            <div class="row g-3">
                                <div class="col-md-3">
                                    <div class="text-muted small">Phuong thuc</div>
                                    <div class="fw-bold">@payment.Method</div>
                                </div>
                                <div class="col-md-3">
                                    <div class="text-muted small">Trang thai</div>
                                    <div><span class="badge @payment.Status.CssClass">@payment.Status.Text</span></div>
                                </div>
                                <div class="col-md-3">
                                    <div class="text-muted small">Cap nhat luc</div>
                                    <div class="fw-bold">@payment.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                                </div>
                                <div class="col-md-3">
                                    <div class="text-muted small">So tien</div>
                                    <div class="fw-bold text-primary">@payment.Amount.ToString("N0") VND</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <div class="table-responsive mb-4">
                <table class="table table-borderless mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="py-3 ps-4">San pham</th>
                            <th class="py-3 text-center">So luong</th>
                            <th class="py-3 text-end">Don gia</th>
                            <th class="py-3 text-end pe-4">Thanh tien</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items.Any())
                        {
                            foreach (var item in Model.Items)
                            {
                                <tr class="border-bottom">
                                    <td class="ps-4 py-3">
                                        <div class="fw-bold text-primary">@item.ProductName</div>
                                        <small class="text-muted">Ma SP: #@item.ProductId</small>
                                    </td>
                                    <td class="text-center py-3">x @item.Quantity</td>
                                    <td class="text-end py-3">@item.Price.ToString("N0") VND</td>
                                    <td class="text-end pe-4 py-3 fw-bold">@item.TotalAmount.ToString("N0") VND</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">Khong co chi tiet san pham.</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="bg-light">
                        <tr>
                            <td colspan="3" class="text-end fw-bold py-3 fs-5">Tong cong:</td>
                            <td class="text-end pe-4 py-3 fw-bold fs-5 text-danger">@Model.TotalAmount.ToString("N0") VND</td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <div class="row mt-5">
                <div class="col-12 text-center text-muted small">
                    <p>Cam on quy khach da mua hang tai GYMBRO.</p>
                    <p>Vui long giu lai hoa don de doi tra trong vong 7 ngay neu co loi tu nha san xuat.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    @@media print {
        .no-print, header, footer, .navbar, .footer {
            display: none !important;
        }

        body {
            background-color: white !important;
            padding: 0 !important;
            margin: 0 !important;
        }

        .container {
            max-width: 100% !important;
            padding: 0 !important;
        }

        #invoice-card {
            box-shadow: none !important;
            border: none !important;
        }
    }
</style>
