@model AccountOrderHistoryViewModel

@{
    ViewBag.Title = "Lich su don hang";
    var orders = Model.Orders;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h2 class="mb-1">Lich su don hang</h2>
        <div class="text-muted">Theo doi trang thai don hang va thanh toan cua ban.</div>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("MyAccount", "Account")" class="btn btn-outline-secondary">Tai khoan cua toi</a>
        <a href="@Url.Action("Shop", "Home")" class="btn btn-primary">Tiep tuc mua sam</a>
    </div>
</div>

@if (!orders.Any())
{
    <div class="alert alert-info">
        Ban chua co don hang nao. <a href="@Url.Action("Shop", "Home")">Mua sam ngay</a>
    </div>
}
else
{
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @await Html.PartialAsync("~/Views/Shared/_OrderSummaryTable.cshtml", orders)
        </div>
    </div>
}
