@using GymBro.Contracts
@model SupplierDto

@{
    ViewBag.Title = "Xóa Nhà cung cấp";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card border-0 shadow-sm border-top border-danger border-4 mt-5">
            <div class="card-body p-4 text-center">
                <i class="bi bi-exclamation-triangle display-1 text-danger mb-3"></i>
                <h3 class="fw-bold">Xác nhận xóa?</h3>
                <p class="text-muted">Bạn đang thực hiện xóa nhà cung cấp <strong>"@Model.SupplierName"</strong>. Các phiếu nhập hàng liên quan có thể bị ảnh hưởng[cite: 52].</p>

                <div class="alert alert-light border text-start small mb-4">
                    <div class="mb-1"><strong>Email:</strong> @(Model.Email ?? "---")</div>
                    <div class="mb-0"><strong>SĐT:</strong> @(Model.Phone ?? "---")</div>
                </div>

                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    <div class="d-flex justify-content-center gap-3">
                        <button type="submit" class="btn btn-danger btn-lg px-4 shadow-sm">XÓA NGAY</button>
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-lg px-4">HỦY BỎ</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>