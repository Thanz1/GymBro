@using GymBro.Web.Helpers
@using GymBro.Contracts

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - GYMBRO</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
</head>
<body>
    @{
        // SỬA: Lấy UserDto từ Session
        var user = Context.Session.GetObject<UserDto>("User");
        var cart = Context.Session.GetObject<List<CartItemDto>>("Cart");
        int totalItemsInCart = cart?.Sum(item => item.Quantity) ?? 0;
    }

    <nav class="navbar navbar-expand-lg navbar-dark bg-danger py-3">
        <div class="container">
            <a class="navbar-brand fw-bold" href="@Url.Action("Index", "Home")"><i class="bi bi-dumbbell"></i> GYMBRO</a>

            <form action="@Url.Action("Shop", "Home")" method="GET" class="d-flex flex-grow-1 mx-4">
                <div class="input-group">
                    <input type="search"
                           name="keyword"
                           value="@ViewBag.Keyword"
                           class="form-control rounded-start-pill border-0 px-4"
                           placeholder="Bạn muốn tìm thiết bị, thực phẩm gì?">
                    <button class="btn btn-light rounded-end-pill px-3" type="submit">
                        <i class="bi bi-search text-danger fw-bold"></i>
                    </button>
                </div>
            </form>

            <ul class="navbar-nav d-flex align-items-center gap-3 flex-row">
                @if (user != null)
                {
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle text-white" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-person-circle"></i> @(user.FullName ?? user.Username)
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            @if (user.Role == "Admin")
                            {
                                <li><a class="dropdown-item text-primary fw-bold" href="@Url.Action("Index", "Products")"><i class="bi bi-speedometer2"></i> Quản trị</a></li>
                            }
                            <li><a class="dropdown-item" href="@Url.Action("MyAccount", "Account")">Tài khoản</a></li>
                            <li><a class="dropdown-item text-danger" href="@Url.Action("Logout", "Account")">Đăng xuất</a></li>
                        </ul>
                    </li>
                }
                else
                {
                    <li class="nav-item"><a href="@Url.Action("Login", "Account")" class="text-white text-decoration-none">Đăng nhập</a></li>
                }
                <li class="nav-item">
                    <a href="@Url.Action("Index", "Cart")" class="text-white position-relative">
                        <i class="bi bi-cart fs-4"></i>
                        <span class="badge rounded-pill bg-white text-danger position-absolute top-0 start-100 translate-middle">@totalItemsInCart</span>
                    </a>
                </li>
            </ul>
        </div>
    </nav>

    <div class="container py-4">
        @await Html.PartialAsync("_Messages")
        @RenderBody()
    </div>

    <footer class="bg-dark text-white py-4 mt-5">
        <div class="text-center">
            <small>&copy; @DateTime.Now.Year - GYMBRO - Sức mạnh từ sự kiên trì</small>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    @await Html.PartialAsync("_ChatWidget")
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    @await Html.PartialAsync("_ChatWidget")

    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>