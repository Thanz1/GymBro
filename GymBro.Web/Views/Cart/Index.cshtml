@using GymBro.Contracts
@model IEnumerable<CartItemDto>

@{
    ViewBag.Title = "Giỏ hàng";
    var totalPrice = ViewData["TotalPrice"] is decimal value ? value : 0m;
}

<div class="cart-page container py-4">
    <h2 class="fw-bold text-dark mb-4"><i class="bi bi-cart-check"></i> Giỏ hàng của bạn</h2>

    @* ĐÃ SỬA: Hiển thị thông báo khi Order.API sập *@
    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-warning text-center py-5 shadow-sm rounded-3 border-0">
            <i class="bi bi-exclamation-triangle-fill display-4 text-warning mb-3 d-block"></i>
            <h4 class="fw-bold text-dark">Hệ thống đơn hàng đang bảo trì!</h4>
            <p class="text-muted fs-5">@ViewBag.ErrorMessage</p>
            <a href="@Url.Action("Index", "Home")" class="btn btn-dark mt-3 px-4 rounded-pill">Quay lại trang chủ</a>
        </div>
    }
    else if (Model == null || !Model.Any())
    {
        <div class="empty-cart text-center py-5 bg-white shadow-sm rounded-3">
            <i class="bi bi-cart-x display-1 text-danger"></i>
            <h3 class="mt-3">Giỏ hàng của bạn đang trống</h3>
            <a href="@Url.Action("Index", "Home")" class="btn btn-primary mt-3">Tiếp tục mua sắm</a>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
                    <table class="table align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th>Sản phẩm</th>
                                <th>Đơn giá</th>
                                <th style="width: 150px;">Số lượng</th>
                                <th>Thành tiền</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <img src="~/Content/Images/@item.ImageURL" class="rounded me-3" style="width: 60px; height: 60px; object-fit: cover;" onerror="this.src='/Content/Images/no-image.png'" />
                                            <span class="fw-bold">@item.ProductName</span>
                                        </div>
                                    </td>
                                    <td>@item.Price.ToString("N0") ₫</td>
                                    <td>
                                        <form asp-action="UpdateCart" asp-controller="Cart" method="post">
                                            <input type="hidden" name="id" value="@item.ProductId" />
                                            <input type="number" name="quantity" value="@item.Quantity" class="form-control form-control-sm text-center" onchange="this.form.submit()" min="1" />
                                        </form>
                                    </td>
                                    <td class="fw-bold text-danger">@item.ThanhTien.ToString("N0") ₫</td>
                                    <td>
                                        <a href="@Url.Action("RemoveFromCart", "Cart", new { id = item.ProductId })" class="text-danger" onclick="return confirm('Xóa sản phẩm này?')"><i class="bi bi-trash"></i></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow-sm p-4 sticky-top" style="top: 20px;">
                    <h5 class="fw-bold border-bottom pb-2 mb-3">Tóm tắt đơn hàng</h5>
                    <div class="d-flex justify-content-between mb-3">
                        <span>Tổng tiền:</span>
                        <h4 class="text-danger fw-bold">@totalPrice.ToString("N0") ₫</h4>
                    </div>
                    <a href="@Url.Action("Checkout", "Cart")" class="btn btn-success w-100 py-3 fw-bold">TIẾN HÀNH THANH TOÁN</a>
                </div>
            </div>
        </div>
    }
</div>