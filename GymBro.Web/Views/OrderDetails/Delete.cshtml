@model GymBro.Core.OrderDetail

@{
    ViewBag.Title = "Xóa Chi tiết Đơn hàng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h4 class="mb-0 text-danger"><i class="bi bi-trash"></i> Xóa Chi tiết Đơn hàng</h4>
            </div>
            <div class="card-body">
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <strong>Bạn có chắc chắn muốn xóa chi tiết đơn hàng này?</strong>
                    <p class="mb-0 mt-2">Hành động này sẽ ảnh hưởng đến tổng tiền của đơn hàng gốc.</p>
                </div>

                <table class="table table-bordered mt-4">
                    <tr>
                        <th class="bg-light" style="width: 35%;">Mã Đơn hàng</th>
                        @* SỬA: OrderID -> OrderId *@
                        <td>#@Model.OrderId</td>
                    </tr>
                    <tr>
                        <th class="bg-light">Sản phẩm</th>
                        <td>@Html.DisplayFor(model => model.Product.ProductName)</td>
                    </tr>
                    <tr>
                        <th class="bg-light">Số lượng</th>
                        <td>@Html.DisplayFor(model => model.Quantity)</td>
                    </tr>
                    <tr>
                        <th class="bg-light">Thành tiền</th>
                        <td class="fw-bold">@string.Format("{0:N0}", Model.Quantity * Model.Price) VNĐ</td>
                    </tr>
                </table>

                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        @Html.ActionLink("Hủy", "Index", null, new { @class = "btn btn-secondary" })
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash"></i> Xác nhận Xóa
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>