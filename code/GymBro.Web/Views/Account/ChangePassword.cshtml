@{
    ViewBag.Title = "Đổi mật khẩu";
}

<h2>Đổi mật khẩu</h2>
<hr />

@using (Html.BeginForm("ChangePassword", "Account", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <div class="form-group">
            <label class="control-label col-md-2">Mật khẩu cũ <span class="text-danger">*</span></label>
            <div class="col-md-10">
                <input type="password" name="oldPassword" class="form-control" required autocomplete="current-password" />
            </div>
        </div>

        <div class="form-group">
            <label class="control-label col-md-2">Mật khẩu mới <span class="text-danger">*</span></label>
            <div class="col-md-10">
                <input type="password" name="newPassword" class="form-control" required minlength="6" autocomplete="new-password" />
                <small class="text-muted">Mật khẩu phải có ít nhất 6 ký tự</small>
            </div>
        </div>

        <div class="form-group">
            <label class="control-label col-md-2">Xác nhận mật khẩu mới <span class="text-danger">*</span></label>
            <div class="col-md-10">
                <input type="password" name="confirmPassword" class="form-control" required minlength="6" autocomplete="new-password" />
            </div>
        </div>

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="form-group">
                <div class="col-md-offset-2 col-md-10">
                    <div class="alert alert-danger">
                        <i class="bi bi-exclamation-triangle"></i> @ViewBag.ErrorMessage
                    </div>
                </div>
            </div>
        }

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Đổi mật khẩu" class="btn btn-primary" />
                @Html.ActionLink("Hủy", "MyAccount", "Account", null, new { @class = "btn btn-secondary" })
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var newPassword = document.querySelector('input[name="newPassword"]');
            var confirmPassword = document.querySelector('input[name="confirmPassword"]');

            function validatePasswordMatch() {
                if (confirmPassword.value && newPassword.value !== confirmPassword.value) {
                    confirmPassword.setCustomValidity('Mật khẩu xác nhận không khớp');
                } else {
                    confirmPassword.setCustomValidity('');
                }
            }

            newPassword.addEventListener('input', validatePasswordMatch);
            confirmPassword.addEventListener('input', validatePasswordMatch);
        });
    </script>
}