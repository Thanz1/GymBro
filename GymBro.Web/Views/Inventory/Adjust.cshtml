@model GymBro.Core.Product

@{
    ViewBag.Title = "Điều chỉnh kho";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-warning text-dark py-3">
                <h4 class="mb-0"><i class="bi bi-pencil-square"></i> Điều chỉnh kho: @Model.ProductName</h4>
            </div>
            <div class="card-body">
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    @* SỬA: ProductID -> Id *@
                    @Html.HiddenFor(model => model.Id)

                    <div class="form-horizontal">
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                        @if (TempData["Error"] != null)
                        {
                            <div class="alert alert-danger"><i class="bi bi-exclamation-circle"></i> @TempData["Error"]</div>
                        }

                        <div class="mb-3">
                            <label class="form-label fw-bold">Tồn kho hiện tại:</label>
                            <div class="form-control bg-light">@Model.StockQuantity</div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Tồn kho thực tế (Mới) <span class="text-danger">*</span>:</label>
                            <input type="number" name="NewQuantity" class="form-control" value="@Model.StockQuantity" required min="0" />
                            <small class="text-muted">Nhập số lượng thực tế kiểm kê được.</small>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Ghi chú / Lý do:</label>
                            <textarea name="Note" class="form-control" rows="3" placeholder="Ví dụ: Hỏng hóc, mất mát, nhập sai, cân bằng kho..."></textarea>
                        </div>

                        <div class="d-flex gap-2 justify-content-end">
                            <a href="@Url.Action("Index")" class="btn btn-secondary">Hủy bỏ</a>
                            <input type="submit" value="Cập nhật kho" class="btn btn-warning" onclick="return confirm('Hành động này sẽ thay đổi số lượng tồn kho và ghi lại nhật ký. Bạn có chắc chắn?')" />
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>