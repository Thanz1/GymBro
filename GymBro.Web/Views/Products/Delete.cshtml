@using GymBro.Contracts
@model ProductDto

@{
    ViewBag.Title = "Xóa Sản phẩm";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm border-top border-danger border-4 mt-5">
            <div class="card-body p-4 text-center">
                <i class="bi bi-exclamation-octagon display-4 text-danger mb-3"></i>
                <h3 class="fw-bold">Xác nhận xóa?</h3>
                <p class="text-muted">Bạn có chắc muốn xóa sản phẩm <strong>"@Model.ProductName"</strong>? Dữ liệu đơn hàng cũ liên quan có thể bị ảnh hưởng.[cite: 41]</p>

                <div class="bg-light p-3 rounded mb-4 text-start">
                    <p class="mb-1 small">Giá bán: <strong class="text-danger">@Model.Price.ToString("N0") ₫</strong></p>
                    <p class="mb-0 small">Danh mục: <strong>@Model.CategoryName</strong></p>
                </div>

                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(model => model.Id)
                    <div class="d-flex justify-content-center gap-3">
                        <button type="submit" class="btn btn-danger btn-lg px-5 shadow-sm">XÓA NGAY</button>
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-lg px-5">HỦY BỎ</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>