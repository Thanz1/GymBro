@using GymBro.Web.Helpers
@using GymBro.Contracts
@model CheckoutDto

@{
    ViewBag.Title = "Xác nhận Thanh toán";
    // Lấy UserDto từ Session thay vì Entity User
    var user = Context.Session.GetObject<UserDto>("User");
}

<div class="container py-4">
    <h2 class="fw-bold mb-4"><i class="bi bi-check2-square"></i> Xác nhận Đơn hàng</h2>

    <div class="row">
        <div class="col-md-7">
            <div class="card border-0 shadow-sm p-4 mb-4">
                <h5 class="fw-bold mb-3"><i class="bi bi-geo-alt"></i> Thông tin giao hàng</h5>
                @if (user != null)
                {
                    <p class="mb-1"><strong>Người nhận:</strong> @(user.FullName ?? user.Username)</p>
                    <p class="mb-1"><strong>Email:</strong> @user.Email</p>
                    <p class="mb-3"><strong>Địa chỉ:</strong> @(user.Address ?? "Chưa cập nhật")</p>
                }

                <form asp-action="PlaceOrder" asp-controller="Cart" method="post">
                    @Html.AntiForgeryToken()
                    <h5 class="fw-bold mb-3 mt-4 border-top pt-3">Phương thức thanh toán</h5>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="radio" name="paymentMethodId" id="cod" value="1" checked>
                        <label class="form-check-label" for="cod">Thanh toán khi nhận hàng (COD)</label>
                    </div>
                    <div class="form-check mb-4">
                        <input class="form-check-input" type="radio" name="paymentMethodId" id="bank" value="2">
                        <label class="form-check-label" for="bank">Chuyển khoản Ngân hàng (QR Code)</label>
                    </div>
                    <button type="submit" class="btn btn-success btn-lg w-100">XÁC NHẬN ĐẶT HÀNG</button>
                </form>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card border-0 shadow-sm p-4">
                <h5 class="fw-bold mb-3">Tóm tắt sản phẩm</h5>
                <ul class="list-group list-group-flush mb-3">
                    @foreach (var item in Model.CartItems)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <div>@item.ProductName <small class="text-muted">x @item.Quantity</small></div>
                            <span class="text-danger">@item.ThanhTien.ToString("N0") ₫</span>
                        </li>
                    }
                </ul>
                <div class="d-flex justify-content-between fw-bold fs-5">
                    <span>Tổng thanh toán:</span>
                    <span class="text-danger">@(((decimal)ViewBag.TotalPrice).ToString("N0")) ₫</span>
                </div>
            </div>
        </div>
    </div>
</div>