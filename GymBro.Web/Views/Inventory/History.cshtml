@model IEnumerable<GymBro.Core.InventoryTransaction>

@{
    ViewBag.Title = "Lịch sử biến động kho";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h4 class="mb-0 text-info"><i class="bi bi-clock-history"></i> Lịch sử biến động kho @(ViewBag.ProductName != null ? ": " + ViewBag.ProductName : "")</h4>
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Quay lại</a>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-bordered align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Thời gian</th>
                        <th>Sản phẩm</th>
                        <th>Loại giao dịch</th>
                        <th>Số lượng thay đổi</th>
                        <th>Tham chiếu</th>
                        <th>Ghi chú</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted">Chưa có lịch sử giao dịch nào.</td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.CreatedDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@(item.Product != null ? item.Product.ProductName : "SP đã xóa")</td>
                            <td>
                                @if (item.QuantityChange > 0)
                                {
                                    <span class="badge bg-success">@item.TransactionType</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">@item.TransactionType</span>
                                }
                            </td>
                            <td class="@(item.QuantityChange > 0 ? "text-success" : "text-danger") fw-bold text-center">
                                @(item.QuantityChange > 0 ? "+" : "")@item.QuantityChange
                            </td>
                            <td>
                                @* SỬA: RelatedOrderID -> OrderId *@
                                @if (item.OrderId.HasValue)
                                {
                                    <a href="@Url.Action("Details", "Orders", new { id = item.OrderId })">Đơn hàng #@item.OrderId</a>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }

                                @* Phần PurchaseOrder tạm thời ẩn vì chưa có Model tương ứng
                            @if (item.RelatedPurchaseOrderID.HasValue)
                            {
                                <a href="@Url.Action("Edit", "PurchaseOrders", new { id = item.RelatedPurchaseOrderID })">Phiếu nhập #@item.RelatedPurchaseOrderID</a>
                            } 
                            *@
                            </td>
                            <td>@item.Note</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>