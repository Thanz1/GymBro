@model GymBro.Web.Controllers.HomeIndexViewModel

@{
    ViewBag.Title = "Trang chủ";
}

<main>
    <section class="hero-banner mb-5">
        <img src="~/Content/Images/shopping.webp"
             class="hero-image"
             alt="GymBro Banner"
             onerror="this.onerror=null; this.src='https://via.placeholder.com/1600x700?text=GYMBRO';" />
        <div class="hero-overlay">
            <div class="text-center text-white hero-text px-4">
                <h1 class="hero-title">GYMBRO</h1>
                <p class="hero-subtitle">Thiết bị và phụ kiện tập luyện cho người chơi gym hiện đại</p>
                <a href="@Url.Action("Shop", "Home")" class="btn btn-light btn-lg rounded-pill mt-3 px-4">
                    Khám phá cửa hàng
                </a>
            </div>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle me-2"></i>@Model.ErrorMessage
        </div>
    }

    <section class="mb-5">
        <div class="row mb-4">
            <div class="col-12">
                <h2 class="text-gradient">
                    <i class="bi bi-star-fill text-warning"></i> Sản phẩm mới nhất
                </h2>
                <p class="text-muted mb-0">Những mẫu mới vừa lên kệ để bạn xem nhanh và đặt ngay.</p>
            </div>
        </div>

        <div class="row g-4">
            @if (Model.NewProducts.Count > 0)
            {
                foreach (var item in Model.NewProducts)
                {
                    <div class="col-md-3 col-sm-6">
                        @await Html.PartialAsync("_ProductCard", item)
                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <div class="alert alert-warning text-center">
                        <i class="bi bi-info-circle fs-4"></i>
                        <h5>Chưa có sản phẩm mới</h5>
                        <p class="mb-0">Vui lòng kiểm tra lại dữ liệu sản phẩm.</p>
                    </div>
                </div>
            }
        </div>
    </section>

    <section class="mb-5">
        <div class="row mb-4">
            <div class="col-12">
                <h2 class="text-gradient">
                    <i class="bi bi-fire text-warning"></i> Sản phẩm bán chạy
                </h2>
                <p class="text-muted mb-0">Danh sách đang được người dùng quan tâm nhiều nhất.</p>
            </div>
        </div>

        <div class="row g-4">
            @if (Model.BestSellingProducts.Count > 0)
            {
                foreach (var item in Model.BestSellingProducts)
                {
                    <div class="col-md-3 col-sm-6">
                        @await Html.PartialAsync("_ProductCard", item)
                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <div class="alert alert-warning text-center">
                        <i class="bi bi-info-circle fs-4"></i>
                        <h5>Chưa có sản phẩm bán chạy</h5>
                        <p class="mb-0">Vui lòng kiểm tra lại dữ liệu sản phẩm.</p>
                    </div>
                </div>
            }
        </div>
    </section>
</main>
