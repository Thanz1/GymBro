<tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>#@item.Id</td>
            <td>@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
            <td style="color: #d32f2f; font-weight: bold;">
                @string.Format("{0:N0}", item.TotalAmount) VNĐ
            </td>
            <td>
                @{
                    string badgeClass = "bg-secondary";

                    // Đồng bộ với các trạng thái được sử dụng trong hệ thống
                    if (item.Status == "Chờ xử lý" || item.Status == "Chờ thanh toán")
                    {
                        badgeClass = "bg-warning text-dark";
                    }
                    else if (item.Status == "Đã xác nhận")
                    {
                        badgeClass = "bg-primary";
                    }
                    else if (item.Status == "Đang giao")
                    {
                        badgeClass = "bg-info text-dark";
                    }
                    else if (item.Status == "Đã giao")
                    {
                        badgeClass = "bg-success";
                    }
                    else if (item.Status == "Đã hủy")
                    {
                        badgeClass = "bg-danger";
                    }
                }
                <span class="badge @badgeClass">@item.Status</span>
            </td>
            <td>
                @* 1. SỬA LINK XEM CHI TIẾT (Trỏ về Account thay vì Orders) *@
                <a href="@Url.Action("OrderDetails", "Account", new { id = item.Id })" class="btn btn-sm btn-outline-info">
                    <i class="bi bi-eye"></i> Xem
                </a>

                @* 2. THÊM NÚT THANH TOÁN (Nếu trạng thái là Chờ thanh toán) *@
                @if (item.Status == "Chờ thanh toán" || item.Status == "Chờ xử lý")
                {
                    <a href="@Url.Action("Payment", "Cart", new { id = item.Id })" class="btn btn-sm btn-danger ms-1">
                        <i class="bi bi-credit-card"></i> Thanh toán
                    </a>
                }
            </td>
        </tr>
    }
</tbody>