@using GymBro.Contracts
@model IEnumerable<OrderDetailDto>

@{
    ViewBag.Title = "Quản lý Chi tiết Đơn hàng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h2 class="mb-0 text-primary fw-bold"><i class="bi bi-list-check"></i> Quản lý Chi tiết</h2>
        <a href="@Url.Action("Create")" class="btn btn-success shadow-sm"><i class="bi bi-plus-lg"></i> Thêm mới</a>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover table-bordered align-middle">
                <thead class="table-light">
                    <tr>
                        <th class="text-center">Mã ĐH</th>
                        <th>Sản phẩm</th>
                        <th class="text-center">Số lượng</th>
                        <th>Đơn giá</th>
                        <th>Thành tiền</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center">
                                <a href="@Url.Action("Details", "Orders", new { id = item.OrderId })" class="fw-bold">#@item.OrderId</a>
                            </td>
                            <td>@item.ProductName</td>
                            <td class="text-center">@item.Quantity</td>
                            <td>@item.UnitPrice.ToString("N0") ₫</td>
                            <td class="fw-bold text-primary">@item.Total.ToString("N0") ₫</td>
                            <td class="text-center">
                                <div class="btn-group">
                                    <a href="@Url.Action("Edit", new { id = item.Id })" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                                    <a href="@Url.Action("Details", new { id = item.Id })" class="btn btn-sm btn-outline-info"><i class="bi bi-eye"></i></a>
                                    <a href="@Url.Action("Delete", new { id = item.Id })" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>