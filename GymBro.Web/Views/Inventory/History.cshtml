@using GymBro.Contracts
@model IEnumerable<InventoryTransactionDto>

@{
    ViewBag.Title = "Lịch sử kho";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h4 class="mb-0 text-info fw-bold">
            <i class="bi bi-clock-history"></i> Nhật ký biến động kho
            @(ViewBag.ProductName != null ? ": " + ViewBag.ProductName : "")
        </h4>
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm px-3"><i class="bi bi-arrow-left"></i> Quay lại</a>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover table-bordered align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Thời gian</th>
                        <th>Sản phẩm</th>
                        <th>Loại giao dịch</th>
                        <th class="text-center">Số lượng</th>
                        <th>Tham chiếu</th>
                        <th>Ghi chú</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">Chưa có giao dịch kho nào được ghi nhận.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="small">@item.CreatedDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="fw-bold">@item.ProductName</td>
                                <td>
                                    <span class="badge @(item.QuantityChange > 0 ? "bg-success" : "bg-warning text-dark")">
                                        @item.TransactionType
                                    </span>
                                </td>
                                <td class="@(item.QuantityChange > 0 ? "text-success" : "text-danger") fw-bold text-center fs-5">
                                    @(item.QuantityChange > 0 ? "+" : "")@item.QuantityChange
                                </td>
                                <td>
                                    @if (item.OrderId.HasValue)
                                    {
                                        <a href="@Url.Action("Details", "Orders", new { id = item.OrderId })" class="text-decoration-none">
                                            <i class="bi bi-receipt"></i> Đơn hàng #@item.OrderId
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="small text-muted">@item.Note</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>