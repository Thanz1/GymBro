@{
    ViewBag.Title = "Liên hệ";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="fw-bold text-primary">Liên hệ với chúng tôi</h1>
        <p class="text-muted">Chúng tôi luôn sẵn sàng lắng nghe bạn</p>
    </div>

    <div class="row g-4">
        <div class="col-md-5">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <h4 class="fw-bold mb-4">Thông tin liên hệ</h4>

                    <div class="d-flex mb-4">
                        <div class="bg-light rounded-circle p-3 me-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                            <i class="bi bi-geo-alt text-primary fs-5"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-1">Địa chỉ</h6>
                            <p class="text-muted small mb-0">123 Đường ABC, Quận XYZ, TP.HCM</p>
                        </div>
                    </div>

                    <div class="d-flex mb-4">
                        <div class="bg-light rounded-circle p-3 me-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                            <i class="bi bi-telephone text-success fs-5"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-1">Điện thoại</h6>
                            <p class="text-muted small mb-0">0123 456 789</p>
                        </div>
                    </div>

                    <div class="d-flex">
                        <div class="bg-light rounded-circle p-3 me-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                            <i class="bi bi-envelope text-danger fs-5"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-1">Email</h6>
                            <p class="text-muted small mb-0">contact@gymbro.com</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-7">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <h4 class="fw-bold mb-4">Gửi tin nhắn</h4>
                    <form>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Họ tên</label>
                                <input type="text" class="form-control" placeholder="Nhập họ tên của bạn">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Email</label>
                                <input type="email" class="form-control" placeholder="Nhập email của bạn">
                            </div>
                            <div class="col-12">
                                <label class="form-label">Nội dung</label>
                                <textarea class="form-control" rows="5" placeholder="Bạn cần hỗ trợ gì?"></textarea>
                            </div>
                            <div class="col-12">
                                <button type="button" class="btn btn-primary px-4" onclick="alert('Cảm ơn bạn đã liên hệ! Chúng tôi sẽ phản hồi sớm nhất.')">Gửi tin nhắn</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>