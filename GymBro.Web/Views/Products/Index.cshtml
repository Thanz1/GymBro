@using GymBro.Contracts
@model IEnumerable<ProductDto>

@{
    ViewBag.Title = "Quản lý Sản phẩm";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h2 class="mb-0 text-primary fw-bold"><i class="bi bi-box-seam"></i> Quản lý Sản phẩm</h2>
        <a href="@Url.Action("Create")" class="btn btn-success shadow-sm"><i class="bi bi-plus-lg"></i> Thêm sản phẩm</a>
    </div>
    <div class="card-body">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="row mb-4 align-items-end">
            <div class="col-md-9">
                <form asp-action="Index" method="get" class="row g-2">
                    <div class="col-auto">
                        <input type="text" name="searchString" value="@ViewBag.CurrentSearch" class="form-control" placeholder="Tìm theo tên..." />
                    </div>
                    <div class="col-auto">
                        @if (ViewBag.Categories != null)
                        {
                            @Html.DropDownList("categoryId", (SelectList)ViewBag.Categories, "Tất cả danh mục", new { @class = "form-select", onchange = "this.form.submit();" })
                        }
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-primary px-3">Tìm kiếm</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover table-bordered align-middle">
                <thead class="table-light">
                    <tr>
                        <th style="width: 80px;">Ảnh</th>
                        <th>Tên sản phẩm</th>
                        <th>Danh mục</th>
                        <th>Giá bán</th>
                        <th class="text-center">Tồn kho</th>
                        <th class="text-center" style="width: 150px;">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center">
                                <img src="~/Content/Images/@(string.IsNullOrEmpty(item.ImageURL) ? "no-image.png" : item.ImageURL)"
                                     class="img-thumbnail" style="width: 60px; height: 60px; object-fit: cover;"
                                     onerror="this.src='/Content/Images/no-image.png'" />
                            </td>
                            <td>
                                <div class="fw-bold">@item.ProductName</div>
                                <small class="text-muted">ID: #@item.Id</small>
                            </td>
                            <td>@(item.CategoryName ?? "N/A")</td>
                            <td class="fw-bold text-danger">@item.Price.ToString("N0") ₫</td>
                            <td class="text-center">
                                <span class="badge @(item.StockQuantity <= 5 ? "bg-danger" : "bg-success") rounded-pill px-3">
                                    @item.StockQuantity
                                </span>
                            </td>
                            <td class="text-center">
                                <div class="btn-group">
                                    <a href="@Url.Action("Edit", new { id = item.Id })" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                                    <a href="@Url.Action("Details", new { id = item.Id })" class="btn btn-sm btn-outline-info"><i class="bi bi-eye"></i></a>
                                    <a href="@Url.Action("Delete", new { id = item.Id })" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>