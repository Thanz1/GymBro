@using GymBro.Contracts
@model IEnumerable<CategoryDto>

@if (Model != null && Model.Any())
{
    foreach (var item in Model)
    {
        <li>
            @* Sử dụng thuộc tính Id thay vì CategoryID cho đồng bộ[cite: 46] *@
            <a href="@Url.Action("Shop", "Home", new { categoryId = item.Id })" class="dropdown-item py-2">
                <i class="bi bi-tag me-2 small text-muted"></i> @item.CategoryName
            </a>
        </li>
    }
}
else
{
    <li><a class="dropdown-item disabled text-muted">Chưa có danh mục</a></li>
}