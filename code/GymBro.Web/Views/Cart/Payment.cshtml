@model CartPaymentViewModel

@{
    ViewBag.Title = "Thanh toán đơn hàng #" + Model.Order.Id;

    var paymentStatus = Model.PaymentStatus;
    var timeRemaining = TimeSpan.FromHours(24) - (DateTime.Now - Model.Order.OrderDate);
    var isAwaitingTransfer = PaymentStatus.Equals(paymentStatus, PaymentStatus.AwaitingPayment);
    var isPendingVerification = PaymentStatus.Equals(paymentStatus, PaymentStatus.PendingVerification);
    var isPaid = PaymentStatus.IsPaid(paymentStatus);
    var isCashCollectionPending = PaymentStatus.Equals(paymentStatus, PaymentStatus.CashCollectionPending);
    var isFailed = PaymentStatus.Equals(paymentStatus, PaymentStatus.Failed);
    var isCancelled = PaymentStatus.Equals(paymentStatus, PaymentStatus.Cancelled);
    var isExpired = isAwaitingTransfer && timeRemaining.TotalMinutes <= 0;
    var isExpiringSoon = isAwaitingTransfer && !isExpired && timeRemaining.TotalHours < 2;
    var hoursLeft = timeRemaining.TotalHours > 0 ? (int)timeRemaining.TotalHours : 0;
    var minutesLeft = timeRemaining.TotalMinutes > 0 ? timeRemaining.Minutes : 0;

    var headerClass = isPaid
        ? "bg-success"
        : isPendingVerification
            ? "bg-info"
            : isFailed || isCancelled
                ? "bg-danger"
                : isCashCollectionPending
                    ? "bg-secondary"
                    : "bg-primary";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-9">
            @if (!string.IsNullOrWhiteSpace(Model.NoticeMessage))
            {
                <div class="alert @(Model.IsWarning ? "alert-warning" : "alert-info") mb-4">
                    @Model.NoticeMessage
                </div>
            }

            @if (isAwaitingTransfer && isExpired)
            {
                <div class="alert alert-danger text-center mb-4">
                    <h5><i class="bi bi-exclamation-triangle-fill"></i> Đơn hàng đã hết hạn thanh toán</h5>
                    <p class="mb-0">Đơn hàng này đã quá thời gian thanh toán 24 giờ và đã được chuyển sang trạng thái hủy.</p>
                </div>
            }
            else if (isExpiringSoon)
            {
                <div class="alert alert-warning text-center mb-4">
                    <h5><i class="bi bi-clock-fill"></i> Sắp hết hạn thanh toán</h5>
                    <p class="mb-0">Còn <strong>@hoursLeft giờ @minutesLeft phút</strong> để hoàn tất chuyển khoản.</p>
                </div>
            }
            else if (isAwaitingTransfer)
            {
                <div class="alert alert-info text-center mb-4">
                    <i class="bi bi-clock"></i> Thời gian còn lại để thanh toán: <strong>@hoursLeft giờ @minutesLeft phút</strong>
                </div>
            }

            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-header @headerClass text-white text-center py-3">
                    <h3 class="mb-0 fw-bold">
                        <i class="bi @(isCashCollectionPending ? "bi-cash-coin" : "bi-qr-code-scan")"></i>
                        @(isCashCollectionPending ? "Thông tin thanh toán COD" : "Thanh toán qua mã QR")
                    </h3>
                    <p class="mb-0 opacity-75">Đơn hàng #@Model.Order.Id | Ngày đặt: @Model.Order.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
                    <span class="badge bg-light text-dark mt-2">@paymentStatus</span>
                </div>
                <div class="card-body p-4">
                    <div class="row align-items-center">
                        <div class="col-md-6 text-center mb-4 mb-md-0 border-end">
                            @if (isCashCollectionPending)
                            {
                                <div class="bg-light p-4 rounded d-inline-block shadow-sm">
                                    <i class="bi bi-cash-stack" style="font-size: 5rem; color: #198754;"></i>
                                    <div class="mt-3 fw-semibold">Thanh toán khi nhận hàng</div>
                                </div>
                                <p class="mt-3 text-muted small">
                                    Nhân viên sẽ thu tiền khi đơn hàng được giao tới bạn.
                                </p>
                            }
                            else
                            {
                                <div class="bg-light p-3 rounded d-inline-block shadow-sm">
                                    <img src="@Model.QrImage" alt="Mã QR thanh toán" class="img-fluid" style="max-width: 100%; height: auto; min-width: 250px;" />
                                </div>
                                <p class="mt-3 text-muted small">
                                    <i class="bi bi-info-circle"></i> Dùng app ngân hàng hoặc ví hỗ trợ QR để quét mã.
                                </p>
                            }
                        </div>

                        <div class="col-md-6 ps-md-4">
                            @if (!isCashCollectionPending)
                            {
                                <h5 class="text-primary mb-3 fw-bold">Thông tin chuyển khoản</h5>

                                <div class="mb-3">
                                    <label class="text-muted small">Ngân hàng</label>
                                    <div class="d-flex justify-content-between align-items-center p-2 bg-light rounded border">
                                        <span class="fw-bold">@Model.BankId</span>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="text-muted small">Số tài khoản</label>
                                    <div class="d-flex justify-content-between align-items-center p-2 bg-light rounded border">
                                        <span class="fw-bold text-danger fs-5" id="accountNo">@Model.AccountNo</span>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="copyToClipboard('accountNo')">
                                            <i class="bi bi-clipboard"></i> Sao chép
                                        </button>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="text-muted small">Chủ tài khoản</label>
                                    <div class="d-flex justify-content-between align-items-center p-2 bg-light rounded border">
                                        <span class="fw-bold">@Model.AccountName</span>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="text-muted small">Số tiền</label>
                                    <div class="d-flex justify-content-between align-items-center p-2 bg-light rounded border">
                                        <span class="fw-bold text-primary fs-5" id="amount">@Model.Order.TotalAmount.ToString("N0") đ</span>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="copyToClipboard('amountValue')">
                                            <i class="bi bi-clipboard"></i> Sao chép
                                        </button>
                                        <span id="amountValue" class="d-none">@(((int)Model.Order.TotalAmount).ToString())</span>
                                    </div>
                                </div>

                                <div class="mb-4">
                                    <label class="text-muted small">Nội dung chuyển khoản <span class="text-danger">*Bắt buộc</span></label>
                                    <div class="d-flex justify-content-between align-items-center p-2 bg-warning bg-opacity-10 rounded border border-warning">
                                        <span class="fw-bold text-dark" id="content">@Model.Description</span>
                                        <button type="button" class="btn btn-sm btn-outline-warning text-dark" onclick="copyToClipboard('content')">
                                            <i class="bi bi-clipboard"></i> Sao chép
                                        </button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <h5 class="text-primary mb-3 fw-bold">Thông tin đơn COD</h5>
                                <div class="mb-3">
                                    <label class="text-muted small">Số tiền cần thu</label>
                                    <div class="p-2 bg-light rounded border fw-bold text-primary fs-5">
                                        @Model.Order.TotalAmount.ToString("N0") đ
                                    </div>
                                </div>
                                <div class="alert alert-info">
                                    <i class="bi bi-info-circle"></i> Đơn hàng này không cần xác nhận chuyển khoản. Bạn chỉ cần chờ giao hàng.
                                </div>
                            }

                            <hr />

                            @if (isAwaitingTransfer)
                            {
                                if (!isExpired)
                                {
                                    <div class="alert alert-warning mb-3">
                                        <small>
                                            <i class="bi bi-exclamation-circle"></i>
                                            Chỉ bấm xác nhận sau khi bạn đã chuyển tiền đúng số tiền và đúng nội dung.
                                        </small>
                                    </div>
                                    <div class="d-grid gap-2">
                                        @using (Html.BeginForm("ConfirmPayment", "Cart", FormMethod.Post, new { id = "confirmPaymentForm" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@Model.Order.Id" />
                                            <button type="submit" class="btn btn-success btn-lg w-100"
                                                    onclick="return confirm('Bạn xác nhận đã chuyển khoản đúng số tiền và nội dung?');">
                                                <i class="bi bi-check-circle-fill"></i> Tôi đã chuyển khoản xong
                                            </button>
                                        }
                                        <a href="@Url.Action("OrderDetails", "Account", new { id = Model.Order.Id })" class="btn btn-outline-primary">
                                            <i class="bi bi-receipt"></i> Xem chi tiết đơn hàng
                                        </a>
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-danger">
                                        Đơn hàng đã hết hạn thanh toán. Bạn có thể quay lại lịch sử đơn hàng để kiểm tra trạng thái mới nhất.
                                    </div>
                                    <div class="d-grid gap-2">
                                        <a href="@Url.Action("OrderHistory", "Account")" class="btn btn-outline-danger">Về lịch sử đơn hàng</a>
                                    </div>
                                }
                            }
                            else if (isPendingVerification)
                            {
                                <div class="alert alert-info">
                                    <h5><i class="bi bi-clock-history"></i> Đang chờ xác minh</h5>
                                    <p class="mb-0">Bạn đã xác nhận thanh toán. Admin đang kiểm tra giao dịch của bạn.</p>
                                </div>
                                <div class="d-grid gap-2">
                                    <a href="@Url.Action("OrderDetails", "Account", new { id = Model.Order.Id })" class="btn btn-primary">Xem chi tiết đơn hàng</a>
                                    <a href="@Url.Action("OrderHistory", "Account")" class="btn btn-outline-secondary">Về lịch sử đơn hàng</a>
                                </div>
                            }
                            else if (isPaid)
                            {
                                <div class="alert alert-success">
                                    <h5><i class="bi bi-check-circle-fill"></i> Thanh toán đã được duyệt</h5>
                                    <p class="mb-0">Đơn hàng của bạn đã được xác nhận thanh toán và đang chuyển sang xử lý.</p>
                                </div>
                                <div class="d-grid gap-2">
                                    <a href="@Url.Action("OrderDetails", "Account", new { id = Model.Order.Id })" class="btn btn-success">Xem chi tiết đơn hàng</a>
                                    <a href="@Url.Action("OrderHistory", "Account")" class="btn btn-outline-secondary">Về lịch sử đơn hàng</a>
                                </div>
                            }
                            else if (isFailed || isCancelled)
                            {
                                <div class="alert alert-danger">
                                    <h5><i class="bi bi-x-circle-fill"></i> Thanh toán không thành công</h5>
                                    <p class="mb-0">Đơn hàng này đã bị hủy hoặc thanh toán bị từ chối. Vui lòng liên hệ hỗ trợ nếu cần.</p>
                                </div>
                                <div class="d-grid gap-2">
                                    <a href="@Url.Action("OrderDetails", "Account", new { id = Model.Order.Id })" class="btn btn-outline-danger">Xem chi tiết đơn hàng</a>
                                    <a href="@Url.Action("Shop", "Home")" class="btn btn-outline-primary">Mua sắm lại</a>
                                </div>
                            }
                            else if (isCashCollectionPending)
                            {
                                <div class="d-grid gap-2">
                                    <a href="@Url.Action("OrderDetails", "Account", new { id = Model.Order.Id })" class="btn btn-primary">Xem chi tiết đơn hàng</a>
                                    <a href="@Url.Action("Shop", "Home")" class="btn btn-outline-secondary">Tiếp tục mua sắm</a>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-secondary">
                                    Trạng thái hiện tại: <strong>@paymentStatus</strong>
                                </div>
                                <div class="d-grid">
                                    <a href="@Url.Action("OrderHistory", "Account")" class="btn btn-outline-secondary">Về lịch sử đơn hàng</a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-light text-center py-3">
                    <small class="text-muted">
                        @if (isAwaitingTransfer)
                        {
                            <span><i class="bi bi-shield-check"></i> Đơn hàng giữ hiệu lực thanh toán trong <strong>24 giờ</strong> kể từ lúc đặt.</span>
                        }
                        else if (isPendingVerification)
                        {
                            <span><i class="bi bi-clock-history"></i> Sau khi bạn xác nhận chuyển khoản, admin sẽ kiểm tra và cập nhật trạng thái cho đơn hàng.</span>
                        }
                        else
                        {
                            <span><i class="bi bi-receipt"></i> Bạn có thể theo dõi toàn bộ tiến trình ở mục lịch sử đơn hàng.</span>
                        }
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    async function copyToClipboard(elementId) {
        const element = document.getElementById(elementId);
        if (!element) {
            return;
        }

        const value = element.innerText.trim();
        if (!value) {
            return;
        }

        try {
            await navigator.clipboard.writeText(value);
        } catch (error) {
            const textArea = document.createElement('textarea');
            textArea.value = value;
            textArea.style.position = 'fixed';
            textArea.style.left = '-9999px';
            document.body.appendChild(textArea);
            textArea.focus();
            textArea.select();
            document.execCommand('copy');
            document.body.removeChild(textArea);
        }
    }
</script>
