@model IEnumerable<GymBro.Core.Order>

@{
    ViewBag.Title = "Quản lý Đơn hàng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3">
        <h2 class="mb-0 text-primary"><i class="bi bi-receipt"></i> Quản lý Đơn hàng</h2>
    </div>
    <div class="card-body">
        @* Hiển thị thông báo *@
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="row mb-4 align-items-end">
            <div class="col-md-10">
                <form action="@Url.Action("Index")" method="get" class="row g-2">
                    <div class="col-auto">
                        <input type="text" name="searchString" value="@ViewBag.CurrentSearch" class="form-control" placeholder="Tìm theo Mã ĐH, Tên user..." style="width: 250px;" />
                    </div>
                    <div class="col-auto">
                        @Html.DropDownList("status", (SelectList)ViewBag.StatusList, "Tất cả trạng thái", new { @class = "form-select", onchange = "this.form.submit();" })
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i> Tìm kiếm</button>
                        @if (!string.IsNullOrEmpty(ViewBag.CurrentSearch as string) || !string.IsNullOrEmpty(ViewBag.CurrentStatus as string))
                        {
                            <a href="@Url.Action("Index")" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i> Xóa lọc</a>
                        }
                    </div>
                </form>
            </div>
            <div class="col-md-2 text-end">
                <a href="@Url.Action("Create")" class="btn btn-success"><i class="bi bi-plus-lg"></i> Tạo đơn</a>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover table-bordered align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Mã ĐH</th>
                        <th>Ngày đặt hàng</th>
                        <th>Khách hàng</th>
                        <th>Tổng tiền</th>
                        <th>Trạng thái</th>
                        <th class="text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">Không tìm thấy đơn hàng nào.</td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            @* SỬA: OrderID -> Id *@
                            <td class="fw-bold text-primary">#@item.Id</td>
                            <td>
                                @item.OrderDate.ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="avatar-sm bg-light rounded-circle me-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                        <i class="bi bi-person text-secondary"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold">@(item.User != null ? item.User.FullName : "Unknown")</div>
                                        <small class="text-muted">@(item.User != null ? item.User.Username : "")</small>
                                    </div>
                                </div>
                            </td>
                            <td class="fw-bold">
                                @string.Format("{0:N0}", item.TotalAmount) ₫
                            </td>
                            <td>
                                @if (item.Status == "Chờ xử lý")
                                {
                                    <span class="badge bg-warning bg-opacity-10 text-warning border border-warning rounded-pill px-3">@item.Status</span>
                                }
                                else if (item.Status == "Đã hủy")
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger rounded-pill px-3">@item.Status</span>
                                }
                                else if (item.Status == "Đã giao hàng")
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success rounded-pill px-3">@item.Status</span>
                                }
                                else
                                {
                                    <span class="badge bg-info bg-opacity-10 text-info border border-info rounded-pill px-3">@item.Status</span>
                                }
                            </td>
                            <td class="text-center">
                                @* SỬA: OrderID -> Id *@
                                <a href="@Url.Action("Details", new { id = item.Id })" class="btn btn-sm btn-info me-1" title="Chi tiết"><i class="bi bi-eye"></i></a>
                                <a href="@Url.Action("Edit", new { id = item.Id })" class="btn btn-sm btn-primary me-1" title="Cập nhật"><i class="bi bi-pencil"></i></a>
                                <a href="@Url.Action("Delete", new { id = item.Id })" class="btn btn-sm btn-danger" title="Xóa"><i class="bi bi-trash"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* Phân trang *@
        @if (ViewBag.TotalPages != null && ViewBag.TotalPages > 1)
        {
            <nav aria-label="Page navigation" class="mt-4">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(ViewBag.PageNumber <= 1 ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { page = ViewBag.PageNumber - 1, searchString = ViewBag.CurrentSearch, status = ViewBag.CurrentStatus })">Trước</a>
                    </li>

                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(ViewBag.PageNumber == i ? "active" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { page = i, searchString = ViewBag.CurrentSearch, status = ViewBag.CurrentStatus })">@i</a>
                        </li>
                    }

                    <li class="page-item @(ViewBag.PageNumber >= ViewBag.TotalPages ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { page = ViewBag.PageNumber + 1, searchString = ViewBag.CurrentSearch, status = ViewBag.CurrentStatus })">Sau</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>