@model GymBro.Core.User

@{
    ViewBag.Title = "Xóa Người dùng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm mt-4">
            <div class="card-header bg-danger text-white py-3">
                <h4 class="mb-0"><i class="bi bi-exclamation-triangle"></i> Xác nhận xóa</h4>
            </div>
            <div class="card-body">
                <div class="alert alert-warning border-warning">
                    <strong>Cảnh báo:</strong> Bạn có chắc chắn muốn xóa tài khoản này? Hành động này không thể hoàn tác.
                </div>

                <div class="mb-4 text-center">
                    <div class="avatar bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                        <i class="bi bi-person-x text-danger" style="font-size: 40px;"></i>
                    </div>
                    <h5 class="mb-1">@Model.Username</h5>
                    <p class="text-muted">@Model.Email</p>
                </div>

                <dl class="row mb-4 px-3">
                    <dt class="col-sm-4 text-end">Họ tên:</dt>
                    <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.FullName) ? "---" : Model.FullName)</dd>

                    <dt class="col-sm-4 text-end">Vai trò:</dt>
                    <dd class="col-sm-8">@Model.Role</dd>
                </dl>

                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    <div class="d-flex justify-content-center gap-3">
                        <a href="@Url.Action("Index")" class="btn btn-secondary">Hủy bỏ</a>
                        <button type="submit" class="btn btn-danger">Xác nhận Xóa</button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>