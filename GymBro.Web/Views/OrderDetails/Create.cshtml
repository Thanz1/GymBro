@using GymBro.Contracts
@model OrderDetailDto

@{
    ViewBag.Title = "Thêm Chi tiết mới";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h4 class="mb-0 text-success fw-bold">Thêm Chi tiết Đơn hàng</h4>
            </div>
            <div class="card-body p-4">
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label fw-bold">Mã Đơn hàng (ID)</label>
                        @Html.DropDownList("OrderId", null, htmlAttributes: new { @class = "form-select" })
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Sản phẩm</label>
                        @Html.DropDownList("ProductId", null, htmlAttributes: new { @class = "form-select" })
                    </div>
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label fw-bold">Số lượng</label>
                            @Html.EditorFor(model => model.Quantity, new { htmlAttributes = new { @class = "form-control", type = "number", min = "1" } })
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label fw-bold">Giá bán</label>
                            @Html.EditorFor(model => model.UnitPrice, new { htmlAttributes = new { @class = "form-control", type = "number" } })
                        </div>
                    </div>
                    <div class="d-flex gap-2 mt-3">
                        <button type="submit" class="btn btn-success px-4">Tạo mới</button>
                        <a href="@Url.Action("Index")" class="btn btn-secondary px-4">Hủy</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>