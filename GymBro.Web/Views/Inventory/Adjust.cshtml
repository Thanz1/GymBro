@using GymBro.Contracts
@model ProductDto

@{
    ViewBag.Title = "Điều chỉnh kho";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-warning text-dark py-3">
                <h4 class="mb-0 fw-bold"><i class="bi bi-pencil-square"></i> Kiểm kê kho: @Model.ProductName</h4>
            </div>
            <div class="card-body p-4">
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(model => model.Id)

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger"><i class="bi bi-exclamation-circle"></i> @TempData["Error"]</div>
                    }

                    <div class="mb-4">
                        <label class="form-label text-muted small text-uppercase">Số lượng hiện tại trên hệ thống</label>
                        <div class="form-control bg-light fw-bold fs-4">@Model.StockQuantity</div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">Số lượng thực tế (Mới) <span class="text-danger">*</span></label>
                        <input type="number" name="NewQuantity" class="form-control form-control-lg border-warning" value="@Model.StockQuantity" required min="0" />
                        <div class="form-text">Nhập chính xác số lượng bạn vừa đếm được trong kho.</div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">Lý do điều chỉnh</label>
                        <textarea name="Note" class="form-control" rows="3" placeholder="Ví dụ: Cập nhật sau khi kiểm kê tháng 5, hàng bị hỏng..."></textarea>
                    </div>

                    <div class="d-flex gap-2 justify-content-end border-top pt-3">
                        <a href="@Url.Action("Index")" class="btn btn-secondary px-4">Quay lại</a>
                        <button type="submit" class="btn btn-warning px-4 fw-bold" onclick="return confirm('Hệ thống sẽ cập nhật số lượng và ghi lại lịch sử. Bạn xác nhận?')">
                            CẬP NHẬT KHO
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>