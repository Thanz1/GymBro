@using GymBro.Contracts
@model UserDto

@{
    ViewBag.Title = "Chi tiết Người dùng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3 text-info fw-bold">
                <h4 class="mb-0">Hồ sơ người dùng</h4>
            </div>
            <div class="card-body p-4">
                <table class="table table-bordered">
                    <tr>
                        <th class="bg-light w-40">Tên đăng nhập</th>
                        <td class="fw-bold">@Model.Username</td>[cite: 52]
                    </tr>
                    <tr>
                        <th class="bg-light">Họ và tên</th>
                        <td>@(Model.FullName ?? "Chưa cập nhật")</td>[cite: 52]
                    </tr>
                    <tr>
                        <th class="bg-light">Email</th>
                        <td class="text-primary">@Model.Email</td>[cite: 52]
                    </tr>
                    <tr>
                        <th class="bg-light">Vai trò</th>
                        <td>
                            <span class="badge @(Model.Role == "Admin" ? "bg-danger" : "bg-info text-dark")">
                                @(Model.Role == "Admin" ? "Quản trị viên" : "Người dùng")
                            </span>[cite: 52]
                        </td>
                    </tr>
                    <tr>
                        <th class="bg-light">Ngày gia nhập</th>
                        <td>@Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")</td>[cite: 52]
                    </tr>
                </table>

                <div class="mt-4 d-flex gap-2">
                    <a href="@Url.Action("Edit", new { id = Model.Id })" class="btn btn-primary"><i class="bi bi-pencil"></i> Chỉnh sửa</a>[cite: 52]
                    <a href="@Url.Action("Index")" class="btn btn-secondary">Quay lại</a>[cite: 52]
                </div>
            </div>
        </div>
    </div>
</div>