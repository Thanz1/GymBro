@model GymBro.Core.Product

@{
    ViewBag.Title = "Chỉnh sửa Sản phẩm";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-10">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h3 class="mb-0 text-primary"><i class="bi bi-pencil-square"></i> Chỉnh sửa Sản phẩm</h3>
            </div>
            <div class="card-body">
                @using (Html.BeginForm("Edit", "Products", FormMethod.Post, new { enctype = "multipart/form-data" }))
                {
                    @Html.AntiForgeryToken()
                    @* SỬA: ProductID -> Id *@
                    @Html.HiddenFor(model => model.Id)
                    @* Giữ lại tên ảnh cũ nếu không upload ảnh mới *@
                    @Html.HiddenFor(model => model.ImageURL)

                    <div class="form-horizontal">
                        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                        <div class="row">
                            <div class="col-md-8">
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Tên sản phẩm <span class="text-danger">*</span></label>
                                    @Html.EditorFor(model => model.ProductName, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.ProductName, "", new { @class = "text-danger" })
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold">Giá bán (VNĐ)</label>
                                        @Html.EditorFor(model => model.Price, new { htmlAttributes = new { @class = "form-control", type = "number", min = "0", step = "1000" } })
                                        @Html.ValidationMessageFor(model => model.Price, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold">Số lượng tồn</label>
                                        @Html.EditorFor(model => model.StockQuantity, new { htmlAttributes = new { @class = "form-control", type = "number", min = "0" } })
                                        @Html.ValidationMessageFor(model => model.StockQuantity, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-bold">Danh mục</label>
                                    @* SỬA: CategoryID -> CategoryId *@
                                    @Html.DropDownList("CategoryId", null, htmlAttributes: new { @class = "form-control form-select" })
                                    @Html.ValidationMessageFor(model => model.CategoryId, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="card">
                                    <div class="card-header bg-light">Hình ảnh sản phẩm</div>
                                    <div class="card-body text-center">
                                        @* Hiển thị ảnh cũ nếu có *@
                                        @{
                                            var imgSrc = string.IsNullOrEmpty(Model.ImageURL) ? "/Content/Images/shopping.webp" : "/Content/Images/" + Model.ImageURL;
                                        }
                                        <img id="preview" src="@imgSrc" class="img-fluid mb-3" style="max-height: 200px; object-fit: contain;" onerror="this.src='/Content/Images/shopping.webp'" />

                                        <input type="file" name="imageFile" class="form-control" onchange="previewImage(this)" accept="image/*" />
                                        <small class="text-muted">Chọn ảnh mới để thay thế (nếu cần)</small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3 mt-3">
                            <label class="form-label fw-bold">Mô tả chi tiết</label>
                            @Html.TextAreaFor(model => model.Description, new { @class = "form-control", id = "Description" })
                            @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <a href="@Url.Action("Index")" class="btn btn-secondary">Hủy bỏ</a>
                            <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Cập nhật</button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="https://cdn.ckeditor.com/4.16.2/standard/ckeditor.js"></script>
    <script>
        CKEDITOR.replace('Description');

        function previewImage(input) {
            var preview = document.getElementById('preview');
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    preview.src = e.target.result;
                }
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}
