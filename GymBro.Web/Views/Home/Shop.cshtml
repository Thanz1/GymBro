@using GymBro.Contracts
@model IEnumerable<ProductDto>

@{
    ViewBag.Title = "Cửa hàng";
}

<div class="container py-4">
    <div class="row">
        @* Sidebar lọc (Thành có thể mở rộng thêm các Category tại đây) *@
        <div class="col-lg-3">
            <div class="card border-0 shadow-sm p-3 mb-4">
                <h5 class="fw-bold mb-3"><i class="bi bi-funnel"></i> Bộ lọc</h5>
                <div class="list-group list-group-flush">
                    <a href="@Url.Action("Shop")" class="list-group-item list-group-item-action border-0 px-0">Tất cả sản phẩm</a>
                </div>
            </div>
        </div>

        @* Danh sách sản phẩm *@
        <div class="col-lg-9">
            <div class="row g-4">
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <div class="col-md-4 col-sm-6">
                            <div class="card h-100 border-0 shadow-sm product-card">
                                <a href="@Url.Action("Details", "Home", new { id = item.Id })">
                                    <img src="~/Content/Images/@item.ImageURL" class="card-img-top p-2" style="height: 200px; object-fit: contain;" onerror="this.src='/Content/Images/no-image.png'" />
                                </a>
                                <div class="card-body">
                                    <h6 class="fw-bold text-dark text-truncate">@item.ProductName</h6>
                                    <p class="text-danger fw-bold mb-0">@item.Price.ToString("N0") ₫</p>
                                    <a href="@Url.Action("Details", "Home", new { id = item.Id })" class="btn btn-primary btn-sm w-100 mt-3">Xem chi tiết</a>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="bi bi-search display-1 text-muted"></i>
                        <p class="mt-3 fs-5">Không tìm thấy sản phẩm nào.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>