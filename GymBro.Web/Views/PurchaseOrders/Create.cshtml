@using GymBro.Contracts
@model PurchaseOrderDto

@{
    ViewBag.Title = "Tạo Phiếu nhập kho";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h4 class="mb-0 text-primary fw-bold">Bước 1: Thông tin chung</h4>
            </div>
            <div class="card-body p-4">
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    <div class="alert alert-info small">
                        <i class="bi bi-info-circle"></i> Sau khi nhấn "Tiếp tục", bạn sẽ được chuyển sang màn hình thêm sản phẩm chi tiết[cite: 44].
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Nhà cung cấp <span class="text-danger">*</span></label>
                        @Html.DropDownList("SupplierId", null, "--- Chọn nhà cung cấp ---", new { @class = "form-select border-primary" })
                        @Html.ValidationMessageFor(model => model.SupplierId, "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">Ngày lập phiếu</label>
                        <input asp-for="OrderDate" class="form-control" type="datetime-local" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary w-100 fw-bold">TIẾP TỤC (THÊM SẢN PHẨM)</button>
                        <a href="@Url.Action("Index")" class="btn btn-secondary px-4">HỦY</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>