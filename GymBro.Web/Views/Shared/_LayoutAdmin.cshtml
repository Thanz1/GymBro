@using GymBro.Contracts

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - GYMBRO ADMIN</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        .sidebar {
            min-height: 100vh;
            background: #2c3e50;
            color: white;
            width: 250px;
        }

            .sidebar .nav-link {
                color: rgba(255,255,255,0.7);
            }

                .sidebar .nav-link:hover, .sidebar .nav-link.active {
                    color: white;
                    background: #34495e;
                }
    </style>
</head>
<body>
    <div class="d-flex">
        @* Sidebar Menu *@
        <div class="sidebar p-3">
            <a href="@Url.Action("Index", "Home")" class="text-white text-decoration-none fs-4 fw-bold">GYMBRO ADMIN</a>
            <hr>
            <ul class="nav nav-pills flex-column">
                <li class="nav-item"><a href="@Url.Action("Index", "Orders")" class="nav-link"><i class="bi bi-receipt"></i> Đơn hàng</a></li>
                <li class="nav-item">
                    <a href="@Url.Action("Index", "Payments")" class="nav-link">
                        <i class="bi bi-credit-card"></i> Thanh toán
                        @* SỬA: Không dùng _context ở đây nữa, dùng ViewBag truyền từ Controller *@
                        @if (ViewBag.PendingPaymentCount != null && ViewBag.PendingPaymentCount > 0)
                        {
                            <span class="badge bg-warning text-dark ms-2">@ViewBag.PendingPaymentCount</span>
                        }
                    </a>
                </li>
                <li class="nav-item"><a href="@Url.Action("Index", "Inventory")" class="nav-link"><i class="bi bi-boxes"></i> Tồn kho</a></li>
                <li class="nav-item"><a href="@Url.Action("Index", "Products")" class="nav-link"><i class="bi bi-box-seam"></i> Sản phẩm</a></li>
                <li class="nav-item"><a href="@Url.Action("Index", "Categories")" class="nav-link"><i class="bi bi-tags"></i> Danh mục</a></li>
            </ul>
        </div>

        @* Content *@
        <div class="flex-grow-1 bg-light">
            <nav class="navbar navbar-white bg-white shadow-sm mb-4 p-3">
                <h4 class="mb-0 fw-bold text-dark">@ViewBag.Title</h4>
            </nav>
            <div class="container-fluid px-4">
                @await Html.PartialAsync("_Messages")
                @RenderBody()
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>