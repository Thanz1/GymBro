@using GymBro.Contracts
@model OrderDetailDto

@{
    ViewBag.Title = "Chỉnh sửa Chi tiết Đơn hàng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h4 class="mb-0 text-primary fw-bold">
                    <i class="bi bi-pencil-square"></i> Chỉnh sửa Chi tiết Đơn hàng
                </h4>
            </div>
            <div class="card-body p-4">
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()

                    <div class="form-horizontal">
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                        @* Giữ lại ID để hệ thống biết cần cập nhật bản ghi nào *@
                        @Html.HiddenFor(model => model.Id)

                        <div class="mb-3">
                            <label class="form-label fw-bold">Mã Đơn hàng</label>
                            @* Dùng DropDownList để chọn lại đơn hàng nếu cần *@
                            @Html.DropDownList("OrderId", null, htmlAttributes: new { @class = "form-select border-primary" })
                            @Html.ValidationMessageFor(model => model.OrderId, "", new { @class = "text-danger small" })
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Sản phẩm</label>
                            @Html.DropDownList("ProductId", null, htmlAttributes: new { @class = "form-select border-primary" })
                            @Html.ValidationMessageFor(model => model.ProductId, "", new { @class = "text-danger small" })
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Số lượng</label>
                                @Html.EditorFor(model => model.Quantity, new { htmlAttributes = new { @class = "form-control", type = "number", min = "1" } })
                                @Html.ValidationMessageFor(model => model.Quantity, "", new { @class = "text-danger small" })
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Đơn giá bán (VNĐ)</label>
                                @* Cập nhật từ Price sang UnitPrice để khớp DTO của bạn *@
                                @Html.EditorFor(model => model.UnitPrice, new { htmlAttributes = new { @class = "form-control", type = "number", min = "0", step = "1000" } })
                                @Html.ValidationMessageFor(model => model.UnitPrice, "", new { @class = "text-danger small" })
                            </div>
                        </div>

                        <div class="alert alert-light border mt-2">
                            <i class="bi bi-info-circle me-2"></i>
                            Thành tiền sẽ được tự động tính toán dựa trên số lượng và đơn giá mới.
                        </div>

                        <div class="d-flex gap-2 justify-content-end mt-4 border-top pt-3">
                            <a href="@Url.Action("Index")" class="btn btn-secondary px-4">Hủy</a>
                            <button type="submit" class="btn btn-primary px-4 fw-bold shadow-sm">
                                <i class="bi bi-save"></i> LƯU THAY ĐỔI
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}