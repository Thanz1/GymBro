@using GymBro.Contracts
@model IEnumerable<PurchaseOrderDto>

@{
    ViewBag.Title = "Danh sách Phiếu nhập kho";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h2 class="mb-0 text-primary fw-bold"><i class="bi bi-box-arrow-in-down"></i> Quản lý Nhập kho</h2>
        <a href="@Url.Action("Create")" class="btn btn-primary shadow-sm"><i class="bi bi-plus-lg"></i> Tạo phiếu mới</a>
    </div>
    <div class="card-body">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                <i class="bi bi-check-circle"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="table-responsive">
            <table class="table table-hover table-bordered align-middle">
                <thead class="table-light">
                    <tr>
                        <th class="text-center">Mã phiếu</th>
                        <th>Nhà cung cấp</th>
                        <th>Ngày lập</th>
                        <th>Tổng tiền</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center fw-bold text-primary">#@item.Id</td>
                            <td>@item.SupplierName</td>
                            <td class="small">@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="fw-bold text-danger">@item.TotalAmount.ToString("N0") đ</td>
                            <td class="text-center">
                                <span class="badge @(item.Status == "Đã nhập kho" ? "bg-success" : "bg-warning text-dark") rounded-pill px-3">
                                    @item.Status
                                </span>
                            </td>
                            <td class="text-center">
                                <div class="btn-group">
                                    @* Link Edit thực chất là trang Details để thêm sản phẩm chi tiết *@
                                    <a href="@Url.Action("Edit", new { id = item.Id })" class="btn btn-sm btn-outline-info" title="Chi tiết"><i class="bi bi-pencil-square"></i></a>
                                    @if (item.Status != "Đã nhập kho")
                                    {
                                        <a href="@Url.Action("Delete", new { id = item.Id })" class="btn btn-sm btn-outline-danger" title="Xóa"><i class="bi bi-trash"></i></a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>