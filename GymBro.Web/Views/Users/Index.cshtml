@using GymBro.Contracts
@model IEnumerable<UserDto>

@{
    ViewBag.Title = "Quản lý Người dùng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h2 class="mb-0 text-primary fw-bold"><i class="bi bi-people"></i> Quản lý Người dùng</h2>
        <a href="@Url.Action("Create")" class="btn btn-success shadow-sm"><i class="bi bi-person-plus"></i> Thêm mới</a>
    </div>
    <div class="card-body">
        @* Hiển thị thông báo *@
        @await Html.PartialAsync("_Messages")

        @* Form Tìm kiếm *@
        <div class="row mb-4">
            <div class="col-md-6">
                <form action="@Url.Action("Index")" method="get" class="d-flex gap-2">
                    <input type="text" name="searchString" value="@ViewBag.CurrentSearch" class="form-control" placeholder="Tìm theo Username hoặc Email..." />
                    <button type="submit" class="btn btn-primary px-4">Tìm</button>
                </form>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover table-bordered align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Username</th>
                        <th>Họ tên</th>
                        <th>Email</th>
                        <th class="text-center">Vai trò</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">@item.Username</td>
                            <td>@item.FullName</td>
                            <td>@item.Email</td>
                            <td class="text-center">
                                <span class="badge @(item.Role == "Admin" ? "bg-danger" : "bg-info text-dark") rounded-pill px-3">
                                    @(item.Role == "Admin" ? "Quản trị viên" : "Người dùng")
                                </span>[cite: 54]
                            </td>
                            <td class="text-center">
                                <div class="btn-group">
                                    <a href="@Url.Action("Edit", new { id = item.Id })" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>[cite: 54]
                                    <a href="@Url.Action("Details", new { id = item.Id })" class="btn btn-sm btn-outline-info"><i class="bi bi-eye"></i></a>[cite: 54]
                                    <a href="@Url.Action("Delete", new { id = item.Id })" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>[cite: 54]
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>