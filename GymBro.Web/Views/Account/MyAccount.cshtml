@model GymBro.Contracts.UserDto

@{
    ViewBag.Title = "Tài khoản của tôi";
}

<div class="container mt-4">
    <h2 class="fw-bold">Hồ sơ cá nhân</h2>
    <hr />

    <div class="row">
        <div class="col-md-5">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">Thông tin chi tiết</h5>
                </div>
                <div class="card-body">
                    <p><strong>Tên đăng nhập:</strong> @Model.Username</p>
                    <p><strong>Họ tên:</strong> @(Model.FullName ?? "Chưa cập nhật")</p>
                    <p><strong>Email:</strong> @(Model.Email ?? "Chưa cập nhật")</p>
                    <p><strong>Vai trò:</strong> <span class="badge bg-danger">@Model.Role</span></p>

                    <div class="mt-4">
                        @* Chỉ giữ lại đúng 3 nút chuẩn *@
                        @Html.ActionLink("Chỉnh sửa thông tin", "EditProfile", "Account", null, new { @class = "btn btn-primary w-100 mb-2" })
                        @Html.ActionLink("Đổi mật khẩu", "ChangePassword", "Account", null, new { @class = "btn btn-warning w-100 mb-2" })
                        @Html.ActionLink("Lịch sử đơn hàng", "OrderHistory", "Account", null, new { @class = "btn btn-info w-100" })
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>