@using System.Linq
@model InventoryOverviewViewModel

@{
    ViewBag.Title = "Báo cáo Tồn kho";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3">
        <h2 class="mb-0 text-primary"><i class="bi bi-boxes"></i> Báo cáo Tồn kho</h2>
    </div>
    <div class="card-body">
        @if (TempData["Success"] != null || TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                <i class="bi bi-check-circle"></i> @(TempData["SuccessMessage"] ?? TempData["Success"])
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                <i class="bi bi-exclamation-triangle"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="row mb-4">
            <div class="col-md-6">
                @using (Html.BeginForm("Index", "Inventory", FormMethod.Get, new { @class = "d-flex" }))
                {
                    <input type="text" name="searchString" class="form-control me-2" placeholder="Tìm tên sản phẩm..." value="@Model.SearchString" />
                    <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i> Tìm</button>
                }
            </div>
            <div class="col-md-6 text-end">
                <a href="@Url.Action("History", "Inventory")" class="btn btn-info text-white">
                    <i class="bi bi-clock-history"></i> Xem Lịch sử Biến động kho (Toàn bộ)
                </a>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Mã SP</th>
                        <th>Tên sản phẩm</th>
                        <th>Danh mục</th>
                        <th>Tồn kho hiện tại</th>
                        <th class="text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Products.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted">Không tìm thấy sản phẩm nào.</td>
                        </tr>
                    }
                    @foreach (var item in Model.Products)
                    {
                        <tr class="@(item.StockQuantity <= 10 ? "table-danger" : "")">
                            <td>#@item.Id</td>
                            <td>
                                <div class="fw-bold">@item.ProductName</div>
                                @if (item.StockQuantity <= 10)
                                {
                                    <small class="text-danger"><i class="bi bi-exclamation-triangle"></i> Sắp hết hàng</small>
                                }
                            </td>
                            <td>@(item.Category != null ? item.Category.CategoryName : "N/A")</td>
                            <td class="fw-bold text-center">@item.StockQuantity</td>
                            <td class="text-center">
                                <a href="@Url.Action("History", new { productId = item.Id })" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-clock-history"></i> Lịch sử
                                </a>
                                <a href="@Url.Action("Adjust", new { id = item.Id })" class="btn btn-sm btn-warning">
                                    <i class="bi bi-pencil-square"></i> Điều chỉnh
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
