@model GymBro.Core.Product

<div class="row g-4">
    <div class="col-md-6 text-center">
        @if (!string.IsNullOrEmpty(Model.ImageURL))
        {
            <img src="~/Content/Images/@Model.ImageURL" class="img-fluid rounded" style="max-height: 300px;" onerror="this.src='/Content/Images/no-image.png'" />
        }
        else
        {
            <div class="bg-light d-flex align-items-center justify-content-center rounded" style="height: 300px;">
                <i class="bi bi-image text-muted fs-1"></i>
            </div>
        }
    </div>
    <div class="col-md-6">
        <h4 class="fw-bold">@Model.ProductName</h4>
        <h3 class="text-primary fw-bold mb-3">@string.Format("{0:N0}", Model.Price) ₫</h3>
        <p class="text-muted">
            @(Model.Category != null ? Model.Category.CategoryName : "Chưa phân loại")
        </p>
        <p>
            @if (Model.StockQuantity > 0)
            {
                <span class="badge bg-success">Còn hàng</span>
            }
            else
            {

                <span class="badge bg-danger">Hết hàng</span>
            }
        </p>
        <div class="d-grid gap-2">
            <a href="@Url.Action("Details", "Home", new { id = Model.Id })" class="btn btn-primary">Xem chi tiết</a>
        </div>
    </div>
</div>