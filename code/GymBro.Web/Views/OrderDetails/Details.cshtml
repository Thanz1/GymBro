@model OrderDetailReadOnlyViewModel

@{
    ViewBag.Title = "Chi tiet Don hang";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h4 class="mb-0 text-info">Chi tiet Don hang</h4>
            </div>
            <div class="card-body">
                <div class="alert alert-info">
                    Chi tiet don hang hien o che do chi xem de tranh lech ton kho va thanh toan.
                </div>

                <table class="table table-bordered">
                    <tr>
                        <th class="bg-light" style="width: 35%;">Ma Don hang</th>
                        <td>#@Model.OrderId</td>
                    </tr>
                    <tr>
                        <th class="bg-light">San pham</th>
                        <td>@Model.ProductName</td>
                    </tr>
                    <tr>
                        <th class="bg-light">So luong</th>
                        <td>@Model.Quantity</td>
                    </tr>
                    <tr>
                        <th class="bg-light">Don gia</th>
                        <td class="text-primary fw-bold">@string.Format("{0:N0}", Model.Price) VNĐ</td>
                    </tr>
                    <tr>
                        <th class="bg-light">Thanh tien</th>
                        <td class="text-danger fw-bold">@string.Format("{0:N0}", Model.TotalAmount) VNĐ</td>
                    </tr>
                    <tr>
                        <th class="bg-light">Trang thai DH</th>
                        <td>
                            <span class="badge @Model.OrderStatus.CssClass">@Model.OrderStatus.Text</span>
                        </td>
                    </tr>
                </table>

                <div class="mt-3 d-flex gap-2">
                    @Html.ActionLink("Don hang goc", "Details", "Orders", new { id = Model.OrderId }, new { @class = "btn btn-primary" })
                    @Html.ActionLink("Quay lai", "Index", new { orderId = Model.OrderId }, new { @class = "btn btn-secondary" })
                </div>
            </div>
        </div>
    </div>
</div>
