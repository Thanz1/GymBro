@using GymBro.Contracts
@model ProductDto

@{
    ViewBag.Title = Model.ProductName;
}

<div class="container py-5">
    <div class="row">
        @* Ảnh sản phẩm *@
        <div class="col-md-6 mb-4">
            <div class="card border-0 shadow-sm p-4">
                <img src="~/Content/Images/@Model.ImageURL" class="img-fluid rounded" alt="@Model.ProductName" onerror="this.src='/Content/Images/no-image.png'" />
            </div>
        </div>

        @* Thông tin đặt hàng *@
        <div class="col-md-6">
            <h1 class="fw-bold">@Model.ProductName</h1>
            <div class="badge bg-info mb-3">@(Model.CategoryName ?? "Gym Equipment")</div>
            <h2 class="text-danger fw-bold mb-4">@Model.Price.ToString("N0") ₫</h2>

            <div class="description mb-4">
                <h5 class="fw-bold border-bottom pb-2">Mô tả sản phẩm</h5>
                <div class="text-muted mt-2">
                    @Html.Raw(Model.Description ?? "Đang cập nhật thông tin chi tiết...")
                </div>
            </div>

            <form asp-action="AddToCart" asp-controller="Cart" method="post">
                <input type="hidden" name="productId" value="@Model.Id" />
                <div class="d-flex gap-3 align-items-center mb-4">
                    <input type="number" name="quantity" value="1" min="1" class="form-control text-center" style="width: 80px;" />
                    @if (Model.StockQuantity > 0)
                    {
                        <button type="submit" class="btn btn-danger btn-lg flex-grow-1 fw-bold">THÊM VÀO GIỎ HÀNG</button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-secondary btn-lg flex-grow-1 disabled">HẾT HÀNG</button>
                    }
                </div>
            </form>

            <div class="row g-2 border-top pt-3 text-muted small">
                <div class="col-6"><i class="bi bi-truck text-danger"></i> Giao hàng toàn quốc</div>
                <div class="col-6"><i class="bi bi-shield-check text-danger"></i> Bảo hành chính hãng</div>
            </div>
        </div>
    </div>

    @* Đánh giá sản phẩm (Sử dụng AJAX để tải) *@
    <div class="row mt-5">
        <div class="col-12">
            <h4 class="fw-bold border-bottom pb-2 mb-4">Khách hàng nói gì về sản phẩm?</h4>
            <div id="review-section">
                <div class="text-center py-4 text-muted">
                    <div class="spinner-border spinner-border-sm" role="status"></div>
                    Đang tải đánh giá...
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Load danh sách đánh giá qua Review API
            var reviewUrl = '@Url.Action("GetByProduct", "Reviews", new { productId = Model.Id })';
            $("#review-section").load(reviewUrl);
        });
    </script>
}