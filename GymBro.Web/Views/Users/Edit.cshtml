@using GymBro.Contracts
@model UserDto

@{
    ViewBag.Title = "Sửa Người dùng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h4 class="mb-0 text-primary fw-bold">Cập nhật tài khoản: @Model.Username</h4>
            </div>
            <div class="card-body p-4">
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(model => model.Id)
                    @Html.HiddenFor(model => model.Username)

                    <div class="mb-3">
                        <label class="form-label text-muted">Tên đăng nhập (Không thể đổi)</label>
                        <input type="text" class="form-control bg-light" value="@Model.Username" readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Mật khẩu mới</label>
                        <input type="password" name="NewPassword" class="form-control border-warning" placeholder="Để trống nếu không đổi mật khẩu" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Họ và tên</label>
                        @Html.EditorFor(model => model.FullName, new { htmlAttributes = new { @class = "form-control" } })
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Vai trò</label>
                        @Html.DropDownListFor(model => model.Role, new SelectList(new[] {
                        new { Value = "User", Text = "Người dùng" },
                                        new { Value = "Admin", Text = "Quản trị viên" }
                                        }, "Value", "Text"), new { @class = "form-select shadow-sm" })
                </div>

                <div class="d-flex gap-2 mt-4 pt-3 border-top">
                    <button type="submit" class="btn btn-primary px-4 fw-bold">LƯU THAY ĐỔI</button>
                    <a href="@Url.Action("Index")" class="btn btn-secondary px-4">QUAY LẠI</a>
                </div>
                                }
            </div>
        </div>
    </div>
</div>