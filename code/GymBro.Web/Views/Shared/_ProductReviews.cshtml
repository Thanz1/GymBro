@model GymBro.Web.Controllers.ProductReviewsViewModel

<div class="card mt-4 shadow-sm border-0">
    <div class="card-header bg-white border-bottom-0 pt-4 ps-4">
        <h4 class="fw-bold text-dark"><i class="bi bi-star-fill text-warning"></i> Đánh giá sản phẩm (@(Model?.Reviews.Count ?? 0))</h4>
    </div>
    <div class="card-body px-4">
        @if (Model != null && Model.Reviews.Any())
        {
            <div class="review-list">
                @foreach (var review in Model.Reviews)
                {
                    var displayName = review.User == null
                        ? "Khách"
                        : string.IsNullOrWhiteSpace(review.User.FullName)
                            ? review.User.Username
                            : review.User.FullName;

                    <div class="review-item mb-4 pb-3 border-bottom">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div class="d-flex align-items-center">
                                <div class="avatar bg-light rounded-circle d-flex align-items-center justify-content-center me-2 review-avatar">
                                    <i class="bi bi-person-fill text-secondary fs-5"></i>
                                </div>
                                <div>
                                    <div class="fw-bold">@displayName</div>
                                    <small class="text-muted review-date">@review.CreatedDate.ToString("dd/MM/yyyy HH:mm")</small>
                                </div>
                            </div>
                            <div class="rating text-warning">
                                @for (var i = 1; i <= 5; i++)
                                {
                                    if (i <= review.Rating)
                                    {
                                        <i class="bi bi-star-fill"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-star"></i>
                                    }
                                }
                            </div>
                        </div>
                        <p class="mb-0 text-secondary review-content">@review.Comment</p>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-muted text-center py-3">Chưa có đánh giá nào cho sản phẩm này.</p>
        }

        @if (Model != null)
        {
            <div class="add-review mt-4 pt-3 border-top">
                <h5 class="fw-bold mb-3">Viết đánh giá của bạn</h5>

                @if (Model.IsAuthenticated)
                {
                    <form action="@Url.Action("Add", "Reviews")" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="productId" value="@Model.ProductId" />

                        <div class="mb-3">
                            <label class="form-label fw-bold small">Đánh giá sao:</label>
                            <div class="rating-input d-flex gap-2 flex-wrap">
                                @for (var i = 5; i >= 1; i--)
                                {
                                    <input type="radio"
                                           class="btn-check"
                                           name="rating"
                                           id="rating-@Model.ProductId-@i"
                                           value="@i"
                                           @(i == 5 ? "checked" : null)
                                           autocomplete="off" />
                                    <label class="btn btn-outline-warning" for="rating-@Model.ProductId-@i">
                                        @i <i class="bi bi-star-fill"></i>
                                    </label>
                                }
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small">Nội dung:</label>
                            <textarea name="comment"
                                      class="form-control"
                                      rows="3"
                                      maxlength="1000"
                                      placeholder="Chia sẻ cảm nhận của bạn về sản phẩm..."
                                      required></textarea>
                        </div>

                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-send"></i> Gửi đánh giá
                        </button>
                    </form>
                }
                else
                {
                    <div class="alert alert-warning mb-0">
                        Vui lòng <a href="@Url.Action("Login", "Account", new { returnUrl = Model.DetailsUrl })" class="alert-link">đăng nhập</a> để viết đánh giá.
                    </div>
                }
            </div>
        }
    </div>
</div>
