@using GymBro.Contracts
@model OrderDetailDto

@{
    ViewBag.Title = "Chi tiết Đơn hàng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3 text-info fw-bold">
                <h4 class="mb-0">Thông tin Chi tiết</h4>
            </div>
            <div class="card-body p-4">
                <table class="table table-bordered">
                    <tr>
                        <th class="bg-light w-40">Mã Đơn hàng</th>
                        <td>#@Model.OrderId</td>
                    </tr>
                    <tr>
                        <th class="bg-light">Sản phẩm</th>
                        <td>@Model.ProductName</td>
                    </tr>
                    <tr>
                        <th class="bg-light">Số lượng</th>
                        <td>@Model.Quantity</td>
                    </tr>
                    <tr>
                        <th class="bg-light">Đơn giá</th>
                        <td class="text-primary fw-bold">@Model.UnitPrice.ToString("N0") ₫</td>
                    </tr>
                    <tr>
                        <th class="bg-light">Thành tiền</th>
                        <td class="text-danger fw-bold">@Model.Total.ToString("N0") ₫</td>
                    </tr>
                </table>
                <div class="mt-4 d-flex gap-2">
                    <a href="@Url.Action("Edit", new { id = Model.Id })" class="btn btn-primary"><i class="bi bi-pencil"></i> Chỉnh sửa</a>
                    <a href="@Url.Action("Index")" class="btn btn-secondary">Quay lại</a>
                </div>
            </div>
        </div>
    </div>
</div>