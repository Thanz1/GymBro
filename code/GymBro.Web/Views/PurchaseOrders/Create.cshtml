@using System.Linq
@model PurchaseOrderCreateViewModel

@{
    ViewBag.Title = "Tạo Phiếu nhập kho";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h4 class="mb-0 text-primary">Tạo Phiếu nhập kho (Bước 1)</h4>
            </div>
            <div class="card-body">
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()

                    <div class="form-horizontal">
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i> Vui lòng chọn Nhà cung cấp và Ngày lập. Sau đó bạn sẽ được chuyển sang màn hình thêm sản phẩm chi tiết.
                        </div>

                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                        <div class="mb-3">
                            <label class="form-label fw-bold">Nhà cung cấp <span class="text-danger">*</span></label>
                            @if (Model.SupplierOptions.Any())
                            {
                                @Html.DropDownListFor(
                                    model => model.SupplierId,
                                    new Microsoft.AspNetCore.Mvc.Rendering.SelectList(
                                        Model.SupplierOptions,
                                        nameof(LookupOptionDto.Id),
                                        nameof(LookupOptionDto.Name),
                                        Model.SupplierId),
                                    "Chọn nhà cung cấp",
                                    new { @class = "form-control form-select" })
                            }
                            else
                            {
                                <div class="alert alert-warning mt-2">
                                    <i class="bi bi-exclamation-triangle"></i>
                                    Chưa có nhà cung cấp nào. Vui lòng
                                    <a href="@Url.Action("Create", "Supplier")" class="alert-link">tạo nhà cung cấp</a>
                                    trước.
                                </div>
                            }
                            @Html.ValidationMessageFor(model => model.SupplierId, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Ngày lập</label>
                            @Html.TextBoxFor(
                                model => model.OrderDate,
                                "{0:yyyy-MM-ddTHH:mm}",
                                new
                                {
                                    @class = "form-control",
                                    type = "datetime-local",
                                    Value = Model.OrderDate.ToString("yyyy-MM-ddTHH:mm")
                                })
                            @Html.ValidationMessageFor(model => model.OrderDate, "", new { @class = "text-danger" })
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <a href="@Url.Action("Index")" class="btn btn-secondary">Hủy bỏ</a>
                            <input type="submit" value="Tiếp tục (Thêm chi tiết)" class="btn btn-primary" />
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
