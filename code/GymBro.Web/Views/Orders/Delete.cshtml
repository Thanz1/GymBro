@model OrderReadOnlyViewModel

@{
    ViewBag.Title = "Xoa don hang";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h4 class="mb-0 text-danger"><i class="bi bi-trash"></i> Xoa don hang</h4>
            </div>
            <div class="card-body">
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <strong>Ban co chac chan muon xoa don hang nay?</strong>
                    <p class="mb-0 mt-2">Hanh dong nay khong the hoan tac. Don hang nay se bi xoa vinh vien.</p>
                </div>

                <dl class="row mb-4">
                    <dt class="col-sm-4">Ma don hang:</dt>
                    <dd class="col-sm-8 fw-bold">#@Model.Id</dd>

                    <dt class="col-sm-4">Ngay dat hang:</dt>
                    <dd class="col-sm-8">@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</dd>

                    <dt class="col-sm-4">Trang thai:</dt>
                    <dd class="col-sm-8">
                        <span class="badge @Model.OrderStatus.CssClass">@Model.OrderStatus.Text</span>
                    </dd>

                    <dt class="col-sm-4">Tong tien:</dt>
                    <dd class="col-sm-8 text-primary fw-bold">@string.Format("{0:N0}", Model.TotalAmount) VND</dd>

                    <dt class="col-sm-4">Khach hang:</dt>
                    <dd class="col-sm-8">@Model.CustomerDisplayName</dd>
                </dl>

                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()

                    <p class="text-muted small">
                        Chi nen xoa don da huy va chua co giao dich kho de tranh mat lich su nghiep vu.
                    </p>

                    <div class="d-flex justify-content-end gap-2">
                        <a href="@Url.Action("Index")" class="btn btn-secondary">Huy bo</a>
                        <button type="submit" class="btn btn-danger" onclick="return confirmDelete()">
                            <i class="bi bi-trash"></i> Xac nhan xoa
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete() {
            return confirm('Ban co chac chan muon xoa don hang #@Model.Id?\n\nHanh dong nay khong the hoan tac!');
        }
    </script>
}
