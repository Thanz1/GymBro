@using GymBro.Contracts
@model CategoryDto

@{
    ViewBag.Title = "Xóa Danh mục";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm border-top border-danger border-4">
            <div class="card-body p-4 text-center">
                <i class="bi bi-exclamation-octagon display-4 text-danger mb-3"></i>
                <h3 class="fw-bold">Xác nhận xóa?</h3>
                <p class="text-muted">Bạn đang thực hiện xóa danh mục <strong>"@Model.CategoryName"</strong>. Các sản phẩm thuộc danh mục này có thể bị ảnh hưởng. Hành động này không thể hoàn tác!</p>

                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    <div class="d-flex justify-content-center gap-3 mt-4">
                        <button type="submit" class="btn btn-danger btn-lg px-5 shadow-sm">XÁC NHẬN XÓA</button>
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-lg px-5">HỦY BỎ</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>