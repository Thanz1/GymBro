@using GymBro.Contracts
@model IEnumerable<PaymentDto>

@{
    ViewBag.Title = "Quản lý Thanh toán";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3">
        <h2 class="mb-0 text-primary fw-bold"><i class="bi bi-credit-card-2-front"></i> Quản lý Thanh toán</h2>
    </div>
    <div class="card-body">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @* Thẻ thống kê nhanh *@
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card border-0 bg-warning bg-opacity-10 border-start border-warning border-4 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted text-uppercase small mb-1">Chờ xác minh</h6>
                                <h3 class="mb-0 text-warning fw-bold">@ViewBag.PendingCount</h3>
                            </div>
                            <i class="bi bi-clock-history fs-1 text-warning opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover table-bordered align-middle">
                <thead class="table-light">
                    <tr>
                        <th class="text-center">Mã ĐH</th>
                        <th>Khách hàng</th>
                        <th>Phương thức</th>
                        <th>Số tiền</th>
                        <th>Ngày thanh toán</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr><td colspan="7" class="text-center py-4 text-muted">Chưa có dữ liệu thanh toán nào.</td></tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center">
                                    <a href="@Url.Action("Details", "Orders", new { id = item.OrderId })" class="fw-bold text-decoration-none">
                                        #@item.OrderId
                                    </a>
                                </td>
                                <td class="fw-bold">@item.CustomerName</td>
                                <td><span class="badge bg-secondary">@item.PaymentMethodName</span></td>
                                <td class="fw-bold text-primary">@item.Amount.ToString("N0") ₫</td>
                                <td class="small">@item.PaymentDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-center">
                                    <span class="badge @(item.Status == "Completed" || item.Status == "Đã thanh toán" ? "bg-success" : "bg-warning text-dark") rounded-pill px-3">
                                        @(item.Status == "Completed" || item.Status == "Đã thanh toán" ? "Đã thanh toán" : item.Status)
                                    </span>
                                </td>
                                <td class="text-center">
                                    <a href="@Url.Action("Details", new { id = item.Id })" class="btn btn-sm btn-outline-info" title="Xem chi tiết">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>