@model AccountOrderDetailsViewModel

@{
    ViewBag.Title = "Chi tiet don hang #" + Model.Order.Id;
    var order = Model.Order;
    var payment = order.Payment;
}

<div class="container pb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h2 class="mb-1">Chi tiet don hang #@order.Id</h2>
            <div class="text-muted">Ngay dat: @order.OrderDate.ToString("dd/MM/yyyy HH:mm")</div>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("OrderHistory", "Account")" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Lich su don hang
            </a>
            <a href="@Url.Action("MyAccount", "Account")" class="btn btn-outline-primary">
                <i class="bi bi-person-circle"></i> Tai khoan cua toi
            </a>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-light">
                    <h3 class="h6 mb-0 text-uppercase text-muted">Thong tin don hang</h3>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-5">Trang thai don</dt>
                        <dd class="col-sm-7">
                            <span class="badge @order.OrderStatus.CssClass">@order.OrderStatus.Text</span>
                        </dd>

                        <dt class="col-sm-5">Tong gia tri</dt>
                        <dd class="col-sm-7 fw-bold text-danger">@order.TotalAmount.ToString("N0") VNĐ</dd>

                        <dt class="col-sm-5">Nguoi nhan</dt>
                        <dd class="col-sm-7">@order.CustomerDisplayName</dd>

                        <dt class="col-sm-5">Email</dt>
                        <dd class="col-sm-7">@order.CustomerEmail</dd>

                        <dt class="col-sm-5">Dia chi</dt>
                        <dd class="col-sm-7">@order.CustomerAddress</dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-light">
                    <h3 class="h6 mb-0 text-uppercase text-muted">Thanh toan</h3>
                </div>
                <div class="card-body">
                    @if (payment == null)
                    {
                        <div class="text-muted">Don hang nay chua co thong tin thanh toan.</div>
                    }
                    else
                    {
                        <dl class="row mb-3">
                            <dt class="col-sm-5">Phuong thuc</dt>
                            <dd class="col-sm-7">@payment.Method</dd>

                            <dt class="col-sm-5">Trang thai</dt>
                            <dd class="col-sm-7">
                                <span class="badge @payment.Status.CssClass">@payment.Status.Text</span>
                            </dd>

                            <dt class="col-sm-5">Cap nhat lan cuoi</dt>
                            <dd class="col-sm-7">@payment.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</dd>

                            <dt class="col-sm-5">So tien</dt>
                            <dd class="col-sm-7 fw-bold text-primary">@payment.Amount.ToString("N0") VNĐ</dd>
                        </dl>

                        @if (payment.CanOpenPayment)
                        {
                            <a href="@Url.Action("Payment", "Cart", new { id = order.Id })" class="btn btn-danger">
                                <i class="bi bi-credit-card"></i> @payment.PaymentActionText
                            </a>
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-light">
            <h3 class="h6 mb-0 text-uppercase text-muted">San pham trong don</h3>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">San pham</th>
                            <th class="text-center">So luong</th>
                            <th class="text-end">Don gia</th>
                            <th class="text-end pe-4">Thanh tien</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (order.Items.Any())
                        {
                            foreach (var item in order.Items)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-semibold">@item.ProductName</div>
                                        <small class="text-muted">Ma SP: #@item.ProductId</small>
                                    </td>
                                    <td class="text-center">x @item.Quantity</td>
                                    <td class="text-end">@item.Price.ToString("N0") VNĐ</td>
                                    <td class="text-end pe-4 fw-semibold">@item.TotalAmount.ToString("N0") VNĐ</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">Khong co chi tiet san pham.</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <td colspan="3" class="text-end fw-bold">Tong cong</td>
                            <td class="text-end pe-4 fw-bold text-danger">@order.TotalAmount.ToString("N0") VNĐ</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>
