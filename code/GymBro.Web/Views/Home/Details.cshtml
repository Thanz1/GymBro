@model GymBro.Core.Product

@functions {
    private const string FallbackImageUrl = "/Content/Images/shopping.webp";

    private static string ResolveImageUrl(string? imageUrl)
    {
        if (string.IsNullOrWhiteSpace(imageUrl))
        {
            return FallbackImageUrl;
        }

        if (imageUrl.StartsWith("/Content/", System.StringComparison.OrdinalIgnoreCase)
            || imageUrl.StartsWith("http://", System.StringComparison.OrdinalIgnoreCase)
            || imageUrl.StartsWith("https://", System.StringComparison.OrdinalIgnoreCase))
        {
            return imageUrl;
        }

        return imageUrl.StartsWith("/", System.StringComparison.Ordinal)
            ? imageUrl
            : "/Content/Images/" + imageUrl;
    }
}

@{
    ViewBag.Title = "Chi tiết sản phẩm";
    var imageUrl = ResolveImageUrl(Model.ImageURL);
    var isWishlisted = ViewBag.IsWishlisted == true;
}

<div class="product-detail-page"
     data-wishlist-toggle-url="@Url.Action("Toggle", "Wishlist")"
     data-login-url="@Url.Action("Login", "Account")">
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb product-detail-breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")" class="product-detail-breadcrumb-link">Trang chủ</a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("Shop", "Home")" class="product-detail-breadcrumb-link">Cửa hàng</a></li>
                    @if (Model.Category != null)
                    {
                        <li class="breadcrumb-item">
                            <a href="@Url.Action("Shop", "Home", new { categoryId = Model.Category.Id })" class="product-detail-breadcrumb-link">
                                @Model.Category.CategoryName
                            </a>
                        </li>
                    }
                    <li class="breadcrumb-item active" aria-current="page">@Model.ProductName</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-6 col-md-6 mb-4">
            <div class="product-detail-panel product-detail-image-panel position-relative">
                <div class="zoom-container">
                    <img src="@Url.Content(imageUrl)"
                         alt="@Model.ProductName"
                         class="img-fluid product-detail-img zoom-image js-image-fallback"
                         loading="lazy"
                         data-fallback-selector=".product-detail-placeholder" />
                </div>
                <div class="product-detail-placeholder is-hidden">
                    <div class="text-center text-muted">
                        <i class="bi bi-image product-detail-placeholder-icon"></i>
                        <p class="mt-3 mb-0">Không thể tải hình ảnh sản phẩm.</p>
                    </div>
                </div>
                <div class="text-center mt-2">
                    <small class="text-muted product-detail-zoom-hint">
                        <i class="bi bi-zoom-in"></i> Nhấn ảnh để phóng to
                    </small>
                </div>
            </div>
        </div>

        <div class="col-lg-6 col-md-6">
            <div class="product-detail-panel product-detail-info-panel">
                <h1 class="product-detail-title">@Model.ProductName</h1>

                <div class="price-section product-detail-price-card mb-4">
                    <p class="product-detail-price-label">Giá sản phẩm</p>
                    <div class="product-detail-price">
                        @Model.Price.ToString("N0") <span class="product-detail-currency">VNĐ</span>
                    </div>
                </div>

                <div class="description-section mb-4">
                    <h4 class="product-detail-section-title">
                        <i class="bi bi-info-circle"></i> Mô tả sản phẩm
                    </h4>
                    <div class="product-detail-description-body">
                        @if (string.IsNullOrWhiteSpace(Model.Description))
                        {
                            <p>Sản phẩm chất lượng cao, phù hợp cho việc tập luyện thể thao. Mô tả chi tiết sẽ được cập nhật thêm.</p>
                        }
                        else
                        {
                            @Html.Raw(Model.Description)
                        }
                    </div>
                </div>

                <hr class="product-detail-divider" />

                <form action="@Url.Action("AddToCart", "Cart")" method="post">
                    <input type="hidden" name="productId" value="@Model.Id" />

                    <div class="form-group mb-4">
                        <label for="quantity" class="product-detail-quantity-label">
                            <i class="bi bi-cart-plus"></i> Số lượng
                        </label>
                        <div class="input-group quantity-group product-detail-quantity-group">
                            <button type="button" class="btn btn-outline-secondary js-detail-quantity-btn" data-direction="decrease">
                                <i class="bi bi-dash"></i>
                            </button>
                            <input type="number"
                                   id="quantity"
                                   name="quantity"
                                   value="1"
                                   min="1"
                                   class="form-control text-center product-detail-quantity-input" />
                            <button type="button" class="btn btn-outline-secondary js-detail-quantity-btn" data-direction="increase">
                                <i class="bi bi-plus"></i>
                            </button>
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        @if (Model.StockQuantity > 0)
                        {
                            <button type="submit" class="btn btn-success btn-lg product-detail-primary-action">
                                <i class="bi bi-cart-plus"></i> Thêm vào giỏ hàng
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-secondary btn-lg product-detail-primary-action" disabled>
                                Hết hàng
                            </button>
                        }

                        <div class="d-flex gap-2">
                            <a href="@Url.Action("Index", "Cart")" class="btn btn-outline-primary flex-grow-1 product-detail-secondary-action">
                                <i class="bi bi-cart-check"></i> Xem giỏ hàng
                            </a>
                            <button type="button"
                                    class="btn btn-outline-danger product-detail-wishlist-btn js-wishlist-toggle"
                                    data-product-id="@Model.Id"
                                    title="Yêu thích">
                                <i class="bi @(isWishlisted ? "bi-heart-fill text-danger" : "bi-heart")" id="wishlist-icon-@Model.Id"></i>
                            </button>
                        </div>
                    </div>
                </form>

                <div class="product-features product-detail-features mt-4">
                    <div class="row g-3">
                        <div class="col-6">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-check-circle-fill text-success me-2 product-detail-feature-icon"></i>
                                <span>Chất lượng cao</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-truck text-primary me-2 product-detail-feature-icon"></i>
                                <span>Giao hàng nhanh</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-shield-check text-info me-2 product-detail-feature-icon"></i>
                                <span>Bảo hành chính hãng</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-arrow-repeat text-warning me-2 product-detail-feature-icon"></i>
                                <span>Đổi trả dễ dàng</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div id="review-section">
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2 text-muted">Đang tải đánh giá...</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            var url = '@Url.Action("GetByProduct", "Reviews", new { productId = Model.Id })';
            $("#review-section").load(url, function (response, status) {
                if (status === "error") {
                    $("#review-section").html("<div class='alert alert-warning'>Chưa có đánh giá nào hoặc không thể tải đánh giá.</div>");
                }
            });
        });
    </script>
}
