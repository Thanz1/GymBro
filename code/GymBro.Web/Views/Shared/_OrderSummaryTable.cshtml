@model IReadOnlyList<OrderListItemViewModel>

<div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>Ma don</th>
                <th>Ngay dat</th>
                <th>Tong tien</th>
                <th>Trang thai don</th>
                <th>Thanh toan</th>
                <th class="text-end"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-semibold">#@item.Id</td>
                    <td>@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                    <td class="fw-bold text-danger">@string.Format("{0:N0}", item.TotalAmount) VNĐ</td>
                    <td>
                        <span class="badge @item.OrderStatus.CssClass">@item.OrderStatus.Text</span>
                    </td>
                    <td>
                        @if (item.Payment == null)
                        {
                            <span class="text-muted">Chua co</span>
                        }
                        else
                        {
                            <span class="badge @item.Payment.Status.CssClass">@item.Payment.Status.Text</span>
                        }
                    </td>
                    <td class="text-end">
                        <a href="@Url.Action("OrderDetails", "Account", new { id = item.Id })" class="btn btn-sm btn-outline-primary">
                            Chi tiet
                        </a>
                        @if (item.Payment?.CanOpenPayment == true)
                        {
                            <a href="@Url.Action("Payment", "Cart", new { id = item.Id })" class="btn btn-sm btn-danger ms-1">
                                @item.Payment.PaymentActionText
                            </a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
