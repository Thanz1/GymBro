@model IEnumerable<GymBro.Core.Product>

@{
    ViewBag.Title = "Quản lý Sản phẩm";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3">
        <h2 class="mb-0 text-primary"><i class="bi bi-box-seam"></i> Quản lý Sản phẩm</h2>
    </div>
    <div class="card-body">
        @* Hiển thị thông báo *@
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="row mb-4 align-items-end">
            <div class="col-md-9">
                <form action="@Url.Action("Index")" method="get" class="row g-2">
                    <div class="col-auto">
                        <input type="text" name="searchString" value="@ViewBag.CurrentSearch" class="form-control" placeholder="Tìm theo tên..." />
                    </div>
                    <div class="col-auto">
                        @* Dropdown lọc danh mục *@
                        @if (ViewBag.Categories != null)
                        {
                            @Html.DropDownList("categoryId", (SelectList)ViewBag.Categories, "Tất cả danh mục", new { @class = "form-select", onchange = "this.form.submit();" })
                        }
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i> Tìm kiếm</button>
                        @if (!string.IsNullOrEmpty(ViewBag.CurrentSearch) || ViewBag.CurrentCategory != null)
                        {
                            <a href="@Url.Action("Index")" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i> Xóa lọc</a>
                        }
                    </div>
                </form>
            </div>
            <div class="col-md-3 text-end">
                <a href="@Url.Action("Create")" class="btn btn-success"><i class="bi bi-plus-lg"></i> Thêm sản phẩm</a>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover table-bordered align-middle">
                <thead class="table-light">
                    <tr>
                        <th style="width: 80px;">Hình ảnh</th>
                        <th>Tên sản phẩm</th>
                        <th>Danh mục</th>
                        <th>Giá</th>
                        <th>Tồn kho</th>
                        <th class="text-center" style="width: 150px;">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">Không tìm thấy sản phẩm nào.</td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center">
                                @if (!string.IsNullOrEmpty(item.ImageURL))
                                {
                                    <img src="~/Content/Images/@item.ImageURL" class="img-thumbnail" style="width: 60px; height: 60px; object-fit: cover;" onerror="this.src='/Content/Images/no-image.png'" />
                                }
                                else
                                {
                                    <div class="bg-light d-flex align-items-center justify-content-center text-muted" style="width: 60px; height: 60px; border: 1px solid #dee2e6;">
                                        <i class="bi bi-image"></i>
                                    </div>
                                }
                            </td>
                            <td>
                                <div class="fw-bold">@item.ProductName</div>
                                <small class="text-muted">ID: #@item.Id</small>
                            </td>
                            <td>
                                @(item.Category != null ? item.Category.CategoryName : "N/A")
                            </td>
                            <td class="fw-bold text-primary">
                                @string.Format("{0:N0}", item.Price) ₫
                            </td>
                            <td>
                                @if (item.StockQuantity <= 5)
                                {
                                    <span class="badge bg-danger">@item.StockQuantity (Sắp hết)</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">@item.StockQuantity</span>
                                }
                            </td>
                            <td class="text-center">
                                @* SỬA: ProductID -> Id *@
                                <a href="@Url.Action("Edit", new { id = item.Id })" class="btn btn-sm btn-primary me-1" title="Sửa"><i class="bi bi-pencil"></i></a>
                                <a href="@Url.Action("Details", new { id = item.Id })" class="btn btn-sm btn-info me-1" title="Chi tiết"><i class="bi bi-eye"></i></a>
                                <a href="@Url.Action("Delete", new { id = item.Id })" class="btn btn-sm btn-danger" title="Xóa"><i class="bi bi-trash"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* Phân trang *@
        @if (ViewBag.TotalPages != null && ViewBag.TotalPages > 1)
        {
            <nav aria-label="Page navigation" class="mt-4">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(ViewBag.PageNumber <= 1 ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { page = ViewBag.PageNumber - 1, searchString = ViewBag.CurrentSearch, categoryId = ViewBag.CurrentCategory })">Trước</a>
                    </li>
                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(ViewBag.PageNumber == i ? "active" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { page = i, searchString = ViewBag.CurrentSearch, categoryId = ViewBag.CurrentCategory })">@i</a>
                        </li>
                    }
                    <li class="page-item @(ViewBag.PageNumber >= ViewBag.TotalPages ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { page = ViewBag.PageNumber + 1, searchString = ViewBag.CurrentSearch, categoryId = ViewBag.CurrentCategory })">Sau</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>