@using GymBro.Contracts
@model OrderDto

@{
    ViewBag.Title = "Thanh toán QR #" + Model.Id;
    var paymentStatus = ViewBag.PaymentStatus as string ?? "Chờ thanh toán";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-3 overflow-hidden">
                <div class="card-header bg-primary text-white text-center py-4">
                    <h3 class="mb-0 fw-bold"><i class="bi bi-qr-code-scan"></i> QUÉT MÃ THANH TOÁN</h3>
                    <p class="mb-0 opacity-75">Mã đơn hàng: #@Model.Id</p>
                </div>
                <div class="card-body p-5">
                    <div class="row align-items-center">
                        <div class="col-md-6 text-center border-end">
                            <div class="bg-white p-2 border rounded shadow-sm d-inline-block">
                                <img src="@ViewBag.QRImage" class="img-fluid" style="width: 250px;" alt="QR Code" />
                            </div>
                            <p class="mt-3 text-muted small">Mở App Ngân hàng để quét mã</p>
                        </div>
                        <div class="col-md-6 ps-4">
                            <h5 class="text-primary fw-bold mb-3">Thông tin chuyển khoản</h5>
                            <p class="mb-1 text-muted small">Số tài khoản:</p>
                            <h4 class="fw-bold text-danger">@ViewBag.AccountNo</h4>
                            <p class="mb-1 text-muted small">Chủ tài khoản:</p>
                            <p class="fw-bold">@ViewBag.AccountName</p>
                            <p class="mb-1 text-muted small">Số tiền:</p>
                            <h4 class="fw-bold">@Model.TotalAmount.ToString("N0") ₫</h4>

                            <hr />
                            <form asp-action="ConfirmPayment" asp-controller="Cart" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Id" />
                                <button type="submit" class="btn btn-success w-100 py-3 fw-bold shadow-sm">TÔI ĐÃ CHUYỂN KHOẢN XONG</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>