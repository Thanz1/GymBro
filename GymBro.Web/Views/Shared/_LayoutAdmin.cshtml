@using Microsoft.EntityFrameworkCore
@inject GymBro.Infrastructure.GymBroDbContext _context

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Admin Panel</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f8f9fc;
        }

        .sidebar {
            min-height: 100vh;
            background: linear-gradient(180deg, #4e73df 10%, #224abe 100%);
            color: white;
        }

            .sidebar .nav-link {
                color: rgba(255,255,255,0.8);
                padding: 1rem;
            }

                .sidebar .nav-link:hover, .sidebar .nav-link.active {
                    color: white;
                    background: rgba(255,255,255,0.1);
                    font-weight: 600;
                }

                .sidebar .nav-link i {
                    margin-right: 0.5rem;
                    width: 1.2rem;
                    text-align: center;
                }

        .sidebar-brand {
            padding: 1.5rem 1rem;
            text-align: center;
            font-size: 1.2rem;
            font-weight: 800;
            color: white;
            text-decoration: none;
            display: block;
        }

        .topbar {
            background-color: white;
            box-shadow: 0 .15rem 1.75rem 0 rgba(58,59,69,.15);
            height: 70px;
        }
    </style>
</head>
<body>
    <div class="d-flex">
        <div class="sidebar d-flex flex-column flex-shrink-0 p-3" style="width: 250px;">
            <a href="@Url.Action("Index", "Home")" class="sidebar-brand">
                <i class="bi bi-dumbbell"></i> GYMBRO ADMIN
            </a>
            <hr class="bg-white opacity-25">
            <ul class="nav nav-pills flex-column mb-auto">
                <li class="nav-item">
                    @* Nếu bạn chưa có Dashboard thì trỏ tạm về Products *@
                    <a href="@Url.Action("Index", "Products")" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" ? "active" : "")">
                        <i class="bi bi-speedometer2"></i> Dashboard
                    </a>
                </li>

                <li class="nav-item mt-3 text-white-50 small text-uppercase fw-bold px-3">Bán hàng</li>
                <li>
                    <a href="@Url.Action("Index", "Orders")" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Orders" ? "active" : "")">
                        <i class="bi bi-receipt"></i> Đơn hàng
                    </a>
                </li>
                <li>
                    @{
                        // Đếm số thanh toán chờ duyệt
                        var pendingPaymentCount = _context.Payments.Count(p => p.Status == "Chờ xác minh");
                    }
                    <a href="@Url.Action("Index", "Payments")" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Payments" ? "active" : "")">
                        <i class="bi bi-credit-card"></i> Thanh toán
                        @if (pendingPaymentCount > 0)
                        {
                            <span class="badge bg-warning text-dark rounded-pill ms-2">@pendingPaymentCount</span>
                        }
                    </a>
                </li>
                <li>
                    <a href="@Url.Action("Index", "PaymentMethods")" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "PaymentMethods" ? "active" : "")">
                        <i class="bi bi-credit-card-2-front"></i> Phương thức TT
                    </a>
                </li>

                <li class="nav-item mt-3 text-white-50 small text-uppercase fw-bold px-3">Kho & Nhập hàng</li>
                <li>
                    <a href="@Url.Action("Index", "Inventory")" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Inventory" ? "active" : "")">
                        <i class="bi bi-boxes"></i> Tồn kho
                    </a>
                </li>
                <li>
                    <a href="@Url.Action("Index", "PurchaseOrders")" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "PurchaseOrders" ? "active" : "")">
                        <i class="bi bi-cart-plus"></i> Nhập hàng (PO)
                    </a>
                </li>
                <li>
                    <a href="@Url.Action("Index", "Suppliers")" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Suppliers" ? "active" : "")">
                        <i class="bi bi-truck"></i> Nhà cung cấp
                    </a>
                </li>

                <li class="nav-item mt-3 text-white-50 small text-uppercase fw-bold px-3">Sản phẩm</li>
                <li>
                    <a href="@Url.Action("Index", "Products")" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Products" ? "active" : "")">
                        <i class="bi bi-box-seam"></i> Sản phẩm
                    </a>
                </li>
                <li>
                    <a href="@Url.Action("Index", "Categories")" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Categories" ? "active" : "")">
                        <i class="bi bi-tags"></i> Danh mục
                    </a>
                </li>

                <li class="nav-item mt-3 text-white-50 small text-uppercase fw-bold px-3">Hệ thống</li>
                <li>
                    <a href="@Url.Action("Index", "Users")" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" ? "active" : "")">
                        <i class="bi bi-people"></i> Người dùng
                    </a>
                </li>
                <li>
                    <a href="@Url.Action("Create", "AdminSetup")" class="nav-link">
                        <i class="bi bi-gear"></i> Cài đặt Admin
                    </a>
                </li>
            </ul>
            <hr class="bg-white opacity-25">
            <div class="dropdown">
                <a href="#" class="d-flex align-items-center text-white text-decoration-none dropdown-toggle" id="dropdownUser1" data-bs-toggle="dropdown" aria-expanded="false">
                    <strong>Admin</strong>
                </a>
                <ul class="dropdown-menu dropdown-menu-dark text-small shadow" aria-labelledby="dropdownUser1">
                    <li><a class="dropdown-item" href="@Url.Action("Index", "Home")">Về trang chủ</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item" href="@Url.Action("Logout", "Account")">Đăng xuất</a></li>
                </ul>
            </div>
        </div>

        <div class="flex-grow-1 d-flex flex-column" style="height: 100vh; overflow-y: auto;">
            <nav class="navbar navbar-expand navbar-light bg-white topbar mb-4 static-top shadow px-4">
                <h4 class="mb-0 text-gray-800 fw-bold">@ViewBag.Title</h4>
            </nav>

            <div class="container-fluid px-4 pb-4">
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>