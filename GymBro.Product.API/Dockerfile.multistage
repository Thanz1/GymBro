# ============================================================
# STAGE 1: Build
# ============================================================
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# Copy .csproj files of Product.API and all its dependencies for cache optimization
# Dependencies: Core, Contracts, Infrastructure, Service, Order.API
COPY GymBro.Core/GymBro.Core.csproj GymBro.Core/
COPY GymBro.Contracts/GymBro.Contracts.csproj GymBro.Contracts/
COPY GymBro.Infrastructure/GymBro.Infrastructure.csproj GymBro.Infrastructure/
COPY GymBro.Service/GymBro.Service.csproj GymBro.Service/
COPY GymBro.Order.API/GymBro.Order.API.csproj GymBro.Order.API/
COPY GymBro.Product.API/GymBro.Product.API.csproj GymBro.Product.API/

# Restore NuGet packages
RUN dotnet restore "GymBro.Product.API/GymBro.Product.API.csproj"

# Copy the entire source code
COPY . .

# Build & publish
WORKDIR /src/GymBro.Product.API
RUN dotnet publish "GymBro.Product.API.csproj" -c Release -o /app/publish /p:UseAppHost=false /p:ErrorOnDuplicatePublishOutputFiles=false /p:DebugSymbols=false /p:DebugType=none

# ============================================================
# STAGE 2: Runtime (Hardened)
# ============================================================
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
WORKDIR /app

# Cài curl cho HEALTHCHECK
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

# Tạo non-root user 'gymbro'
RUN groupadd -r gymbro && useradd -r -g gymbro -d /home/gymbro -m gymbro

# Copy published output
COPY --from=build /app/publish .

# Trao quyền sở hữu
RUN chown -R gymbro:gymbro /app /home/gymbro

# Chuyển sang user không phải root
USER gymbro

ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8080/swagger/index.html || exit 1

ENTRYPOINT ["dotnet", "GymBro.Product.API.dll"]