@using GymBro.Contracts
@model PaymentDto

@{
    ViewBag.Title = "Thanh toán Đơn hàng #" + Model.OrderId;
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container py-4">
    <div class="mb-4">
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary rounded-pill px-4 shadow-sm">
            <i class="bi bi-arrow-left"></i> Quay lại danh sách
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4">
            <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
        @* Cột trái: Thông tin thanh toán *@
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-credit-card"></i> Thanh toán cho Đơn hàng #@Model.OrderId</h5>
                </div>
                <div class="card-body d-flex flex-column justify-content-between">
                    <table class="table table-borderless mb-auto">
                        <tr>
                            <td class="text-muted w-40">Mã giao dịch:</td>
                            <td class="fw-bold text-secondary">#@Model.Id</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Mã đơn hàng:</td>
                            <td><a href="@Url.Action("Details", "Orders", new { id = Model.OrderId })" class="fw-bold text-primary">#@Model.OrderId</a></td>
                        </tr>
                        <tr>
                            <td class="text-muted">Số tiền:</td>
                            <td class="fw-bold text-danger fs-4">@Model.Amount.ToString("N0") ₫</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Ngày thực hiện:</td>
                            <td class="small">@Model.PaymentDate.ToString("dd/MM/yyyy HH:mm:ss")</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Phương thức:</td>
                            <td><span class="badge bg-secondary">@Model.PaymentMethodName</span></td>
                        </tr>
                        <tr>
                            <td class="text-muted">Trạng thái:</td>
                            <td>
                                <span class="badge @(Model.Status == "Completed" || Model.Status == "Đã thanh toán" ? "bg-success" : "bg-warning text-dark") px-3">
                                    @Model.Status
                                </span>
                            </td>
                        </tr>
                    </table>

                    @* Form cập nhật trạng thái nằm gọn trong Card body cột trái để không làm vỡ lưới Layout *@
                    <div>
                        <hr />
                        <form method="post" action="@Url.Action("UpdateStatus", "Payments")" class="d-flex align-items-center mt-3">
                            <input type="hidden" name="paymentId" value="@Model.Id" />
                            <label class="me-2 fw-bold text-nowrap">Cập nhật:</label>
                            <select name="newStatus" class="form-select w-auto me-2">
                                <option value="Chờ thu tiền" selected="@(Model.Status == "Chờ thu tiền" ? "selected" : null)">Chờ thu tiền</option>
                                <option value="Đã thanh toán" selected="@(Model.Status == "Completed" || Model.Status == "Đã thanh toán" ? "selected" : null)">Đã thanh toán</option>
                                <option value="Đã hủy" selected="@(Model.Status == "Đã hủy" ? "selected" : null)">Đã hủy</option>
                            </select>
                            <button type="submit" class="btn btn-success text-nowrap">Lưu thay đổi</button>
                        </form>
                    </div>

                </div>
            </div>
        </div>

        @* Cột phải: Thông tin khách hàng *@
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-dark text-white py-3">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-person-circle"></i> Khách hàng thanh toán</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="text-muted small d-block">Họ và tên</label>
                        <span class="fw-bold fs-5">@Model.CustomerName</span>
                    </div>
                    <div class="mb-3">
                        <label class="text-muted small d-block">Email liên hệ</label>
                        <span>@Model.CustomerEmail</span>
                    </div>
                    <div class="mb-0">
                        <label class="text-muted small d-block">Địa chỉ giao hàng</label>
                        <p class="mb-0 small text-secondary">@Model.CustomerAddress</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>