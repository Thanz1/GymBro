@model GymBro.Contracts.ResetPasswordDto

<div class="auth-page">
    <div class="row justify-content-center">
        <div class="col-lg-5">
            <div style="background: white; border-radius: 15px; padding: 40px; box-shadow: 0 10px 25px rgba(0,0,0,0.15);">
                <h2 class="text-center" style="font-weight: 700; color: #dc3545;">Khôi phục mật khẩu</h2>
                @if (ViewBag.ErrorMessage != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show">
                        <i class="bi bi-exclamation-triangle"></i> @ViewBag.ErrorMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <div class="form-group mb-3">
                        <label class="form-label">Tên tài khoản hoặc Email</label>
                        <input type="text" name="Identifier" class="form-control" required placeholder="Nhập để tìm tài khoản" />
                    </div>

                    <div class="form-group mb-4">
                        <label class="form-label">Mật khẩu mới</label>
                        <input type="password" name="NewPassword" class="form-control" required minlength="6" placeholder="Nhập mật khẩu mới" />
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-danger btn-lg">Xác nhận đổi mật khẩu</button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>