@model int?

@{
    ViewBag.Title = "Đặt hàng thành công";
    var orderId = Model;
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="alert alert-success shadow-sm border-0" style="padding: 40px; text-align: center; border-radius: 16px;">
            <i class="bi bi-check-circle-fill" style="font-size: 4rem;"></i>
            <h2 class="mt-3">Đặt hàng thành công</h2>
            @if (orderId.HasValue)
            {
                <p class="mb-2">Đơn hàng <strong>#@orderId</strong> đã được ghi nhận.</p>
            }
            <p class="mb-4">Bạn có thể theo dõi trạng thái xử lý và thanh toán trong tài khoản của mình.</p>

            <div class="d-flex flex-wrap justify-content-center gap-2">
                @Html.ActionLink("Tiếp tục mua sắm", "Index", "Home", null, new { @class = "btn btn-primary" })
                @Html.ActionLink("Lịch sử đơn hàng", "OrderHistory", "Account", null, new { @class = "btn btn-outline-success" })
                @if (orderId.HasValue)
                {
                    @Html.ActionLink("Xem chi tiết đơn", "OrderDetails", "Account", new { id = orderId.Value }, new { @class = "btn btn-outline-primary" })
                }
            </div>
        </div>
    </div>
</div>
