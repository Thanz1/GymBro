@{
    ViewBag.Title = "Đăng nhập";
}

<div class="auth-page">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-7 col-sm-9">
            <div style="background: white; border-radius: 15px; box-shadow: 0 10px 25px rgba(0,0,0,0.15); padding: 40px; margin-top: 30px;">
                <div class="text-center mb-4">
                    <i class="bi bi-person-circle" style="font-size: 4rem; color: #dc3545; margin-bottom: 15px;"></i>
                    <h2 style="font-weight: 700; color: #2c3e50; margin-bottom: 10px;">Đăng nhập</h2>
                    <p class="text-muted">Chào mừng bạn trở lại GYMBRO</p>
                </div>

                @if (ViewBag.ErrorMessage != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show">
                        <i class="bi bi-exclamation-triangle"></i> @ViewBag.ErrorMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @using (Html.BeginForm("Login", "Account", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <div class="form-group mb-4">
                        <label class="form-label" style="font-weight: 600;">Tên đăng nhập hoặc Email</label>
                        <input type="text" name="Username" class="form-control" required placeholder="Nhập username hoặc email" />
                    </div>

                    <div class="form-group mb-4">
                        <label class="form-label" style="font-weight: 600;">Mật khẩu</label>
                        <input type="password" name="Password" class="form-control" required placeholder="Nhập mật khẩu" />
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4">
                        <button type="submit" class="btn btn-danger btn-lg px-5" style="font-weight: 600;">
                            Đăng nhập
                        </button>

                        @Html.ActionLink("Quên mật khẩu?", "ForgotPassword", "Account", null,
                        new { @class = "text-decoration-none small text-muted", style = "font-style: italic;" })
                </div>
                                }

                <hr class="my-4" /> <div class="text-center mt-3">
                    <span class="text-muted">Chưa có tài khoản?</span>
                    @Html.ActionLink("Đăng ký ngay", "Register", "Account", null, new { @class = "text-decoration-none fw-bold text-danger" })
                </div>
            </div>
        </div>
    </div>
</div>