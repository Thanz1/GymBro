@model GymBro.Contracts.RegisterDto
@{
    ViewBag.Title = "Thiết lập hệ thống";
    // Sử dụng layout mặc định của Web
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-danger text-white py-3">
                    <h3 class="mb-0 fw-bold"><i class="bi bi-shield-lock"></i> Khởi tạo Admin</h3>
                </div>
                <div class="card-body p-4">

                    @* Hiển thị thông báo phản hồi từ API *@
                    @if (!string.IsNullOrEmpty(ViewBag.Message))
                    {
                        <div class="alert alert-@ViewBag.MessageType alert-dismissible fade show" role="alert">
                            @ViewBag.Message
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (ViewBag.MessageType != "success")
                    {
                        <form asp-action="CreateAdmin" asp-controller="AdminSetup" method="post" class="needs-validation" novalidate>
                            @Html.AntiForgeryToken()

                            <div class="mb-3">
                                <label asp-for="Username" class="form-label fw-bold">Tên đăng nhập *</label>
                                <input asp-for="Username" class="form-control" required placeholder="Ví dụ: admin_tdmu" />
                                <span asp-validation-for="Username" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="FullName" class="form-label fw-bold">Họ và Tên</label>
                                <input asp-for="FullName" class="form-control" placeholder="Họ tên người quản trị" />
                            </div>

                            <div class="mb-3">
                                <label asp-for="Email" class="form-label fw-bold">Email liên hệ</label>
                                <input asp-for="Email" type="email" class="form-control" placeholder="admin@gymbro.com" />
                            </div>

                            <div class="mb-3">
                                <label asp-for="Password" class="form-label fw-bold">Mật khẩu quản trị *</label>
                                <input asp-for="Password" type="password" class="form-control" required minlength="6" id="pwd" />
                                <div class="form-text">Mật khẩu nên có cả chữ và số để bảo mật.</div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Xác nhận mật khẩu *</label>
                                <input type="password" class="form-control" id="confirm_pwd" required />
                                <div class="invalid-feedback">Mật khẩu nhập lại không khớp!</div>
                            </div>

                            <div class="d-grid mt-4">
                                <button type="submit" class="btn btn-danger btn-lg shadow-sm">
                                    <i class="bi bi-person-plus-fill"></i> Kích hoạt hệ thống
                                </button>
                            </div>
                        </form>
                    }
                    else
                    {
                        <div class="text-center py-3">
                            <p class="text-success fw-bold">Hệ thống đã sẵn sàng!</p>
                            <a href="@Url.Action("Login", "Account")" class="btn btn-outline-primary">
                                <i class="bi bi-box-arrow-in-right"></i> Tới trang Đăng nhập
                            </a>
                        </div>
                    }
                </div>
                <div class="card-footer bg-light text-muted small">
                    <i class="bi bi-info-circle-fill"></i>
                    Trang này chỉ hoạt động khi hệ thống chưa có tài khoản Admin nào.
                    Mọi yêu cầu sẽ được chuyển đến <strong>Identity.API</strong> để xử lý bảo mật.
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Logic kiểm tra mật khẩu khớp nhau ngay tại trình duyệt
        (function () {
            'use strict'
            const form = document.querySelector('.needs-validation');
            const pwd = document.getElementById('pwd');
            const confirm = document.getElementById('confirm_pwd');

            form.addEventListener('submit', function (event) {
                if (pwd.value !== confirm.value) {
                    confirm.setCustomValidity('Invalid');
                    event.preventDefault();
                    event.stopPropagation();
                } else {
                    confirm.setCustomValidity('');
                }

                if (!form.checkValidity()) {
                    event.preventDefault();
                    event.stopPropagation();
                }

                form.classList.add('was-validated');
            }, false);
        })();
    </script>
}