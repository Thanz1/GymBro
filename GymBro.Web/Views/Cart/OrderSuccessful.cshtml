@{
    ViewBag.Title = "Đặt hàng thành công";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-body p-5 text-center">
                    @* Biểu tượng thành công *@
                    <div class="mb-4">
                        <div class="rounded-circle bg-success bg-opacity-10 d-inline-flex align-items-center justify-content-center" style="width: 100px; height: 100px;">
                            <i class="bi bi-check-all text-success" style="font-size: 4rem;"></i>
                        </div>
                    </div>

                    <h2 class="fw-bold text-dark mb-3">ĐẶT HÀNG THÀNH CÔNG!</h2>
                    <p class="text-muted fs-5 mb-4">
                        Cảm ơn bạn đã tin tưởng chọn <strong>GYMBRO</strong>.
                        Đơn hàng của bạn đã được tiếp nhận và đang trong quá trình xử lý.[cite: 14]
                    </p>

                    <div class="alert alert-info border-0 rounded-3 text-start mb-4">
                        <small>
                            <i class="bi bi-info-circle-fill me-2"></i>
                            Chúng tôi đã gửi thông tin xác nhận qua Email của bạn.
                            Nếu bạn chọn thanh toán qua mã QR, vui lòng hoàn tất giao dịch để đơn hàng sớm được giao đi.
                        </small>
                    </div>

                    <div class="d-grid gap-3 d-sm-flex justify-content-sm-center">
                        @* Nút quay lại trang chủ *@
                        <a href="@Url.Action("Index", "Home")" class="btn btn-primary btn-lg px-4 fw-bold shadow-sm">
                            <i class="bi bi-house-door"></i> Tiếp tục mua sắm[cite: 14]
                        </a>

                        @* Nút xem lịch sử đơn hàng (Trỏ về AccountController theo chuẩn SOA) *@
                        <a href="@Url.Action("OrderHistory", "Account")" class="btn btn-outline-success btn-lg px-4 fw-bold">
                            <i class="bi bi-list-check"></i> Xem đơn hàng
                        </a>
                    </div>
                </div>

                <div class="card-footer bg-light border-0 py-3 text-center">
                    <span class="text-muted small">Cần hỗ trợ? Gọi ngay cho chúng tôi tại <strong>0123-456-789</strong></span>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Hiệu ứng nhẹ cho nút */
    .btn {
        transition: all 0.3s ease;
    }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }
</style>