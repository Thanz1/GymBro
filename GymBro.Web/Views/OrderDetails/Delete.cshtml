@using GymBro.Contracts
@model OrderDetailDto

@{
    ViewBag.Title = "Xóa Chi tiết";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm border-top border-danger border-4">
            <div class="card-body p-4 text-center">
                <i class="bi bi-exclamation-triangle display-4 text-danger mb-3"></i>
                <h3 class="fw-bold">Xác nhận xóa chi tiết?</h3>
                <p class="text-muted">Đang xóa <strong>@Model.ProductName</strong> (Số lượng: @Model.Quantity) khỏi đơn hàng <strong>#@Model.OrderId</strong>.</p>
                <div class="alert alert-light border mb-4">
                    Giá trị dòng này: <strong class="text-danger">@Model.Total.ToString("N0") ₫</strong>
                </div>
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    <div class="d-flex justify-content-center gap-3">
                        <button type="submit" class="btn btn-danger btn-lg px-4 shadow-sm">XÁC NHẬN XÓA</button>
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-lg px-4">HỦY BỎ</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>