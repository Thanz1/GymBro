@{
    ViewBag.Title = "Đăng nhập";
    var googleClientId = ViewBag.GoogleClientId as string ?? "";
    var googleEnabled = !string.IsNullOrWhiteSpace(googleClientId)
        && !googleClientId.StartsWith("YOUR_", StringComparison.Ordinal);
}

<div class="auth-page">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-7 col-sm-9">
            <div style="background: white; border-radius: 15px; box-shadow: 0 10px 25px rgba(0,0,0,0.15); padding: 40px; margin-top: 30px;">
                <div class="text-center mb-4">
                    <i class="bi bi-person-circle" style="font-size: 4rem; color: #dc3545; margin-bottom: 15px;"></i>
                    <h2 style="font-weight: 700; color: #2c3e50; margin-bottom: 10px;">Đăng nhập</h2>
                    <p class="text-muted">Chào mừng bạn trở lại GYMBRO</p>
                </div>
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show">
                        <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (ViewBag.ErrorMessage != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show">
                        <i class="bi bi-exclamation-triangle"></i> @ViewBag.ErrorMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @if (googleEnabled)
                {
                    <div class="google-signin-wrap position-relative w-100 mb-4" style="height: 50px;">
                        <button type="button" tabindex="-1"
                                class="btn btn-lg w-100 border-0 text-white fw-semibold"
                                style="background: #e85d04; pointer-events: none; height: 50px; border-radius: 8px;">
                            Đăng nhập bằng tài khoản Google
                        </button>
                        <div id="googleSignInOverlay"
                             class="position-absolute top-0 start-0 w-100 h-100"
                             style="opacity: 0.011; z-index: 2; overflow: hidden;"></div>
                    </div>

                    <form id="googleLoginForm" asp-action="GoogleLogin" asp-controller="Account" method="post" class="d-none">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="idToken" id="googleIdToken" />
                    </form>

                    <div class="d-flex align-items-center my-4">
                        <hr class="flex-grow-1" />
                        <span class="px-3 text-muted small">hoặc</span>
                        <hr class="flex-grow-1" />
                    </div>
                }

                @using (Html.BeginForm("Login", "Account", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <div class="form-group mb-4">
                        <label class="form-label" style="font-weight: 600;">Tên đăng nhập hoặc Email</label>
                        <input type="text" name="Username" class="form-control" required placeholder="Nhập username hoặc email" />
                    </div>

                    <div class="form-group mb-4">
                        <label class="form-label" style="font-weight: 600;">Mật khẩu</label>
                        <input type="password" name="Password" class="form-control" required placeholder="Nhập mật khẩu" />
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4">
                        <button type="submit" class="btn btn-danger btn-lg px-5" style="font-weight: 600;">
                            Đăng nhập
                        </button>

                        @Html.ActionLink("Quên mật khẩu?", "ForgotPassword", "Account", null,
                        new { @class = "text-decoration-none small text-muted", style = "font-style: italic;" })
                    </div>
                }

                <hr class="my-4" />
                <div class="text-center mt-3">
                    <span class="text-muted">Chưa có tài khoản?</span>
                    @Html.ActionLink("Đăng ký ngay", "Register", "Account", null, new { @class = "text-decoration-none fw-bold text-danger" })
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @if (googleEnabled)
    {
        <script src="https://accounts.google.com/gsi/client" async defer></script>
        <script>
            function handleGoogleSignIn(response) {
                document.getElementById('googleIdToken').value = response.credential;
                document.getElementById('googleLoginForm').submit();
            }

            window.addEventListener('load', function () {
                google.accounts.id.initialize({
                    client_id: '@googleClientId',
                    callback: handleGoogleSignIn,
                    ux_mode: 'popup',
                    locale: 'vi'
                });

                var overlay = document.getElementById('googleSignInOverlay');
                google.accounts.id.renderButton(overlay, {
                    type: 'standard',
                    theme: 'filled_red',
                    size: 'large',
                    text: 'signin_with',
                    width: overlay.offsetWidth || 400
                });
            });
        </script>
    }
}
