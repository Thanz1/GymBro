@using GymBro.Contracts
@model PurchaseOrderDto

@{
    ViewBag.Title = "Chi tiết Phiếu nhập #" + Model.Id;
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary"><i class="bi bi-receipt"></i> Phiếu nhập #@Model.Id</h2>
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Quay lại</a>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-md-7">
                    <p class="mb-1"><strong>Nhà cung cấp:</strong> @Model.SupplierName</p>
                    <p class="mb-1"><strong>Ngày lập:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
                    <p class="mb-0"><strong>Tổng tiền:</strong> <span class="text-danger fw-bold fs-5">@Model.TotalAmount.ToString("N0") đ</span></p>
                </div>
                <div class="col-md-5 text-end">
                    @if (Model.Status != "Đã nhập kho")
                    {
                        using (Html.BeginForm("Approve", "PurchaseOrders", new { id = Model.Id }, FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-success btn-lg shadow" onclick="return confirm('Xác nhận nhập kho? Tồn kho sẽ được cộng thêm ngay lập tức!')">
                                <i class="bi bi-check-lg"></i> DUYỆT & NHẬP KHO[cite: 46]
                            </button>
                        }
                    }
                    else
                    {
                        <span class="badge bg-success fs-6"><i class="bi bi-check-circle"></i> ĐÃ NHẬP KHO</span>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (Model.Status != "Đã nhập kho")
    {
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-light fw-bold"><i class="bi bi-plus-circle"></i> Thêm sản phẩm</div>
            <div class="card-body">
                @using (Html.BeginForm("AddDetail", "PurchaseOrders", FormMethod.Post, new { @class = "row g-3 align-items-end" }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="purchaseOrderId" value="@Model.Id" />
                    <div class="col-md-5">
                        <label class="form-label small fw-bold">Sản phẩm</label>
                        @Html.DropDownList("ProductId", null, new { @class = "form-select" })
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-bold">Số lượng</label>
                        <input type="number" name="quantity" class="form-control" value="1" min="1" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold">Giá nhập (đ)</label>
                        <input type="number" name="unitPrice" class="form-control" value="0" step="1000" />
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary w-100">THÊM</button>
                    </div>
                }
            </div>
        </div>
    }

    <div class="card border-0 shadow-sm overflow-hidden">
        <table class="table table-striped mb-0 align-middle">
            <thead class="table-dark">
                <tr>
                    <th class="ps-3">Sản phẩm</th>
                    <th class="text-center">Số lượng</th>
                    <th class="text-end">Đơn giá</th>
                    <th class="text-end pe-3">Thành tiền</th>
                    @if (Model.Status != "Đã nhập kho")
                    {
                        <th></th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.PurchaseOrderDetails)
                {
                    <tr>
                        <td class="ps-3 fw-bold">@item.ProductName</td>
                        <td class="text-center">@item.Quantity</td>
                        <td class="text-end">@item.UnitPrice.ToString("N0")</td>
                        <td class="text-end pe-3 fw-bold">@item.Total.ToString("N0")</td>
                        @if (Model.Status != "Đã nhập kho")
                        {
                            <td class="text-center">
                                @using (Html.BeginForm("DeleteDetail", "PurchaseOrders", new { id = item.Id }, FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="text-danger border-0 bg-transparent" onclick="return confirm('Xóa dòng này?')"><i class="bi bi-trash"></i></button>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>