@{
    ViewBag.Title = "Giới thiệu";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="fw-bold text-primary">Về GYMBRO</h1>
        <p class="lead text-muted">Đồng hành cùng sức khỏe của bạn</p>
    </div>

    <div class="row align-items-center">
        <div class="col-md-6 mb-4">
            <img src="~/Content/Images/Postter.jpg" class="img-fluid rounded shadow" alt="About GymBro" onerror="this.src='https://via.placeholder.com/600x400'" />
        </div>
        <div class="col-md-6">
            <h3 class="fw-bold">Câu chuyện của chúng tôi</h3>
            <p class="mt-3">
                GYMBRO được thành lập với niềm đam mê mãnh liệt về thể thao và sức khỏe.
                Chúng tôi hiểu rằng một cơ thể khỏe mạnh là nền tảng của một cuộc sống hạnh phúc.
            </p>
            <p>
                Sứ mệnh của chúng tôi là cung cấp các thiết bị tập luyện chất lượng cao, chính hãng với mức giá hợp lý nhất
                để ai cũng có thể tiếp cận việc rèn luyện sức khỏe.
            </p>

            <div class="mt-4">
                <div class="d-flex mb-3">
                    <i class="bi bi-check-circle-fill text-success fs-4 me-3"></i>
                    <div>
                        <h5 class="mb-1">Chất lượng hàng đầu</h5>
                        <p class="small text-muted mb-0">Sản phẩm được tuyển chọn kỹ lưỡng.</p>
                    </div>
                </div>
                <div class="d-flex">
                    <i class="bi bi-heart-fill text-danger fs-4 me-3"></i>
                    <div>
                        <h5 class="mb-1">Tận tâm phục vụ</h5>
                        <p class="small text-muted mb-0">Khách hàng là trọng tâm của mọi hoạt động.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>