@using GymBro.Contracts
@model OrderDto

@{
    ViewBag.Title = "Tạo Đơn hàng mới";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h4 class="mb-0 text-success fw-bold"><i class="bi bi-plus-circle"></i> Tạo Đơn hàng mới</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    @* 1. Ngày đặt hàng *@
                    <div class="mb-3">
                        <label asp-for="OrderDate" class="form-label fw-bold">Ngày lập đơn</label>
                        <input asp-for="OrderDate" class="form-control" type="datetime-local" />
                        <small class="text-muted">Hệ thống sẽ mặc định lấy giờ hiện tại nếu để trống.</small>
                        <span asp-validation-for="OrderDate" class="text-danger"></span>
                    </div>

                    @* 2. Khách hàng *@
                    <div class="mb-3">
                        <label asp-for="UserId" class="form-label fw-bold">Khách hàng đặt hàng</label>
                        <select asp-for="UserId" class="form-select border-primary" asp-items="ViewBag.UserId">
                            <option value="">-- Chọn khách hàng --</option>
                        </select>
                        <span asp-validation-for="UserId" class="text-danger"></span>
                    </div>

                    @* 3. Trạng thái *@
                    <div class="mb-3">
                        <label asp-for="Status" class="form-label fw-bold">Trạng thái ban đầu</label>
                        <select asp-for="Status" class="form-select">
                            <option value="Chờ xử lý">Chờ xử lý</option>
                            <option value="Đang giao hàng">Đang giao hàng</option>
                            <option value="Đã giao hàng">Đã giao hàng</option>
                            <option value="Đã hủy">Đã hủy</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger"></span>
                    </div>

                    @* 4. Tổng tiền *@
                    <div class="mb-4">
                        <label asp-for="TotalAmount" class="form-label fw-bold">Tổng tiền đơn hàng (VNĐ)</label>
                        <div class="input-group">
                            <input asp-for="TotalAmount" class="form-control fw-bold text-danger" type="number" step="1000" placeholder="0" />
                            <span class="input-group-text">₫</span>
                        </div>
                        <span asp-validation-for="TotalAmount" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2 border-top pt-3">
                        <a asp-action="Index" class="btn btn-secondary px-4">Hủy bỏ</a>
                        <button type="submit" class="btn btn-success px-4 fw-bold shadow-sm">
                            <i class="bi bi-check-lg"></i> TẠO ĐƠN HÀNG
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}