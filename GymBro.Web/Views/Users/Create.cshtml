@using GymBro.Contracts
@model UserDto

@{
    ViewBag.Title = "Thêm Người dùng mới";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h4 class="mb-0 text-success fw-bold">Thêm tài khoản mới</h4>
            </div>
            <div class="card-body p-4">
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "text-danger small" })

                    <div class="mb-3">
                        <label class="form-label fw-bold">Tên đăng nhập *</label>
                        @Html.EditorFor(model => model.Username, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.Username, "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Mật khẩu *</label>
                        <input type="password" name="Password" class="form-control" required />
                        <small class="text-muted">Tối thiểu 6 ký tự</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Email *</label>
                        @Html.EditorFor(model => model.Email, new { htmlAttributes = new { @class = "form-control", type = "email" } })
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Vai trò</label>
                        <select asp-for="Role" class="form-select border-primary">
                            <option value="User">Người dùng</option>
                            <option value="Admin">Quản trị viên</option>
                        </select>
                    </div>

                    <div class="d-flex gap-2 mt-4 pt-3 border-top">
                        <button type="submit" class="btn btn-success px-4 fw-bold">TẠO TÀI KHOẢN</button>
                        <a href="@Url.Action("Index")" class="btn btn-secondary px-4">HỦY</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>