@using GymBro.Contracts
@model PurchaseOrderDto

@{
    ViewBag.Title = "Xóa Phiếu nhập";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm border-top border-danger border-4 mt-5">
            <div class="card-body p-4 text-center">
                <i class="bi bi-exclamation-triangle display-4 text-danger mb-3"></i>
                <h3 class="fw-bold">Xác nhận xóa phiếu nhập?</h3>
                <p class="text-muted">Đang xóa phiếu nhập <strong>#@Model.Id</strong> của <strong>@Model.SupplierName</strong>. Hành động này sẽ xóa toàn bộ danh sách sản phẩm bên trong phiếu[cite: 45].</p>

                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    <div class="d-flex justify-content-center gap-3 mt-4">
                        <button type="submit" class="btn btn-danger btn-lg px-5 shadow-sm">XÁC NHẬN XÓA</button>
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-lg px-4">HỦY</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>