@using GymBro.Contracts
@model IEnumerable<ReviewDto>

<div class="card mt-4 shadow-sm border-0">
    <div class="card-header bg-white border-bottom-0 pt-4 ps-4">
        <h4 class="fw-bold text-dark">
            <i class="bi bi-star-fill text-warning"></i> Đánh giá sản phẩm (@(Model?.Count() ?? 0))
        </h4>
    </div>
    <div class="card-body px-4">
        @if (Model != null && Model.Any())
        {
            <div class="review-list">
                @foreach (var review in Model)
                {
                    <div class="review-item mb-4 pb-3 border-bottom">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div class="d-flex align-items-center">
                                <div class="avatar bg-light rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 40px; height: 40px;">
                                    <i class="bi bi-person-fill text-secondary fs-5"></i>
                                </div>
                                <div>
                                    @* SỬA: Dùng UserName trực tiếp từ DTO *@
                                    <div class="fw-bold">@(review.UserName ?? "Khách")</div>
                                    <small class="text-muted">@review.CreatedDate.ToString("dd/MM/yyyy HH:mm")</small>
                                </div>
                            </div>
                            <div class="rating text-warning">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="bi bi-star@(i <= review.Rating ? "-fill" : "")"></i>
                                }
                            </div>
                        </div>
                        <p class="mb-0 text-secondary">@review.Comment</p>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-muted text-center py-3">Chưa có đánh giá nào cho sản phẩm này.</p>
        }
    </div>
</div>