@model string

@{
    var history = Model;
}

@if (!string.IsNullOrEmpty(history))
{
    var entries = history.Split(new[] { " | " }, StringSplitOptions.RemoveEmptyEntries);
    <div class="timeline ps-3 border-start">
        @foreach (var entry in entries.Reverse())
        {
            <div class="mb-2 position-relative">
                <div class="position-absolute top-0 start-0 translate-middle bg-white" style="left: -16px; margin-top: 5px;">
                    <i class="bi bi-circle-fill text-primary" style="font-size: 8px;"></i>
                </div>
                <div class="card shadow-sm border-0 bg-light">
                    <div class="card-body py-2 px-3 small">
                        @entry
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <p class="text-muted small">Chưa có lịch sử giao dịch.</p>
}