@model GymBro.Core.Category

@{
    ViewBag.Title = "Xóa Danh mục";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h4 class="mb-0 text-danger"><i class="bi bi-trash"></i> Xóa Danh mục</h4>
            </div>
            <div class="card-body">
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <strong>Cảnh báo:</strong> Bạn có chắc chắn muốn xóa danh mục này không? Hành động này không thể hoàn tác.
                </div>

                <dl class="row mb-4">
                    <dt class="col-sm-4">Tên danh mục:</dt>
                    <dd class="col-sm-8 fw-bold">@Model.CategoryName</dd>
                </dl>

                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    <div class="d-flex justify-content-end gap-2">
                        <a href="@Url.Action("Index")" class="btn btn-secondary">Hủy bỏ</a>
                        <button type="submit" class="btn btn-danger">Xác nhận Xóa</button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>